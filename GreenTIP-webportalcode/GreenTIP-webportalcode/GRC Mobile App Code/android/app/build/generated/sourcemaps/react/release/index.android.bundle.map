  };
  constructor(props) {
    super(props);
    this.handleBackButtonClick = this.handleBackButtonClick.bind(this);
    this.state = {
      isLoading: false,
      first_name: '',
      email: '',
      mobile: '',
      message_user: '',
      spinner: false

    };

  }

  componentWillMount() {
    BackHandler.addEventListener('hardwareBackPress', this.handleBackButtonClick);

  }

  componentDidMount() {
    //this.setState({ first_name: '' });

    this.Contact_Us()

    // const { navigation } = this.props;
    // if(navigation.getParam('loginname') == ''){
    //  // var username = navigation.getParam('loginname');

    // }else{
    //   var username = navigation.getParam('loginname');
    //   console.log(username)

    // }

  }

  Contact_Us = async () => {
    
    var userName = await AsyncStorage.getItem('userName')
    var email = await AsyncStorage.getItem('email')
    var contact_no = await AsyncStorage.getItem('contact_no')


    if (userName === '' || userName === undefined || userName === null) {
      this.setState({ first_name: '' });

    } else {
      this.setState({ first_name: userName });
    }

    if (email === '' || email === undefined || email === null) {
      this.setState({ email: '' });

    } else {
      this.setState({ email: email });
    }

    if (contact_no === '' || contact_no === undefined || contact_no === null) {
      this.setState({ mobile: '' });

    } else {
      this.setState({ mobile: contact_no });
    }

  }
  validate_field = () => {
    const { first_name, email, message_user, mobile } = this.state;
    // console.log(first_name)
    const reg = /^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/;
    // const name_ = /^[a-zA-Z]+$/;
    if (first_name === "") {
      alert("Please Enter First Name")
      return false
    }
    else if (reg.test(email) === false) {
      alert("Enter Valid Email Address")
      return false
    }
    else if (mobile.length < 10) {
      alert("Enter Valid Mobile Number")
      return false
    }

    else if (message_user.length < 10) {
      alert("Message field must be at least 10 characters in length")
      return false
    }
    return true
  }


  Contact_Us_Call = async () => {
    if (this.validate_field()) {
      var res =  await Constants.isNetworkAvailable();
      if (!res) {
        return false;
      }
     
      this.setState({ isLoading: true });
      const { first_name, email, message_user, mobile } = this.state;
      var name_role_type = await AsyncStorage.getItem('role_type');
      console.log('mobilesssss', mobile)
      var params = {
        'name': first_name,
        'email': email,
        'message': message_user,
        'phone': mobile,
      };
      console.log('params', params)
      var formData = new FormData();

      for (var k in params) {
        formData.append(k, params[k]);
      }


      fetch(Constants.FullURL + '/common/contact_us', {
        method: 'POST',
        headers: {
          'authorisation': this.authorisationToken
        },
        body: formData,
      }).then((response) => response.json())

        .then((responseJson) => {
          console.log(responseJson)
          if (responseJson.status === true) {

            this.setState({
              isLoading: false,
            });

           // Alert.alert('Alert', responseJson.message);

            setTimeout(() => {
             // Alert.alert('Alert', responseJson.message);
              Toast.show(responseJson.message, Toast.SHORT);
          }, 500);

          //  Toast.show(responseJson.message, Toast.SHORT);
            if (name_role_type === null) {
              this.setState({ message_user: '' });
              this.setState({ first_name: '' });
              this.setState({ email: '' });
              this.setState({ mobile: '' });
            }
            else {
              this.setState({ message_user: '' });

            }


          } else if (responseJson.status === false) {
            this.setState({
              isLoading: false,
            });
            Alert.alert('Error', responseJson.message);

          }
        })
        .catch(error => {
          this.setState({ isLoading: false });
          // console.log(error);
        })
    }
  }

  componentWillUnmount() {
    BackHandler.removeEventListener('hardwareBackPress', this.handleBackButtonClick);
  }

  handleBackButtonClick() {
    console.log("hello_props", this.props);
    this.props.navigation.goBack(null);
    // BackHandler.exitApp();
    return true;
  }


  render() {

    // if (this.state.isLoading) {
    //   return (

    //   );
    // }

    return (
      <KeyboardAwareScrollView contentContainerStyle={{ flexGrow: 1 }}
