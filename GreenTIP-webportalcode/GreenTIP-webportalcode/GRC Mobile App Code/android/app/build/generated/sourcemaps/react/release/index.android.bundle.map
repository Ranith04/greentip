import React, { Component } from 'react';
import {
  Text,
  View,
  ScrollView,
  TouchableOpacity,
  Image,
  ImageBackground,
  Alert,
} from 'react-native';
import { StackActions, NavigationActions, SafeAreaView } from 'react-navigation';
import AsyncStorage from '@react-native-community/async-storage';
import { DrawerActions } from 'react-navigation-drawer';
import { BackHandler } from 'react-native';
import { NavigationEvents } from "react-navigation";
import styles from './style';
import Constants from '../../Constants';
export default class MD_Dashboard extends Component {
  static navigationOptions = {
    header: null,
  };

  componentWillMount() {
    this.getData();
    this._retrieveData();
    BackHandler.addEventListener('hardwareBackPress', this.handleBackButton);
    const { navigation } = this.props;
   // this.setState({ image_MD: navigation.getParam('image') })
    //new Common().check_intra_add();
  }

  componentWillUnmount() {
    BackHandler.removeEventListener('hardwareBackPress', this.handleBackButton);
    this._retrieveData();
    //new Common().check_intra_Re();
  }

  _removeData = async () => {
    try {
     /*  await AsyncStorage.removeItem('role_type');
      await AsyncStorage.removeItem('userName');
      await AsyncStorage.removeItem('email');
      await AsyncStorage.removeItem('contact_no'); */
      BackHandler.exitApp()
    } catch (error) {
      // Error retrieving data
      console.log(error.message);
    }
  };

  handleBackButton = () => {
    Alert.alert(
      'Exit App',
      'Are you sure you want to exit?', [{
        text: 'CANCEL',
        onPress: () => console.log('Cancel Pressed'),
        style: 'cancel'
      },
      {
        text: 'EXIT',
        onPress: () => {this._removeData()}
      },],
      {
        cancelable: false
      }
    )
    return true;
  }

  onButtonPress = () => {
    BackHandler.removeEventListener('hardwareBackPress', this.handleBackButton);
  }

  toggleDrawer = () => {
    //Props to open/close the drawer
    this.props.navigation.dispatch(DrawerActions.toggleDrawer());
    // this.props.navigationProps.toggleDrawer();
    //this.props.navigation.toggleDrawer()
  };

  state = {
    total_inbox: '',
    all_query: '',
    answered_query: '',
    unanswered_query: '',
    userName: '',
    userid: '',
    image_MD: '',
    isLoading: true,
    dataSource: []
  }

  _storeData = async (total_inbox) => {
    try {
      await AsyncStorage.setItem('total_inbox', total_inbox);
      console.log('total_inbox', total_inbox)
    } catch (error) { }
  };

  _retrieveData = async () => {
    try {
      const name = await AsyncStorage.getItem('role_type');
      if (name !== null) { }
    } catch (e) { }
  };

  getData = async () => {
    try {
      const userName = await AsyncStorage.getItem('userName');
      const userId = await AsyncStorage.getItem('id');
      const userimage = await AsyncStorage.getItem('userimage');
      this.setState({ userName: userName });
      this.setState({ userid: userId });
      this.setState({ image_MD: userimage });

      this.mdDashboard_Count();
    } catch (e) {
      alert(e);
    }
  }

  constructor(props) {
    super(props);
    this._retrieveData();
  }

  mdDashboard_Count() {
    const formData = new FormData();
    formData.append("user_id", this.state.userid);
    fetch(Constants.FullURL+'/users/count_dashboard', {
      method: 'POST',
      body: formData,
    }).then((response) => response.json())
      .then((responseJson) => {
        if (responseJson.status === true) {
          console.log(responseJson);
          this.setState({ total_inbox: responseJson.data.total_inbox });
          // AsyncStorage.setItem('count',this.state.total_inbox)
          this.setState({ all_query: responseJson.data.all });
          this.setState({ answered_query: responseJson.data.answered_query });
          this.setState({ unanswered_query: responseJson.data.unanswered_query });

          // this._storeData(JSON.stringify(responseJson.data.total_inbox))

        } else if (responseJson.status === false) {
          Alert.alert('Error', responseJson.message);
          this.setState({ isLoading: false });
        }
        console.log(responseJson);
      })
      .catch((error) => {
        console.error(error);
        alert('No Internet connectivity.Please retry');
      });
  }

  render() {
    return (
      <SafeAreaView forceInset={{ bottom: 'never' }} style={{ flex: 1 }}>
            {Platform.OS === 'ios' &&
 <View style={{
     width: "100%",
     height: 100, // For all devices, even X, XS Max
     position: 'absolute',
     top: 0,
     left: 0,
     backgroundColor: "#0ea457"}}
/>}

        <View style={styles.MainContainer}>
          <NavigationEvents
            onDidFocus={this.getData}
            onWillFocus={() => this.setState({ isLoading: false })}

          />
          <ImageBackground source={require('../../imgs/bgg.png')} style={styles.backgroundImg}>
            <View style={styles.header}>
              <TouchableOpacity onPress={this.toggleDrawer.bind(this)}>
                <Image source={require('../../imgs/menu_dash.png')} style={styles.menuIcon} />
              </TouchableOpacity>
              {/* <View style={ styles.inboxContainer }>
              <Image source={require('../../imgs/inbox_icon.png')} style={ styles.inboxImg }/>
            </View>
            <View style={ styles.badgeContainer }>
              <Text style={ styles.badgeCount }> {this.state.total_inbox} </Text>
            </View> */}
            </View>

            <View style={styles.imgContainer}>
              {this.state.image_MD != null && this.state.image_MD != "" ? <Image source={{ uri: this.state.image_MD }} style={styles.userimg} /> : <Image source={require('../../imgs/no_image.jpg')} style={styles.userimg} />}
              {/* 
          <Image source={{ uri: this.state.image_MD }}
              style={ styles.userimg }/> */}
            </View>

            <Text style={styles.wlcmTxt}>Welcome</Text>

            <Text style={styles.username}>{this.state.userName}</Text>
          </ImageBackground>

          <View style={styles.cardContainer} >
            <SafeAreaView>
              <ScrollView>
                <View style={[styles.customCard, styles.newQuery]}>
                  <TouchableOpacity onPress={() => this.props.navigation.navigate('MD_NewQuery', { 'all_query': this.state.all_query }, this.props)}>
                    <View style={styles.cardContent}>
                      <Image source={require('../../imgs/new_query.png')} style={styles.cardImg} />
                      <Text style={styles.cardCount}> {this.state.all_query} </Text>
                    </View>
                    <Text style={[styles.cardText, styles.newText]}>All Query</Text>
                  </TouchableOpacity>
                </View>

                <View style={[styles.customCard, styles.answered]}>
                  <TouchableOpacity onPress={() => this.props.navigation.navigate('MD_NewQuery', { 'answered_query': this.state.answered_query }, this.props)}>
                    <View style={{ flexDirection: 'row' }}>
                      <Image source={require('../../imgs/respond.png')} style={styles.cardImg} />
                      <Text style={styles.cardCount}> {this.state.answered_query} </Text>
                    </View>
                    <Text style={[styles.cardText, styles.ansText]}>Answered Query</Text>
                  </TouchableOpacity>
                </View>

                <View style={[styles.customCard, styles.unanswered]}>
                  <TouchableOpacity onPress={() => this.props.navigation.navigate('MD_NewQuery', { 'unanswered_query': this.state.unanswered_query }, this.props)}>
                    <View style={{ flexDirection: 'row' }}>
                      <Image source={require('../../imgs/responded.png')} style={styles.cardImg} />
                      <Text style={styles.cardCount}> {this.state.unanswered_query} </Text>
                    </View>
                    <Text style={[styles.cardText, styles.unansText]}>UnAnswered Query</Text>
                  </TouchableOpacity>
                </View>
              </ScrollView>
            </SafeAreaView>
          </View>
        </View>
      </SafeAreaView>

    )
  }
}