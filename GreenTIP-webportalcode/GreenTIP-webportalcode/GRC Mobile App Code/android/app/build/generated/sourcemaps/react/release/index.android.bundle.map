import React, { createRef, Component } from "react";
import styles from "./dateFilterStyles";
import {
  View,
  Text,
  Image,
  FlatList,
  TouchableWithoutFeedback,
  TouchableOpacity,
  AsyncStorage,
  TextInput,
  TouchableHighlight,
  Animated,
  Keyboard,
  Dimensions,
  UIManager,
  Share,
  Modal,
  ImageBackground,
  SafeAreaView,
  ScrollView,
} from "react-native";
import Icon from 'react-native-vector-icons/FontAwesome';
import DatePicker from 'react-native-datepicker';
export default class DateFilter extends Component{
 

  constructor(props) {
    super(props);
   
    this.state = {
       date: '',
      date_End: ''
    };
    console.log(this.props);
  }

 
 
  componentDidMount() {
    
  }
 CheckDate = () => {

    if (this.state.date == '') {
      alert("Please Select Start date");
    }
    else if (this.state.date_End == '') {
      alert("Please Select End date");
    }
    else if (this.state.date > this.state.date_End) {
      alert("End date should be greater than Start date");
    }else{
		var obj ={date:this.state.date,date_End:this.state.date_End};
		this.props.getData(obj);
		/* const getDataAction = this.props.getData;
		console.log(getDataAction);
		  getDataAction(obj);*/
	}
   

  }
  ResetData=()=>{
	   const ResetDataAction = this.props.ResetData;
		  ResetDataAction();
  }


  render() {
    return (
        <View style={styles.MainContainer} >
			<View style={styles.block}>
			<DatePicker
			date={this.state.date} //initial date from state
              maxDate={new Date()}  //maxDate
              mode="date" //The enum of date, datetime and time
              placeholder="Start Date"
              format="YYYY-MM-DD"
             confirmBtnText="Confirm"
              cancelBtnText="Cancel"
              customStyles={{
                dateIcon: {
                  width: 0,
                  height: 0,
                },
                dateInput: { borderWidth: 0 },
				 placeholderText: {
                      color: '#000'
                  }
              }}
              onDateChange={(date) => { this.setState({ date: date }) }}
            />
			</View>
				<View style={[styles.block]}>
					<DatePicker
				 date={this.state.date_End} //initial date from state
				  mode="date" //The enum of date, datetime and time
				  placeholder="End Date"
				  format="YYYY-MM-DD"
				  maxDate={new Date()} 
				  confirmBtnText="Confirm"
				  cancelBtnText="Cancel"
				   placeHolderColor="#000"
				  customStyles={{
					dateIcon: {
					  width: 0,
					  height: 0,
					},
					dateInput: { borderWidth: 0,color:'#000' }
					,
				 placeholderText: {
                      color: '#000'
                  }
				  }}
				  onDateChange={(date_End) => { this.setState({ date_End: date_End }) }}

				/>
			</View>
			<View style={[styles.block,styles.filterbtn]}>
			<TouchableHighlight
              onPress={() => {
                this.CheckDate();
              }}
             
              underlayColor='#fff'>
              <Text style={{
                color: 'black',
                fontSize: 14,
                textAlign: 'center',
               
              }}>Filter</Text>
            </TouchableHighlight>
			</View>
				<View style={styles.block}>
				<TouchableHighlight underlayColor="#ffffff00" onPress={() => {this.ResetData();}}>
              
                <Image source={require('../imgs/reloa.png')} style={{ tintColor: '#0ea457' , height: 35,
               }} />
            </TouchableHighlight>
			</View>
		</View>
     
    );
  }
}
