                                <Text style={styles.model_name}>Status</Text>
                            </View>

                            <View style={{
                                backgroundColor: '#FFFFFF',
                                justifyContent: 'flex-start',
                                alignItems: 'flex-start'
                            }}>

                                <View style={styles.model_Radio_Group}>
                                    <RadioGroup radioButtons={this.state.data} onPress={this.onPress} flexDirection='row' color='red' />
                                </View>
                            </View>

                            <View style={{
                                flexDirection: 'row',
                            }}>


                                <TouchableOpacity style={styles.model_Reset}
                                    onPress={() => this.setState({ name: '', Email_Search: '', selectedButton: this.state.data[0].value, notFound: false, resetData: true })}>
