                                <TextInput style={mainstyles.contatus_input} placeholder={'Pin Code'} onChangeText={pin => this.setState({ pin })}
                                    value={this.state.pin}
                                    padding={8}
                                    placeholderTextColor='#000'
                                ></TextInput>

                            </View>

                            {/* <View style={{ margin: 5, marginTop: 8 }}>
                            <TextInput style={{ height: 85, color: 'black', width: "90%", borderColor: '#C8C8C8', borderWidth: 1, marginLeft: 15, marginRight: 15, marginTop: 3, paddingLeft: 10, textAlignVertical: 'top' }}
