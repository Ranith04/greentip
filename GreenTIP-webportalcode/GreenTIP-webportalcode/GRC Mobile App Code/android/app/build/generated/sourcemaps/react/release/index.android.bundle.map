    _saveDetails() {
        this.setState({ isModalVisible: true })
    }

    _Send_Email_ = async () => {
        const { Checked_id, checked } = this.state;

        // console.log('this.state.checked', checked)

        if (Checked_id.toString() === '') {
            alert("Please select at least one checkbox"); return;
        }
        else {
            var that = this;
            var res = await Constants.isNetworkAvailable();
            if (!res) {
                return false;
            }
            this.setState({ isLoading: true });
            const userIdnewww = await AsyncStorage.getItem('id')
            const formData = new FormData();
            formData.append('user_id', userIdnewww);
            formData.append('purpose_hidden', '4');
            formData.append('csv_ids_hidden', Checked_id.toString());
            // console.log('APi Check ','106,105')
            fetch(Constants.FullURL + '/users/manage_end_users', {
                method: 'POST',
                headers: {
                    'authorisation': this.authorisationToken
                },
                body: formData,
            }).then((response) => response.json())

                .then((responseJson) => {
                    console.log(responseJson)
                    if (responseJson.status === true) {
                        const type = responseJson.data;

                        this.setState(
                            {
                                isLoading: false,
                            },
                            function () {
                                // this.arrayholder = type.queries;
                            }
                        );
                        // Alert.alert(responseJson.message);
                        // Toast.show(responseJson.message, Toast.SHORT);
                        setTimeout(() => {
                            Toast.show(responseJson.message, Toast.SHORT);
                        }, 500);
                        //    this.setState({ Checked_id: false});
                        //  this.setState({ checked: false });
                        that.setState({ checked: new Array() });
                        //  this.setState({Checked_id: this.state.Checked_id.filter(item => item !== e.target.value)});
                        //  this.setState({Checked_id:[...this.state.Checked_id_]});
                        that.setState({ Checked_id: new Array() });


                        this.EndUser_Data();



                    } else if (responseJson.status === false) {
                        Alert.alert('Error', responseJson.message);
                        this.setState({ isLoading: false });
                    }
                })
                .catch(error => {
                    this.setState({ isLoading: false });
                    // console.log(error);
                })
        }
    }
    EndUser_Data = async () => {
        this.setState({ isLoading: true });
        var res = await Constants.isNetworkAvailable();
        if (!res) {
            return false;
        }
        const userIdnewww = await AsyncStorage.getItem('id')
        var params = {
            'user_id': userIdnewww,
            'start': this.state.currentPage,
            'per_page': this.state.per_page,
            'list_by': 'end_user'
        };
        console.log('params', params)
        var formData = new FormData();

        for (var k in params) {
            formData.append(k, params[k]);
        }
        fetch(Constants.FullURL + '/users/admin_users', {
            method: 'POST',
            headers: {
                'authorisation': this.authorisationToken
            },
            body: formData,
        }).then((response) => response.json())

            .then((responseJson) => {
                console.log((responseJson))
                if (responseJson.status === true) {
                    const type = responseJson.data;
                    console.log('type', type)

                    this.setState(
                        {
                            isLoading: false,
                            dataSource: this.state.currentPage == 1 ? type.end_user_list : [...this.state.dataSource, ...type.end_user_list],
                            //  imgPath: type.imagepath
                            //   total_inbox:type.total
                            total: type.total,
                            isFirstTime: (type.end_user_list.length == 0) ? false : true
                        },
                        function () {
                            this.arrayholder = type.end_user_list;
                            // this.arrayholder = type.queries;
                        }
                    );


                    //Alert.alert(responseJson.message);

                } else if (responseJson.status === false) {
                    Alert.alert('Error', responseJson.message);
                    this.setState({ isLoading: false });
                }
            })
            .catch(error => {
                this.setState({ isLoading: false });
                // console.log(error);
            })

    }

    Delete_User = async (roleUserID) => {
        Alert.alert(
            'Are you sure you want to perform this action ?',
            '',
            [
                {
                    text: 'Cancel',
                    onPress: () => console.log('Cancel Pressed'),
                    style: 'cancel',
                },
                { text: 'OK', onPress: () => this.onDeleteBTN(roleUserID) },
            ]
        );
    }
    onDeleteBTN = async (roleUserID) => {
        var res = await Constants.isNetworkAvailable();
        if (!res) {
            return false;
        }
        this.setState({ isLoading: true });
        const userIdnewww = await AsyncStorage.getItem('id')

        var params = {
            'user_id': userIdnewww,
            'roleUserID': roleUserID,
        };
        console.log('params', params)
        var formData = new FormData();

        for (var k in params) {
            formData.append(k, params[k]);
        }

        fetch(Constants.FullURL + '/users/admin_delete_user', {
            method: 'POST',
            headers: {
                'authorisation': this.authorisationToken
            },
            body: formData,
        }).then((response) => response.json())

            .then((responseJson) => {
                console.log(responseJson)
                if (responseJson.status === true) {
                    const type = responseJson.data;
                    Alert.alert(responseJson.message);
                    this.setState(
                        {
                            isLoading: false,
                        },
                        function () {
                            // this.arrayholder = type.queries;
                        }
                    );
                    this.EndUser_Data();
                } else if (responseJson.status === false) {
                    Alert.alert('Error', responseJson.message);
                    this.setState({ isLoading: false });
                }
            })
            .catch(error => {
                this.setState({ isLoading: false });
                // console.log(error);
            })

    }

    SearchFilterFunction(name, email, status) {
        if (this.state.resetData == true) {
            this.EndUser_Data();
        } else if (name && status && !email) {
            this.state.newData = this.arrayholder.filter(function (item) {
                console.log(item.name == name && item.status == status);
                //applying filter for the inserted text in search bar
                if (item.status == status) {
                    const itemData = item.name ? item.name.toUpperCase() : ''.toUpperCase();
                    const textData = name.toUpperCase();
                    return itemData.indexOf(textData) > -1;
                }
            });
            if (this.state.newData.length != 0) {
                console.log(this.state.newData);
                console.log('yfukyhj654153');
                this.setState({ dataSource: this.state.newData, notFound: false });
            } else {
                console.log('yfukyhj');
                this.setState({ dataSource: '', notFound: true });
            }
        } else if (email && status && !name) {
            this.state.newData = this.arrayholder.filter(function (item) {
                //applying filter for the inserted text in search bar
                if (item.email && item.status == status) {
                    const itemData = item.email ? item.email.toUpperCase() : ''.toUpperCase();
                    const textData = email.toUpperCase();
                    return itemData.indexOf(textData) > -1;
                }
            });
            if (this.state.newData.length != 0) {
                this.setState({ dataSource: this.state.newData, notFound: false });
            } else {
                this.setState({ dataSource: '', notFound: true });
            }
        } else if (status && !name && !email) {
            this.state.newData = this.arrayholder.filter(function (item) {
                const itemData = item.status ? item.status.toUpperCase() : ''.toUpperCase();
                const textData = status.toUpperCase();
                return itemData.indexOf(textData) > -1;
            });
            if (this.state.newData.length != 0) {
                this.setState({ dataSource: this.state.newData, notFound: false });
            } else {
                this.setState({ dataSource: '', notFound: true });
            }
        } else if (name && email && status) {
            this.state.newData = this.arrayholder.filter(function (item) {
                //applying filter for the inserted text in search bar
                if (item.email && item.status == status) {
                    const itemData = item.email ? item.email.toUpperCase() : ''.toUpperCase();
                    const textData = email.toUpperCase();
                    return itemData.indexOf(textData) > -1;
                }
            });
            if (this.state.newData.length != 0) {
                this.setState({ dataSource: this.state.newData, notFound: false });
            } else {
                this.setState({ dataSource: '', notFound: true });
            }
        }
        this.setState({
            name: name ? name : '',
            email: email ? email : ''
        });
        this.setState({ isModalVisible: false, resetData: false })
    }

    handleChange = (index, item) => {
        let checked = [...this.state.checked];
        //  if(checked[index])

        checked[index] = !checked[index];
        this.setState({ checked });


        // console.log('checked[index]', checked[index])
        let Checked_Array = this.state.Checked_id;

        if (checked[index]) {
            Checked_Array.push(parseInt(item));
            //  alert('1')
        } else {

            Checked_Array.pop(index, 1);
            // alert('2')

        }
        this.setState({ Checked_id: Checked_Array });

        console.log('hand', this.state.Checked_id);


    }

    handleLoadMore = async () => {
        console.log('load more handled');
        if (this.state.isFirstTime) {
            this.setState({
                currentPage: this.state.currentPage + 1
            })
            this.EndUser_Data();
        }

    }
