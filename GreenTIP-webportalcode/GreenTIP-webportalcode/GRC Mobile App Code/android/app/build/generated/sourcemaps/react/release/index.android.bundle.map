import React, { Component } from 'react';
import {
  StyleSheet,
  Text,
  View,
  TextInput,
  TouchableOpacity,
  TouchableHighlight,
  Image,
  Alert,
  StatusBar,
  BackHandler,
  FlatList,
  ActivityIndicator,
  Button
} from 'react-native';

import { Popover, PopoverContainer } from 'react-native-simple-popover';
import Modal from 'react-native-modal';
import Toast from 'react-native-simple-toast';
import { createAppContainer } from 'react-navigation';
import { createStackNavigator } from 'react-navigation-stack';
import AsyncStorage from '@react-native-community/async-storage';
import { NavigationEvents } from "react-navigation";
import Spinner from 'react-native-loading-spinner-overlay';
import DatePicker from 'react-native-datepicker';
import Icon from 'react-native-vector-icons/FontAwesome';
import ProgressLoader from 'rn-progress-loader';
import Constants from '../Constants';
import DateFilter from '../Component/dateFilter';
import ViewDownload from '../Component/viewDownload';
import mainstyles from '../Component/mainstyles';
export default class NewQuery extends Component {

  static navigationOptions = ({ navigation }) => {
    const new_query = navigation.getParam('new_query');
    return {
      title: 'New Query',
      headerStyle: {
        backgroundColor: '#0ea457',
      },
      headerTintColor: '#FFFFFF',
      headerTitleAlign: 'center',

      headerTitleStyle: {
        fontSize: 20,

      },

      headerRight: (
        <View style={{ flexDirection: 'row' }}>
          <View style={{ position: 'absolute', right: 10, alignSelf: 'flex-end', bottom: 15 }}>
            <Image source={require('../imgs/inbox_icon.png')} style={{ marginRight: 10 }} />
          </View>
          <View style={{ position: 'absolute', right: 10, bottom: 20, alignSelf: 'flex-end', borderRadius: 15, backgroundColor: 'red', width: 18, height: 18 }}>
            <Text style={{ color: '#FFFFFF', fontSize: 12, textAlign: 'center', fontWeight: 'bold' }}>{new_query}</Text>
          </View>
        </View>
      )
    }
  }
  constructor(props) {
    super(props);
    this.toggleModal = this.toggleModal.bind(this);
    this.handleBackButtonClick = this.handleBackButtonClick.bind(this);
    this.state = {
      isVisible: false, //state of modal default false
      isPopoverVisible: 0,
      showPop: false,
      popoverPlacement: 'left',
      isModalVisible: false,
      isLoading: false,
      spinner: true,
      imgPath: '',
      query_item: '',
      enduser_i: '',
      id: '',
      DiscardReason: '',
      date: '',
      date_End: '',
      dataSource: [],
      currentPage: 1,
      per_page: Constants.PerPage,
      isFirstTime: true,
      total: 0,
    }

  }


  toggleModal_Close = () => {
    this.setState({ isModalVisible: !this.state.isModalVisible });

  };
  toggleModal = (query, enduser_image, id) => {
    console.log('enduser_image', enduser_image)
    this.setState({ isModalVisible: !this.state.isModalVisible, query_item: query });
    this.setState({ enduser_i: enduser_image });
    this.setState({ id: id });
  };


  componentWillMount() {
    BackHandler.addEventListener('hardwareBackPress', this.handleBackButtonClick);
    this.DashboardDataNewQuery();

  }

  componentWillUnmount() {
    BackHandler.removeEventListener('hardwareBackPress', this.handleBackButtonClick);
  }

  handleBackButtonClick() {
    console.log("hello_props", this.props);
    this.props.navigation.goBack(null);
    // BackHandler.exitApp();
    return true;
  }

  FlatListItemSeparator = () => {
    return (
      <View
        style={{
          height: 1,
          width: '100%',
          backgroundColor: '#ccc',
        }}
      />
    );
  }
  validate_field = (id) => {
    Alert.alert(
      'Alert',
      'Are you sure you want to discard this query ?',
      [
        {
          text: 'OK',
          onPress: () => this.Discard_Query(id)
        },
        {
          text: 'Cancel',
          onPress: () => console.log('Cancel Pressed')
        }
      ],
      { cancelable: false }
    )
  }

  Discard_Query = async (queryID) => {
    var res = await Constants.isNetworkAvailable();
      if (!res) {
        return false;
      }
    this.setState({ isLoading: true });
    const user_id = await AsyncStorage.getItem('id')
    var params = {
      'query_id': queryID,
      'user_id': user_id,
    };

    console.log('params', params)
    var formData = new FormData();

    for (var k in params) {
      formData.append(k, params[k]);
    }


    fetch(Constants.FullURL + '/users/discard_query', {
      method: 'POST',
      headers: {
        'authorisation': this.authorisationToken
      },
      body: formData,
    }).then((response) => response.json())

      .then((responseJson) => {
        console.log(responseJson)
        if (responseJson.status === true) {
          const type = responseJson.data;
          // Alert.alert(responseJson.message);
        //  Toast.show(responseJson.message, Toast.LONG);
          setTimeout(() => {
            Toast.show(responseJson.message, Toast.SHORT);
        }, 500);

          this.setState(
            {
              isLoading: false,

            },
            function () {
              // this.arrayholder = type.queries;
            }
          );
          this.setState({ currentPage: 1 });
          this.DashboardDataNewQuery();
        } else if (responseJson.status === false) {
          Alert.alert('Error', responseJson.message);
          this.setState({ isLoading: false });

        }
      })
      .catch(error => {
        this.setState({ isLoading: false });
      })
  }


  DashboardDataNewQuery = async () => {
    this.setState({ isLoading: true });
    var res = await Constants.isNetworkAvailable();
      if (!res) {
        return false;
      }
    const userIdnewww = await AsyncStorage.getItem('id')

    var params = {
      'user_id': userIdnewww,
      'response_type': 'all',
      'start': this.state.currentPage,
      'per_page': this.state.per_page

    };
    console.log('params', params)
    var formData = new FormData();

    for (var k in params) {
      formData.append(k, params[k]);
    }

    fetch(Constants.FullURL + '/users/dashboard', {
      method: 'POST',
      headers: {
        'authorisation': this.authorisationToken
      },
      body: formData,
    }).then((response) => response.json())

      .then((responseJson) => {
        console.log(responseJson)
        if (responseJson.status === true) {
          const type = responseJson.data;
          this.setState(
            {
              isLoading: false,
              dataSource: this.state.currentPage == 1 ? type.queries : [...this.state.dataSource, ...type.queries],
              imgPath: type.imagepath,
              total: type.total,
              isFirstTime: (type.queries.length == 0) ? false : true
              //   total_inbox:type.total
            },
            function () {
              // this.arrayholder = type.queries;
              this.arrayholder = this.state.currentPage == 1 ? type.queries : [...this.arrayholder, ...type.queries];
            }
          );


          //Alert.alert(responseJson.message);

        } else if (responseJson.status === false) {
          Alert.alert('Error', responseJson.message);
          this.setState({ isLoading: false });
        }
      })
      .catch(error => {
        this.setState({ isLoading: false });
        //console.log(error);
      })
  }
  showPopover = (val) => {
    if (this.state.isPopoverVisible == val) {
      this.setState({ isPopoverVisible: 0 });
    } else {
      this.setState({ isPopoverVisible: val });
    }
    console.log(val);
  }



  ResetData = async () => {
    console.log('resetData');
    this.setState({ date: '' });
    this.setState({ date_End: '' });
    this.setState({ currentPage: 1 });
    this.DashboardDataNewQuery();

  }






  getData = (data) => {
    console.log('mydate', data);
    const newData = this.arrayholder.filter(function (item) {

      //applying filter for the inserted text in search bar
      return item.added_on.substring(0, item.added_on.length - 9) >= data.date && item.added_on.substring(0, item.added_on.length - 9) <= data.date_End

    });
    this.setState({
      //setting the filtered newData on datasource
      //After setting the data it will automatically re-render the view
      dataSource: newData,
      //search: date,
    });
  }

  handleLoadMore = async () => {
    console.log('load more handled');
    if (this.state.isFirstTime) {
      this.setState({
        currentPage: this.state.currentPage + 1
      })
      this.DashboardDataNewQuery();
    }

  }

  render() {

    return (
      <View style={{ flex: 1 }}>

        <ProgressLoader
          visible={this.state.isLoading}
          isModal={true} isHUD={true}
          hudColor={"#00A637"}
          style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
          color={"#FFFFFF"} />

        <NavigationEvents
          onDidFocus={this.DashboardDataNewQuery}
          onWillFocus={() => this.setState({ isLoading: false, currentPage: 1 })}

        />

        <View style={{ backgroundColor: '#fff' }}>
          <DateFilter getData={this.getData} ResetData={this.ResetData} />
        </View>

        <View style={{ flex: 1, backgroundColor: '#fff' }}>

          {this.state.dataSource.length === 0 ? <View style={mainstyles.norecordFound}>
            <Text style={mainstyles.norecordFound_Text}>No Query found here</Text>
          </View> : null}

          <FlatList
            data={this.state.dataSource}
            keyExtractor={(item) => item.id}
            ItemSeparatorComponent={this.FlatListItemSeparator}
            initialNumToRender={this.state.per_page}   // how many item to display first
            onEndReachedThreshold={0.5}
            onEndReached={() => this.callOnScrollEnd = true}
            onMomentumScrollEnd={() => {
              this.callOnScrollEnd && this.handleLoadMore()
              this.callOnScrollEnd = false
            }}
            bounces={false}
            extraData={this.state}
            renderItem={({ item }) => (
              <PopoverContainer >
                <View style={{ flex: 1 }}>
                  <StatusBar barStyle="dark-content" backgroundColor="#0ea457" />
                  <View style={{ flex: 1, flexDirection: 'column', alignItems: 'center' }}>
                    <View style={{ flexDirection: 'row', backgroundColor: '#FFFFFF', marginTop: this.state.isPopoverVisible === item.id ? '3%' : 0 }}>
                      {item.enduser_image == null ? <Image source={require('../imgs/no_image.jpg')}
                        style={{ alignSelf: 'center', width: 50, height: 50, borderRadius: 150 / 2, marginLeft: 15 }} /> : <Image source={{ uri: this.state.imgPath + item.enduser_image }} style={{ alignSelf: 'center', width: 50, height: 50, borderRadius: 150 / 2, marginLeft: 15 }} />}

                      <View style={mainstyles.right_container}>
                        <Text style={mainstyles.query}>{item.query}  </Text>
                        <Text style={mainstyles.category_ask}>Category: {item.category_name} </Text>
                        <Text style={mainstyles.category_ask} >Ask: {item.added_on} </Text>
                        <Text style={mainstyles.category_ask} >Asked By: {item.name} </Text>
                        {item.status == 2 ? <View style={{ flexDirection: 'row', flexWrap: 'wrap' }}>
                          <Text style={mainstyles.category_ask}>Status:</Text>
                          <Text style={[mainstyles.category_ask, { color: 'red' }]} >Rejected</Text>
                        </View> : null}
                        {item.query_image != null &&  <ViewDownload itemData={item?item:''}/>}
                      </View>


                      <View style={styles.container}>
                        {item.status == 0 ? <Popover placement={this.state.popoverPlacement} isVisible={this.state.isPopoverVisible === item.id} component={() => (
                          <View style={{ borderColor: 'black', elevation: 5, margin: 2, marginTop: '20%', backgroundColor: '#FFFFFF', shadowOffset: { width: 0, height: 1 }, shadowOpacity: 0.8, shadowRadius: 2 }} >
                            <TouchableHighlight underlayColor="#0ea45701" style={{ borderBottomWidth: 1, borderBottomColor: '#ccc', elevation: 0.5 }} onPress={() => this.props.navigation.navigate('AssignExpert', { 'query': item.query, 'enduser_image': item.enduser_image, 'imgPath': this.state.imgPath, 'id': item.id, 'AssigntoMD': 'AssigntoMD' })}>
                              <Text style={{ backgroundColor: '#fff', padding: 5, color: '#000', fontSize: 15 }} > Assign To MD   </Text>
                            </TouchableHighlight>
                            <TouchableHighlight underlayColor="#0ea45701" style={{ borderBottomWidth: 1, borderBottomColor: '#ccc', elevation: 0.5 }} onPress={() => this.props.navigation.navigate('AssignExpert', { 'query': item.query, 'enduser_image': item.enduser_image, 'imgPath': this.state.imgPath, 'id': item.id })}>
                              <Text style={{ backgroundColor: '#fff', padding: 5, color: '#000', fontSize: 15 }} > Assign To Expert    </Text>
                            </TouchableHighlight>

                            <TouchableOpacity onPress={() => {
                              this.validate_field(item.id);
                            }}>
                              <Text style={{ backgroundColor: '#FFFFFF', color: 'black', padding: 5, fontSize: 15 }}> Discard  </Text>
                            </TouchableOpacity>
                          </View>
                        )}>
                          <TouchableOpacity onPress={() => this.showPopover(item.id)}>
                            <Image source={require('../imgs/dott.png')} style={{ borderRadius: 150 / 2, marginTop: 12, marginRight: 5 }} />
                          </TouchableOpacity>
                        </Popover> : null}
                      </View>
                    </View>
                  </View>
                </View>
              </PopoverContainer>

            )}


          />


        </View>





      </View>

    )

  }
}

