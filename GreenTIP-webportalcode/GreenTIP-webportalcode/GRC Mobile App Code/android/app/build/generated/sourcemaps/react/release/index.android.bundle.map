import React, { createRef, Component } from "react";
import styles from "./dateFilterStyles";
import {
  View,
  Text,
  Image,
  FlatList,
  TouchableWithoutFeedback,
  TouchableOpacity,
  AsyncStorage,
  TextInput,
  TouchableHighlight,
  Animated,
  Keyboard,
  Dimensions,
  UIManager,
  Share,
  Modal,
  ImageBackground,
  SafeAreaView,
  ScrollView,
  Linking,
  Alert
} from "react-native";
import Constants from '../Constants';
import Icon from 'react-native-vector-icons/FontAwesome';
import mainstyles from './mainstyles';
import ProgressLoader from 'rn-progress-loader';
export default class ViewDownload extends Component {


  constructor(props) {
    super(props);

    this.state = {
      items: '',
      expertAnswerData: '',
      roleId:'',
      isLoading:false,
      isAnswerDeleted:true
    };

  }



  async componentDidMount() {
    await this.setState({ items: (typeof this.props.itemData != 'undefined') ? this.props.itemData : '' })
    await this.setState({ expertAnswerData: (typeof this.props.expertAnswerData != 'undefined') ? this.props.expertAnswerData : '' });
    var roleId = await AsyncStorage.getItem('role_type');
    await this.setState({ roleId: roleId});


  }

  Confirm(assign_query_id){
    Alert.alert(
      'Are you sure you want to delete?',
      '',
      [
        {
          text: '',
          onPress: () => console.log('Ask me later pressed')
        },
        {
          text: 'Cancel',
          onPress: () => console.log('Cancel Pressed'),
          style: 'cancel'
        },
        { text: 'OK', onPress: () => this.deleteAttachment(assign_query_id) }
      ],
      { cancelable: false }
    );
  }
deleteAttachment = async (assign_query_id) => {
  this.setState({ isLoading: true });

  var params = {
      'assign_query_id': assign_query_id,
     
  };
  console.log('paramssss', params);
  var formData = new FormData();

  for (var k in params) {
      formData.append(k, params[k]);
  }

  fetch(Constants.FullURL + '/users/deleteAttachment', {
      method: 'POST',
      body: formData,
  }).then((response) => response.json())
      .then((responseJson) => {
          console.log(responseJson)
          if (responseJson.status === true) {
              const respData = responseJson.data;
              // Alert.alert('Congrats! Your review has been submitted.');
            //  Toast.show(responseJson.message, Toast.SHORT);

              setTimeout(() => {
                Toast.show(responseJson.message, Toast.SHORT);
            }, 500);


              this.setState({
                  isLoading: false,
                  isAnswerDeleted:false,
              });
          } else if (responseJson.status === false) {
              Alert.alert('Error', responseJson.message);
              this.setState({ isLoading: false });
          }
      })
      .catch(error => {
          this.setState({ isLoading: false });
          console.log(error);
      })
}

  render() {
   
    return (
      <View>
          <ProgressLoader
                    visible={this.state.isLoading}
                    isModal={true} isHUD={true}
                    hudColor={"#00A637"}
                    style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
                    color={"#FFFFFF"} />
        {this.state.items != '' && <View style={{ flexDirection: 'row' }}>
          <View style={{ width: '50%' }}>
            {/* <TouchableOpacity onPress={() => Linking.openURL(this.state.adminAnswer.upload_full_image)}>
                                               <Icon name="eye" size={20} color="#00AD39" /> 
                                                    <Text style={{ color: '#00AD39', fontSize: 18 }}>Attachment</Text>
                                                </TouchableOpacity>*/}
          </View>
          <View style={{ width: '50%' }}>
            <TouchableOpacity onPress={() => Linking.openURL(Constants.APIURL + this.state.items.query_image)}>
              <Text style={{ color: '#00AD39', fontSize: 18, textAlign: 'right' }}><Icon name="eye" size={20} color="#00AD39" /> View </Text>
            </TouchableOpacity>
          </View>
        </View>}
        {(this.state.expertAnswerData != ''  && this.state.isAnswerDeleted)&& <View style={{ flex: 1, flexDirection: 'row', width: '100%', padding: '2%', }}>
          <View style={{ width: '50%' }}>
            {/* <TouchableOpacity onPress={() => Linking.openURL(this.state.expertAnswerData.upload_full_image)}>
                                                <Icon name="eye" size={20} color="#00AD39" /> 
                                                    <Text style={{ color: '#00AD39', fontSize: 18 }}>Attachment</Text>
                                                </TouchableOpacity>*/}
          </View>
          <View style={{ width: '50%' }}>
         
              {this.state.expertAnswerData.answerData.upload_full_image && <TouchableOpacity onPress={() => Linking.openURL(this.state.expertAnswerData.answerData.upload_full_image)} >
                <Text style={{ color: '#00AD39', fontSize: 18, textAlign: 'right', alignItems: 'flex-end' }}><Icon name="eye" size={20} color="#00AD39" /> View</Text>
              </TouchableOpacity>}
          
          </View>
        </View>}
      </View>
    );
  }
}
