import DateFilter from '../Component/dateFilter';
import mainstyles from '../Component/mainstyles';
export default class EndUserDashboard extends Component {
    arrayholder;
    static navigationOptions = {
        header: null,
    };

    constructor(props) {
        super(props);
        this.arrayholder = [];
        this.state = {
            isVisible: false, //state of modal default false
            isPopoverVisible: 0,
            showPop: false,
            popoverPlacement: 'left',
            isModalVisible: false,
            isModalVisible_Answer: false,
            isLoading: false,
            spinner: true,
            imgPath: '',
            query_item: '',
            enduser_i: '',
            id: '',
            DiscardReason: '',

            question_Answer: '',
            query_id_Answer: '',
            enduser_image: '',
            category_name_Answer: '',
            total_inbox: '',
            new_query: '',
            answered_query: '',
            rejected_query: '',
            userName: '',
            userImg: '',

        }
        //this.DashboardEndUser();
    }


    componentWillMount() {
        // this._retrieveData()
        BackHandler.addEventListener('hardwareBackPress', this.handleBackButton);
        //new Common().check_intra_add();
        this.getData()
        this._retrieveData()
    }


    componentWillUnmount() {
        BackHandler.removeEventListener('hardwareBackPress', this.handleBackButton);
        //this._retrieveData();

        //new Common().check_intra_Re();
    }
    _removeData = async () => {
        try {
            /* await AsyncStorage.removeItem('role_type');
            await AsyncStorage.removeItem('userName');
            await AsyncStorage.removeItem('email');
            await AsyncStorage.removeItem('contact_no'); */
            BackHandler.exitApp()
        } catch (error) {
            // Error retrieving data
            console.log(error.message);
        }
    };

    handleBackButton = () => {
        Alert.alert(
          'Exit App',
          'Are you sure you want to exit?', [{
            text: 'CANCEL',
            onPress: () => console.log('Cancel Pressed'),
            style: 'cancel'
          },
          {
            text: 'EXIT',
            onPress: () => {this._removeData()}
          },],
          {
            cancelable: false
          }
        )
        return true;
      }

    onButtonPress = () => {
        BackHandler.removeEventListener('hardwareBackPress', this.handleBackButton);
        // then navigate
    }


    toggleDrawer = () => {
        //Props to open/close the drawer
        this.props.navigation.dispatch(DrawerActions.toggleDrawer());
        // this.props.navigationProps.toggleDrawer();
        //this.props.navigation.toggleDrawer()
    };

    
  
    
    _storeData = async (total_inbox) => {
        try {
            await AsyncStorage.setItem('total_inbox', total_inbox);
            console.log('total_inbox', total_inbox)
            //alert(userImg);
            // alert('_storeData')

        } catch (error) {
            // Error saving data
        }
    };

    _retrieveData = async () => {
        try {
            const name = await AsyncStorage.getItem('role_type');
            //Alert.alert(this.state.userName);
            if (name !== null) {
                // this.setState({ name })
                // alert('okay.')
            }
        } catch (e) {
            // alert('Failed to load name.')
        }
    };

    getData = async () => {
        try {
            const userName = await AsyncStorage.getItem('userName');
            const userImg = await AsyncStorage.getItem('userImg');
            this.setState({ userName: userName });
            this.setState({ userImg: userImg });
            this.DashboardEndUser();
        } catch (e) {
            alert(e);
        }
    }


    DashboardEndUser = async () => {
        this.setState({ isLoading: true });
        const userId = await AsyncStorage.getItem('id')

        const formData = new FormData();
        formData.append("user_id", userId);
        fetch(Constants.FullURL+'/users/count_dashboard', {
            method: 'POST',
            body: formData,
        }).then((response) => response.json())
            .then((responseJson) => {
                console.log(responseJson);
                if (responseJson.status === true) {
                    this.setState({ total_inbox: responseJson.data.total_inbox });
                    AsyncStorage.setItem('count', this.state.total_inbox)
                    this.setState({ new_query: responseJson.data.new_query });
                    this.setState({ answered_query: responseJson.data.answered_query });
                    this.setState({ rejected_query: responseJson.data.rejected });
                    this._storeData(JSON.stringify(responseJson.data.rejected))

                } else if (responseJson.status === false) {
                    Alert.alert('Error', responseJson.message);
                    
                }
                this.setState({ isLoading: false });
                console.log(responseJson);
            })
            .catch((error) => {
                console.error(error);
                alert(error);
                this.setState({ isLoading: false });
            });
    }
    
    render() {

        return (
            <SafeAreaView forceInset={{ bottom: 'never' }} style={{ flex: 1, backgroundColor: '#FFFFFF' }}>
                {Platform.OS === 'ios' &&
 <View style={{
     width: "100%",
     height: 100, // For all devices, even X, XS Max
     position: 'absolute',
     top: 0,
     left: 0,
     backgroundColor: "#0ea457"}}
/>}
                <View style={styles.Parent_View}>
                    <NavigationEvents
                        onDidFocus={this.DashboardEndUser}
                        onWillFocus={() => this.setState({ isLoading: false })}
                    />
                    <ProgressLoader
                        visible={this.state.isLoading}
                        isModal={true} isHUD={true}
                        hudColor={"#00A637"}
                        style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
                        color={"#FFFFFF"} />
                    <StatusBar barStyle="dark-content" backgroundColor="#0ea457" />
                   
                    <View style={styles.View_V8}>
                        <TouchableOpacity onPress={this.toggleDrawer.bind(this)}>
                            <Image source={require('../imgs/menu_dash.png')} style={styles.Menu_Dash} />
                        </TouchableOpacity>

                        <View style={styles.Dash_TV}>
                            <Text style={styles.Dash_TV_Child}>Dashboard</Text>
                        </View>


                    </View>

                    <View style={styles.View_V9}>

                        <TouchableHighlight underlayColor="#ffffff00" style={styles.View_Ask_bt}
                            onPress={() => this.props.navigation.navigate('Askourexpert')} >
                            <Text style={styles.View_Ask_TV}>Ask our experts</Text>
                        </TouchableHighlight>
                    </View>
                    <View style={{ height: '100%'}} >
           
                <View style={{ flexDirection: 'column', elevation: 5, padding: 10, margin: 2, marginLeft: 15, marginTop: 10, borderBottomWidth: 4, borderBottomColor: '#69A0E2', marginRight: 15, backgroundColor: '#FFFFFF' }}>
                  <TouchableOpacity onPress={() => this.props.navigation.navigate('QueryDashboard', { 'count': this.state.new_query, 'title': 'New Queries', 'type': 'expert'  }, this.props)}>
                    <View style={{ flexDirection: 'row' }}>
                      <Image source={require('../imgs/new_query.png')} style={{ borderRadius: 150 / 2, width: 75, height: 75, justifyContent: 'center' }} />
                      <View style={{ width: '75%' }}>
                        <Text style={{ color: '#262C2F', fontSize: 30, marginLeft: 25, marginTop: 3, fontWeight: '600', textAlign: 'right', alignItems: 'flex-end' }}> {this.state.new_query}</Text>

                      </View>
                    </View>
                    <Text style={{ color: '#69A0E2', fontSize: 20, marginLeft: 15, marginTop: 3, textAlign: 'right' }}>New Query</Text>
                  </TouchableOpacity>
                </View>

                <View style={{ flexDirection: 'column', elevation: 5, padding: 10, margin: 2, marginLeft: 15, marginTop: 8, borderBottomWidth: 4, borderBottomColor: '#FF9D59', marginRight: 15, backgroundColor: '#FFFFFF' }}>
                  <TouchableOpacity onPress={() => this.props.navigation.navigate('QueryDashboard', { 'count': this.state.answered_query, 'title': 'Answered Queries', 'type': 'answered_expert'  }, this.props)}>
                    <View style={{ flexDirection: 'row' }}>
                      <Image source={require('../imgs/respond.png')} style={{ borderRadius: 150 / 2, width: 75, height: 75 }} />
                      <View style={{ width: '75%' }} >
                        <Text style={{ color: '#262C2F', fontSize: 30, marginLeft: 25, marginTop: 3, fontWeight: '600', textAlign: 'right', alignItems: 'flex-end' }}> {this.state.answered_query} </Text>
                      </View>

                    </View>
                    <Text style={{ color: '#FF9D59', fontSize: 20, marginLeft: 15, marginTop: 3, textAlign: 'right' }}>Answered</Text>
                  </TouchableOpacity>
                </View>

                <View style={{ flexDirection: 'column', elevation: 5, padding: 10, margin: 2, marginLeft: 15, marginTop: 8, borderBottomWidth: 4, borderBottomColor: '#AC3DEA', marginRight: 15, backgroundColor: '#FFFFFF' }}>
                  <TouchableOpacity onPress={() => this.props.navigation.navigate('QueryDashboard', { 'count': this.state.rejected_query, 'title': 'Rejected Queries', 'type': 'unanswered_expert'  }, this.props)}>
                    <View style={{ flexDirection: 'row' }}>
                      <Image source={require('../imgs/responded.png')} style={{ borderRadius: 150 / 2, width: 75, height: 75 }} />
                      <View style={{ width: '75%' }} >
                        <Text style={{ color: '#262C2F', fontSize: 30, marginLeft: 25, marginTop: 3, fontWeight: '600', textAlign: 'right', alignItems: 'flex-end' }}> {this.state.rejected_query}</Text>
                      </View>
                    </View>
                    <Text style={{ color: '#AC3DEA', fontSize: 20, marginLeft: 15, marginTop: 3, textAlign: 'right' }}>Rejected</Text>
                  </TouchableOpacity>
                </View>
             
          </View>
                   
                </View>
            </SafeAreaView>

        )
    }
}




