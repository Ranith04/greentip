          <ImageBackground source={require('../imgs/bgg.png')} style={{ width: '100%', height: 250 }}>
            <View style={{ flexDirection: 'row' }}>
              <TouchableOpacity onPress={this.toggleDrawer.bind(this)}>
                <Image source={require('../imgs/menu_dash.png')} style={{ marginLeft: 20, marginTop: 20 }} />
              </TouchableOpacity>
              <View style={{ position: 'absolute', right: 10, alignSelf: 'flex-end', top: 1 }}>
                <Image source={require('../imgs/inbox_icon.png')} style={{ marginRight: 10, marginTop: 15 }} />
              </View>
              <View style={{ position: 'absolute', right: 10, alignSelf: 'flex-end', borderRadius: 15, backgroundColor: 'red', width: Platform.OS == 'ios' ? 20 : 18, height: Platform.OS == 'ios' ? 20 : 18 }}>
                <Text style={{ color: '#FFFFFF', fontSize: 12, textAlign: 'center', fontWeight: 'bold', marginTop: Platform.OS == 'ios' ? 2 : 0 }}> {this.state.total_inbox} </Text>
              </View>
            </View>

            <View style={styless.MainContainer}>
              {this.state.userImg != null && this.state.userImg != "" ? <Image source={{ uri: this.state.userImg }} style={{ width: 90, height: 90, borderRadius: 150 / 2, marginTop: 5 }} /> : <Image source={require('../imgs/no_image.jpg')} style={{ width: 90, height: 90, borderRadius: 150 / 2, marginTop: 5 }} />}

              {/* <Image source={{ uri: this.state.image }}
              style={{ width: 90, height: 90, borderRadius: 150 / 2, marginTop: 5 }} /> */}
            </View>

            <View style={{ alignItems: 'center', margin: 0 }}>
              <Text style={{ color: '#FFFFFF', fontSize: 16, marginTop: 2, alignItems: 'center' }}>Welcome</Text>
            </View>

            <View style={{ alignItems: 'center', margin: 0 }}>
              <Text style={{ color: '#FFFFFF', fontSize: 20, fontWeight: 'bold', marginTop: 0, alignItems: 'center' }}>{this.state.userName}</Text>
            </View>
          </ImageBackground>
          <View style={{ height: '100%', marginTop: Platform.OS == 'ios' ? '-10%' : '-16%' }} >
            <SafeAreaView style={{ flex: 1 }}>
              <ScrollView>
                <View style={{ flexDirection: 'column', elevation: 5, padding: 10, margin: 2, marginLeft: 15, marginTop: 10, borderBottomWidth: 4, borderBottomColor: '#69A0E2', marginRight: 15, backgroundColor: '#FFFFFF' }}>
                  <TouchableOpacity onPress={() => this.props.navigation.navigate('NewQuery', { 'new_query': this.state.new_query }, this.props)}>
                    <View style={{ flexDirection: 'row' }}>
                      <Image source={require('../imgs/new_query.png')} style={{ borderRadius: 150 / 2, width: 75, height: 75, justifyContent: 'center' }} />
                      <View style={{ width: '75%' }}>
                        <Text style={{ color: '#262C2F', fontSize: 30, marginLeft: 25, marginTop: 3, fontWeight: '600', textAlign: 'right', alignItems: 'flex-end' }}> {this.state.new_query} </Text>

                      </View>
                    </View>
                    <Text style={{ color: '#69A0E2', fontSize: 20, marginLeft: 15, marginTop: 3, textAlign: 'right' }}>New Query</Text>
                  </TouchableOpacity>
                </View>

                <View style={{ flexDirection: 'column', elevation: 5, padding: 10, margin: 2, marginLeft: 15, marginTop: 8, borderBottomWidth: 4, borderBottomColor: '#FF9D59', marginRight: 15, backgroundColor: '#FFFFFF' }}>
                  <TouchableOpacity onPress={() => this.props.navigation.navigate('AdminRespondQuery', { 'respond_query': this.state.respond_query }, this.props)}>
                    <View style={{ flexDirection: 'row' }}>
                      <Image source={require('../imgs/respond.png')} style={{ borderRadius: 150 / 2, width: 75, height: 75 }} />
                      <View style={{ width: '75%' }} >
                        <Text style={{ color: '#262C2F', fontSize: 30, marginLeft: 25, marginTop: 3, fontWeight: '600', textAlign: 'right', alignItems: 'flex-end' }}> {this.state.respond_query} </Text>
                      </View>

                    </View>
                    <Text style={{ color: '#FF9D59', fontSize: 20, marginLeft: 15, marginTop: 3, textAlign: 'right' }}>Respond</Text>
                  </TouchableOpacity>
                </View>

                <View style={{ flexDirection: 'column', elevation: 5, padding: 10, margin: 2, marginLeft: 15, marginTop: 8, borderBottomWidth: 4, borderBottomColor: '#AC3DEA', marginRight: 15, backgroundColor: '#FFFFFF' }}>
                  <TouchableOpacity onPress={() => this.props.navigation.navigate('AdminResponded', { 'responded_query': this.state.responded_query }, this.props)}>
                    <View style={{ flexDirection: 'row' }}>
                      <Image source={require('../imgs/responded.png')} style={{ borderRadius: 150 / 2, width: 75, height: 75 }} />
                      <View style={{ width: '75%' }} >
                        <Text style={{ color: '#262C2F', fontSize: 30, marginLeft: 25, marginTop: 3, fontWeight: '600', textAlign: 'right', alignItems: 'flex-end' }}> {this.state.responded_query} </Text>
                      </View>
                    </View>
                    <Text style={{ color: '#AC3DEA', fontSize: 20, marginLeft: 15, marginTop: 3, textAlign: 'right' }}>Responded</Text>
                  </TouchableOpacity>
                </View>
              </ScrollView>
            </SafeAreaView>
          </View>
        </View>
      </SafeAreaView>

    )
  }
}

