    getknwledgeData = async() => {
        var res = await Constants.isNetworkAvailable();
      if (!res) {
        return false;
      }
        this.setState({ isLoading: true });
        var params = {
            'page_name': 'knowledge-center'
        };
        console.log('params', params)
        var formData = new FormData();

        for (var k in params) {
            formData.append(k, params[k]);
        }


        fetch(Constants.FullURL + '/common/get_page_by_id_mobile', {
            method: 'POST',
            body: formData,
        }).then((response) => response.json())
            .then((responseJson) => {
                console.log(responseJson)
                if (responseJson.status === true) {
                    //Alert.alert(responseJson.url);
                    const content = (responseJson.content);
                    //console.log(responseJson.content);
                    this.setState(
                        {
                            isLoading: false,
                            dataSource: responseJson.documents,
                            links_Array: responseJson.links,
                            content: responseJson.content,

                            //   total_inbox:type.total
                        },
                        function () {
                            // this.arrayholder = type.queries;
                            this.arrayholder = responseJson.documents
                        }
                    );
                } else if (responseJson.status === false) {
                    this.setState({
                        isLoading: false
                    });
                    Alert.alert('Error', responseJson.message);
                }
            })
            .catch(error => {
                this.setState({ isLoading: false });
               // console.log(error);
            })
    }


