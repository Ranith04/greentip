import DateFilter from '../../Component/dateFilter';
import mainstyles from '../../Component/mainstyles';
export default class New_Query_Report extends Component {
    arrayholder;
    static navigationOptions = ({ navigation }) => {
        const count = navigation.getParam('count');
        const title = navigation.getParam('title');
      
        return {
            title: title,
            headerStyle: {
                backgroundColor: '#0ea457',
            },
            headerTintColor: '#FFFFFF',
            headerTitleAlign: 'center',

            headerTitleStyle: {
                fontSize: 20,

            },

            headerRight: (
                <View style={{ flexDirection: 'row' }}>
                    <View style={{ position: 'absolute', right: 10, alignSelf: 'flex-end', bottom: 15 }}>
                        <Image source={require('../../imgs/inbox_icon.png')} style={{ marginRight: 10 }} />
                    </View>
                    <View style={{ position: 'absolute', right: 10, bottom: 20, alignSelf: 'flex-end', borderRadius: 15, backgroundColor: 'red', width: 18, height: 18 }}>
                        <Text style={{ color: '#FFFFFF', fontSize: 12, textAlign: 'center', fontWeight: 'bold' }}>{count}</Text>
                    </View>
                </View>
            )
        }
    }

    constructor(props) {
        super(props);
        this.toggleModal = this.toggleModal.bind(this);
        this.handleBackButtonClick = this.handleBackButtonClick.bind(this);
        this.arrayholder =[];
        this.state = {
            isVisible: false, //state of modal default false
            isPopoverVisible: 0,
            showPop: false,
            popoverPlacement: 'left',
            isModalVisible: false,
            isLoading: false,
            spinner: true,
            imgPath: '',
            query_item: '',
            enduser_i: '',
            id: '',
            DiscardReason: '',
            date: '',
            date_End: '',
            dataSource: [],
            currentPage: 1,
            per_page: Constants.PerPage,
            isFirstTime: true,
            total: 0,



        }

    }


    toggleModal_Close = () => {
        this.setState({ isModalVisible: !this.state.isModalVisible });

    };
    toggleModal = (query, enduser_image, id) => {
        console.log('enduser_image', enduser_image)
        this.setState({ isModalVisible: !this.state.isModalVisible, query_item: query });
        this.setState({ enduser_i: enduser_image });
        this.setState({ id: id });
    };


    componentWillMount() {
        BackHandler.addEventListener('hardwareBackPress', this.handleBackButtonClick);

        this.mdNewQueriesReports();

    }



    componentWillUnmount() {
        BackHandler.removeEventListener('hardwareBackPress', this.handleBackButtonClick);
    }

    handleBackButtonClick() {
        console.log("hello_props", this.props);
        this.props.navigation.goBack(null);
        // BackHandler.exitApp();
        return true;
    }

    FlatListItemSeparator = () => {
        return (
            <View
                style={{
                    height: 1,
                    width: '100%',
                    backgroundColor: '#ccc'
                }}
            />
        );
    }





    ResetData = async () => {
        this.setState({ date: '' });
        this.setState({ date_End: '' });
        this.setState({ currentPage: 1 });
        this.mdNewQueriesReports();

    }
    mdNewQueriesReports = async () => {
        console.log(this.props.navigation?.state.params.url);
        var url = this.props.navigation?.state.params.url;
        this.setState({ isLoading: true });
        const userIdnewww = await AsyncStorage.getItem('id')
        var params = {
            'user_id': userIdnewww,
            'start': this.state.currentPage,
            'per_page': this.state.per_page

        };
        console.log('params', params)
        var formData = new FormData();

        for (var k in params) {
            formData.append(k, params[k]);
        }

        fetch(Constants.FullURL + '/users/' + url, {
            method: 'POST',
           
            body: formData,
        }).then((response) => response.json())

            .then((responseJson) => {
                console.log(responseJson)
                if (responseJson.status === true) {
                    const type = responseJson.data;

                    this.setState(
                        {
                            isLoading: false,
                            dataSource: this.state.currentPage == 1 ? type : [...this.state.dataSource, ...type],
                            isFirstTime: (type.length == 0) ? false : true
                            //  imgPath: type
                            //   total_inbox:type.total
                        },
                        function () {
                            this.arrayholder =  this.state.currentPage == 1 ? type : [...this.arrayholder, ...type];
                        }
                    );


                    //Alert.alert(responseJson.message);

                } else if (responseJson.status === false) {
                    Alert.alert('Error', responseJson.message);
                    this.setState({ isLoading: false });
                }
            })
            .catch(error => {
                this.setState({ isLoading: false });
                console.log(error);
            })
    }

    getData = (data) => {
        console.log('mydate', data);
        const newData = this.arrayholder.filter(function (item) {

            //applying filter for the inserted text in search bar
            return item.added_on.substring(0, item.added_on.length - 9) >= data.date && item.added_on.substring(0, item.added_on.length - 9) <= data.date_End

        });
        this.setState({
            //setting the filtered newData on datasource
            //After setting the data it will automatically re-render the view
            dataSource: newData,
            //search: date,
        });
    }
    handleLoadMore = async () => {
        console.log('load more handled');
        if (this.state.isFirstTime) {
            this.setState({
                currentPage: this.state.currentPage + 1
            })
            this.mdNewQueriesReports();
        }

    }
    render() {


        return (


            <View style={{ flex: 1 }}>

                <NavigationEvents onDidFocus={this.mdNewQueriesReports} onWillFocus={() => this.setState({ isLoading: false, currentPage: 1 })} />

                <ProgressLoader
                    visible={this.state.isLoading}
                    isModal={true} isHUD={true}
                    hudColor={"#00A637"}
                    style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
                    color={"#FFFFFF"} />

                <View style={{ backgroundColor: '#fff' }}>
                    <DateFilter getData={this.getData} ResetData={this.ResetData} />
                </View>

                <View style={{ flex: 1, backgroundColor: '#fff' }}>
                    {this.state.dataSource.length === 0 ? <View style={mainstyles.norecordFound}>
                        <Text style={mainstyles.norecordFound_Text}>No Query found here</Text>
                    </View> : null}

                    <FlatList
                        data={this.state.dataSource}
                        keyExtractor={(item) => item.id}
                        ItemSeparatorComponent={this.FlatListItemSeparator}
                        initialNumToRender={this.state.per_page}   // how many item to display first
                        onEndReachedThreshold={0.5}
                        onEndReached={() => this.callOnScrollEnd = true}
                        onMomentumScrollEnd={() => {
                            this.callOnScrollEnd && this.handleLoadMore()
                            this.callOnScrollEnd = false
                        }}
                        bounces={false}
                        extraData={this.state}
                        renderItem={({ item }) => (
                            <PopoverContainer >
                                <View style={{ flex: 1 }}>
                                    <StatusBar barStyle="dark-content" backgroundColor="#0ea457" />
                                    <View style={{ flex: 1, flexDirection: 'column', alignItems: 'center' }}>
                                        <View style={{ flexDirection: 'row', backgroundColor: '#FFFFFF' }}>
                                            {item.enduser_image == null ? <Image source={require('../../imgs/no_image.jpg')}
                                                style={{ alignSelf: 'center', width: 50, height: 50, borderRadius: 150 / 2, marginLeft: 15 }} /> : <Image source={{ uri: Constants.APIURL + 'assets/uploads/users/' + item.enduser_image }} style={{ alignSelf: 'center', width: 50, height: 50, borderRadius: 150 / 2, marginLeft: 15 }} />}
                                            <View style={mainstyles.right_container}>
                                                <Text style={mainstyles.query}>{item.query}  </Text>
                                                <Text style={mainstyles.category_ask}>Category: {item.category_name} </Text>
                                                <Text style={mainstyles.category_ask}>Ask: {item.added_on} </Text>
                                                <Text style={mainstyles.category_ask} >Asked By: {item.name} </Text>
                                                <View style={{ flexDirection: 'row', flexWrap: 'wrap', paddingBottom: 10, alignContent: 'center', marginLeft: 10 }}>
                                                    <Text style={{ fontSize: 14, color: '#000', marginTop: 2 }}>Status:</Text> 
                                                    <Text style={{ fontSize: 14, color: (item.status == 2) ? 'red' : ((item.status == 1) ? '#008000' : '#FAC564'), marginTop: 2, marginLeft: 5 }}>{(item.status == 2) ? 'Rejected' : ((item.status == 1) ? 'Completed' : 'Pending')}</Text>
                                                </View>
                                            </View>


                                        </View>
                                    </View>
                                </View>
                            </PopoverContainer>

                        )}


                    />

                </View>





            </View>

        )

    }
}

