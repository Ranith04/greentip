import React, { Component } from 'react';
import {
    StyleSheet,
    Text,
    View,
    TextInput,
    Button,
    TouchableOpacity,
    TouchableHighlight,
    Image,
    ImageBackground,
    Alert,
    Icon,
    StatusBar,
    ScrollView,
    tintColor,
    BackHandler,
    FlatList, ActivityIndicator
} from 'react-native';
import styles_ from './styles'
import Toast from 'react-native-simple-toast';
import { Popover, PopoverContainer } from 'react-native-simple-popover';
import Modal from 'react-native-modal';
import ProgressLoader from 'rn-progress-loader';
import AsyncStorage from '@react-native-community/async-storage';
import { NavigationEvents } from "react-navigation";
import Spinner from 'react-native-loading-spinner-overlay';
import Constants from '../Constants';
import DocumentPicker from 'react-native-document-picker';
import mainstyles from '../Component/mainstyles';
const RNFS = require('react-native-fs');
export default class RespondByExpert extends Component {
    static navigationOptions = ({ navigation }) => {
        return {
            title: 'Respond By Expert',
            headerStyle: {
                backgroundColor: '#0ea457',
            },
            headerTintColor: '#FFFFFF',
            headerTitleAlign: 'center',

            headerTitleStyle: {
                fontSize: 20,

            },

        }
    }

    constructor(props) {
        super(props);
        this.handleBackButtonClick = this.handleBackButtonClick.bind(this);
        this.state = {
            isVisible: false, //state of modal default false
            isPopoverVisible: 0,
            showPop: false,
            popoverPlacement: 'left',
            isModalVisible: false,
            isLoading: false,
            spinner: true,
            imgPath: '',
            query_item: '',
            enduser_i: '',
            id: '',
            DiscardReason: '',
            Respond_message: '',
            file_name: '',
            real_Path: '',
            real_Path_uri: '',
            real_Path_name: '',
            real_Path_type: ''

        }

    }


    componentWillMount() {
        BackHandler.addEventListener('hardwareBackPress', this.handleBackButtonClick);

    }

    componentWillUnmount() {
        BackHandler.removeEventListener('hardwareBackPress', this.handleBackButtonClick);
    }

    handleBackButtonClick() {
        console.log("hello_props", this.props);
        this.props.navigation.goBack(null);
        // BackHandler.exitApp();
        return true;
    }



    validate_field = () => {
        const { Respond_message } = this.state;

        if (Respond_message == "") {
            alert("Enter Respond Message")
            return false
        }
        return true
    }

    Respond = async () => {
        if (this.validate_field()) {
            this.setState({ isLoading: true });
            const { navigation } = this.props;
            const query_id = navigation.getParam('query_id');
            const user_id = await AsyncStorage.getItem('id')
            const {  real_Path_uri, real_Path_name, real_Path_type} = this.state;
            var photo = {
                uri: real_Path_uri,
                type: real_Path_type,
                name: real_Path_name
            };
            var params = {
                'assign_query_id': query_id,
                'user_id': user_id,
                'answer': this.state.Respond_message,
            };
            var formData = new FormData();

            for (var k in params) {
                formData.append(k, params[k]);
            }
            if (photo.uri != '' && photo.type != '' && photo.name != '') {
                formData.append('attachment_file', photo);
            }

           // console.log('params', JSON.stringify(formData)); return;
           
            fetch(Constants.FullURL+'/users/respond_by_expert', {
                method: 'POST',
                headers: {
                    'Content-Type': 'multipart/form-data'
                },
                body: formData,
            }).then((response) => response.json())

                .then((responseJson) => {
                    console.log(responseJson)
                    if (responseJson.status === true) {
                        const type = responseJson.data;
                        // Alert.alert(responseJson.message);
                     //   Toast.show(responseJson.message, Toast.SHORT);
                        setTimeout(() => {
                            Toast.show(responseJson.message, Toast.SHORT);
                        }, 500);


                        this.setState(
                            {
                                isLoading: false,

                            },
                            function () {
                                // this.arrayholder = type.queries;
                            }
                        );
                        const { navigation } = this.props;
                        const All_Query = navigation.getParam('All_Query');
                        const Unanswered = navigation.getParam('Unanswered');

                        if (All_Query == 'All_Query') {
                            this.props.navigation.navigate('All_Query');

                        } else if (Unanswered == 'Unanswered') {
                            this.props.navigation.navigate('Unanswered_Query');

                        }


                    } else if (responseJson.status === false) {
                        Alert.alert('Error', responseJson.message);
                        this.setState({ isLoading: false });

                    }
                })
                .catch(error => {
                    this.setState({ isLoading: false });
                })
        }
    }

    Fle_Picker = async () => {
        try {
            const res = await DocumentPicker.pick({
                type: [DocumentPicker.types.images, DocumentPicker.types.pdf, DocumentPicker.types.zip, DocumentPicker.types.allFiles],
            });
            const split = res.uri.split('/');
            const name = split.pop();
            const inbox = split.pop();
            const realPath = `${RNFS.TemporaryDirectoryPath}${inbox}/${name}`;
            this.setState({
                file_name: res.name,
                real_Path_uri: res.uri,
                real_Path_name: res.name,
                real_Path_type: res.type,
            });
            // console.log('uri', res.uri)
            // console.log('type', res.type)
            // console.log('name', res.name)
            // console.log('size', res.size)
        } catch (err) {
            if (DocumentPicker.isCancel(err)) {
                // User cancelled the picker, exit any dialogs or menus and move on
            } else {
                throw err;
            }
        }
    }
    render() {
        // if (this.state.isLoading) {
        //     return (
        //         <View style={styles_.stylesIndi_container_all}>
        //             <ActivityIndicator
        //                 visible={this.state.isLoading}
        //                 size="large"
        //                 color='#0ea457'
        //                 style={styles_.stylesIndi_activityIndicator_all} />
        //         </View>
        //     );
        // }
        const { navigation } = this.props;
        const query = navigation.getParam('query');
        const category_name = navigation.getParam('category_name');
        const added_on = navigation.getParam('added_on');
        const enduser_image = navigation.getParam('enduser_image');
        const imgPath = navigation.getParam('imgPath');
        const query_id = navigation.getParam('query_id');
        const item = navigation.getParam('item');
        console.log('imagepath',imgPath)
        console.log('enduser_image',enduser_image)
        return (


            <View style={styles_.View_Main_Respond}>
                <ProgressLoader
                    visible={this.state.isLoading}
                    isModal={true} isHUD={true}
                    hudColor={"#00A637"}
                    style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
                    color={"#FFFFFF"} />

                <ScrollView
                    contentContainerStyle={styles_.View_v1_Respond}
                    style={styles_.View_v2_Respond}
                >
                    <View style={styles_.View_v6_all}>



                        <View style={styles_.container_all}>

                            <View style={styles_.View_v1_all}>
                            {enduser_image == null ? <Image source={require('../imgs/no_image.jpg')}
                              style={styles_.im_all_v} /> : <Image source={{ uri: imgPath + enduser_image }} style={styles_.im_all_v} />}
                                
                                <View style={styles_.View_v8_all}>
                                    <Text style={styles_.tv_1_all}>{query}  </Text>
                                    <Text style={styles_.tv_2_cat_all}>Category: {category_name} </Text>
                                    <Text style={styles_.tv_3_add_all}>Ask: {added_on} </Text>
                                    {/* <Text style={styles_.tv_3_add_all}>Asked By: {item.name} </Text> */}

                                </View>


                            </View>
                            <View   style={{width:'100%'}}>
                            <Text style={mainstyles.respond_label}>Message *</Text>
                            <TextInput
                              style={[mainstyles.contatus_input,{height:300,textAlignVertical:'top'}]}
                                // Adding hint in TextInput using Placeholder option.
                                placeholder="Message"
                                returnKeyType="done"
                               // blurOnSubmit={true}
                                // Making the Under line Transparent.
                                placeholderTextColor='#000'
                                underlineColorAndroid="transparent"
                                paddingLeft={10}
                                fontSize={15}
                                numberOfLines={10}
                                multiline={true}
                                blurOnSubmit={true}
                                onChangeText={Respond_message => this.setState({ Respond_message })}
                            />
                            </View>
                            <View style={{
                              
                                    width:'100%'
                                }}>
                               <Text style={mainstyles.respond_attachment}>Attachment </Text>
                                <TouchableHighlight underlayColor="#ffffff00" onPress={() => {
                                this.Fle_Picker();
                            }} >
                                <View style={{
                                    flexDirection: 'row', borderRadius: 1,
                                    borderStyle: 'dashed',
                                    borderWidth: 1,
                                    borderColor: '#62D5A8',
                                    alignItems: 'center',
                                    width:'100%',
                                    marginTop:8
                                }}>
                                    <TextInput style={{ fontSize: 15, padding: 10, width: '90%', color: 'black' }
                                    }
                                        underlineColorAndroid="transparent"
                                        placeholder={'Choose File'}
                                        editable={false}
                                        placeholderTextColor='#000'
                                    >{this.state.file_name}
                                    </TextInput>

                                    <View style={{ width: '10%', paddingLeft: 10, position: 'absolute', right: 10, alignSelf: 'flex-end', padding: Platform.OS == 'ios' ? 5 : 10 }}>

                                        <Image source={require('../imgs/upload_docc.png')} style={{ width: 30, height: 30 }} />

                                    </View>
                                </View>
                            </TouchableHighlight>
                            </View>
                          

                        </View>


                    </View>
                </ScrollView>
                <View style={styles_.View_v3_Respond}>
                    <TouchableOpacity
                        onPress={() => this.Respond()}

                        style={styles_.View_v4_Respond}
                    >
                        <Text style={styles_.View_v5_Respond}>Submit</Text>
                    </TouchableOpacity>
                </View>

            </View>

        )

    }
}
