                                                            {item.status == 2 ? <Text style={{ color: 'white', fontSize: 14, color: 'red', marginLeft: 5, marginTop: 2 }}>Rejected</Text> : item.status == 1 ? <Text style={{ color: 'white', fontSize: 14, color: '#008000', marginLeft: 5, marginTop: 2 }}>Completed</Text> : item.status == 0 ? <Text style={{ color: 'white', fontSize: 14, color: '#d6c400', marginLeft: 5, marginTop: 2 }}>Pending</Text> : null}
                                                        </View>
                                                    </View>
                                                    <Image source={require('../../imgs/forwardArr.png')} style={{ alignSelf: 'center', borderRadius: 150 / 2, marginRight: 5 }} />

