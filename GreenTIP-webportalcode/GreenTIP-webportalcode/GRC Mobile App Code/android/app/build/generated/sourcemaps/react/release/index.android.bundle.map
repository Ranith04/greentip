import React, { Component } from 'react';
import {
  StyleSheet,
  Text,
  View,
  ScrollView,
  TextInput,
  Button,
  TouchableOpacity,
  TouchableHighlight,
  Image,
  ImageBackground,
  Alert,
  StatusBar,
  Modal,
  SafeAreaView,
  ActivityIndicator
} from 'react-native';
import AsyncStorage from '@react-native-community/async-storage';
import { DrawerActions } from 'react-navigation-drawer';
import { BackHandler } from 'react-native';
import { NavigationEvents } from "react-navigation";
import Spinner from 'react-native-loading-spinner-overlay';
import Icon from 'react-native-vector-icons/FontAwesome';
import ProgressLoader from 'rn-progress-loader';
import bgSrc from '../imgs/no_image.jpg';
import Constants from '../Constants';
import mainstyles from '../Component/mainstyles';
export default class Profile extends Component {
  // Public;
  static navigationOptions = ({ navigation }) => {
    const { params = {} } = navigation.state;
    if (params.handleSave === 'ProfileExpert') {
      return {
        title: 'Expert Profile',
        headerStyle: {
          backgroundColor: '#0ea457',
        },
        headerTintColor: '#FFFFFF',
        headerTitleAlign: 'center',
        headerTitleStyle: {
          fontSize: 20,
        },
      };
    } else if (params.ProfileTagEndUser === 'ProfileTagEndUser') {
      return {

        title: 'End User Profile',
        headerStyle: {
          backgroundColor: '#0ea457',
        },
        headerTintColor: '#FFFFFF',
        headerTitleAlign: 'center',
        headerTitleStyle: {
          fontSize: 20,
        },

      };
    }
    else {
      return {

        title: 'Profile',
        headerStyle: {
          backgroundColor: '#0ea457',
        },
        headerTintColor: '#FFFFFF',
        headerTitleAlign: 'center',
        headerTitleStyle: {
          fontSize: 20,
        },

      };
    }

  };
  constructor(props) {
    super(props);
    this.handleBackButtonClick = this.handleBackButtonClick.bind(this);
    let imgUrl = require("../imgs/no_image.jpg");
    this.state = { image_1: imgUrl };
    this.state = {
      isLoading: false,
      name: '',
      email: '',
      image: '',
      imageexpert: '',
      contact_no: '',
      company_name: '',
      occupation: '',
      education_qualification: '',
      expertise_field: '',
      visible: false,
      isVisible: false,
      ProfileTag: '',
      name_ProfileTag: '',
      email_ProfileTag: '',
      contact_no_ProfileTag: '',
      company_name_ProfileTag: '',
      education_qualification_ProfileTag: '',
      expertise_field_ProfileTag: '',
      occupation_ProfileTag: '',
      ProfileTagEndUser: '',
      status_ProfileTag: '',
      created_on_ProfileTag: '',
      Expert_Profile: '',
      End_User_: '',
      md_Profie_: '',
      role_type: '',
      description: '',
      address: '',
      company_location: '',
      state: '',
      district: '',
      pin: '',
    }
  }
  componentWillMount() {
    console.log('componentWillMount');
    BackHandler.addEventListener('hardwareBackPress', this.handleBackButtonClick);
    const { navigation } = this.props;
    this.setState({ ProfileTag: navigation.getParam('ProfileTag') })
    this.setState({ name_ProfileTag: navigation.getParam('name') })
    this.setState({ email_ProfileTag: navigation.getParam('email') })
    this.setState({ contact_no_ProfileTag: navigation.getParam('contact_no') })
    this.setState({ company_name_ProfileTag: navigation.getParam('company_name') })
    this.setState({ education_qualification_ProfileTag: navigation.getParam('education_qualification') })
    this.setState({ expertise_field_ProfileTag: navigation.getParam('expertise_field') })
    this.setState({ occupation_ProfileTag: navigation.getParam('occupation') })
    this.setState({ status_ProfileTag: navigation.getParam('status') })
    this.setState({ created_on_ProfileTag: navigation.getParam('created_on') })
    this.setState({ ProfileTagEndUser: navigation.getParam('ProfileTagEndUser') })
    this.setState({ Expert_Profile: navigation.getParam('Expert_Profile') })
    this.setState({ End_User_: navigation.getParam('End_User_') })
    this.setState({ md_Profie_: navigation.getParam('md_Profie_') })
    this.setState({ description: navigation.getParam('description') })
    this.setState({ company_location: navigation.getParam('company_location') })
    this.setState({ state: navigation.getParam('state') })
    this.setState({ district: navigation.getParam('district') })
    this.setState({ pin: navigation.getParam('pin') })

    // http://grcgreentip.com/assets/uploads/users/

    var im = navigation.getParam('image');
    // this.state = { image: imgUrl };
    // console.log(im)
    if (im === null) {
      this.setState({ imageexpert: Constants.APIURL + 'assets/grocery_crud/themes/bootstrap/img/a0.jpg' })
      console.log('und', this.state.image_1)

    } else {
      this.setState({ imageexpert: Constants.APIURL + 'assets/uploads/users/' + im })

    }


    if (this.state.ProfileTag =='ProfileExpert') {

    }
    else if (this.state.ProfileTagEndUser == 'ProfileTagEndUser') {

    }
    else {
     
     // this.Profile();
    }
  }
  componentDidMount() {
    console.log('componentDidMount');
    if (this.state.ProfileTag == 'ProfileExpert') {
      this.props.navigation.setParams({ handleSave: this.state.ProfileTag });
    }
    else if (this.state.ProfileTagEndUser =='ProfileTagEndUser') {
      this.props.navigation.setParams({ ProfileTagEndUser: this.state.ProfileTagEndUser });
    }
    else {
      this.Profile();
    }



  }

  componentWillUnmount() {
    BackHandler.removeEventListener('hardwareBackPress', this.handleBackButtonClick);
  }

  handleBackButtonClick() {
    console.log("hello_props", this.props);
    this.props.navigation.goBack(null);
    // BackHandler.exitApp();
    return true;
  }
  Profile = async () => {
    this.setState({ isLoading: true });
    var res = await Constants.isNetworkAvailable();
      if (!res) {
        return false;
      }

    const userIdnewww = await AsyncStorage.getItem('id')
    var params = {
      'user_id': userIdnewww
    };
    console.log('params', params)
    var formData = new FormData();

    for (var k in params) {
      formData.append(k, params[k]);
    }

    fetch(Constants.FullURL + '/users/getUserProfile', {
      method: 'POST',
      headers: {
        'authorisation': this.authorisationToken
      },
      body: formData,
    }).then((response) => response.json())

      .then((responseJson) => {
        console.log(responseJson)
        if (responseJson.status === true) {
          const type = responseJson.data;
           AsyncStorage.setItem('userimage', type.image);
     AsyncStorage.setItem('userName', type.name);
     AsyncStorage.setItem('contact_no', type.contact_no);

          this.setState(
            {
              isLoading: false,
              name: type.name,
              email: type.email,
              image: (type.image!='')?type.image:Constants.APIURL + 'assets/grocery_crud/themes/bootstrap/img/a0.jpg',
              contact_no: type.contact_no,
              company_name: type.company_name,
              occupation: type.occupation,
              education_qualification: type.education_qualification,
              expertise_field: type.expertise_field,
              role_type: type.role_type,
              address: type.address,
              company_location: type.company_location,
              state: type.state,
              district: type.district,
              pin: type.pin,




              //   total_inbox:type.total
            },
            function () {
              // this.arrayholder = type.queries;
            }
          );
          //Alert.alert(responseJson.message);

        } else if (responseJson.status === false) {
          Alert.alert('Error', responseJson.message);
          this.setState({ isLoading: false });
        }
      })
      .catch(error => {
        this.setState({ isLoading: false });
        //console.log(error);
      })

  }
  render() {

    // if (this.state.isLoading) {
    //   return (
    //     <View style={stylesIndi.container}>
    //       <ActivityIndicator
    //         visible={this.state.isLoading}
    //         size="large"
    //         color='#0ea457'
    //         style={stylesIndi.activityIndicator} />
    //     </View>
    //   );
    // }
    return (
      <ScrollView contentContainerStyle={{ flexGrow: 1 }}>
        <View style={{ flex: 1, flexDirection: 'column', backgroundColor: '#FFFFFF' }}>
          <ProgressLoader
            visible={this.state.isLoading}
            isModal={true} isHUD={true}
            hudColor={"#00A637"}
            style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
            color={"#FFFFFF"} />
          {(this.state.ProfileTag != 'ProfileExpert' && this.state.ProfileTagEndUser !='ProfileTagEndUser') ? <NavigationEvents
            onDidFocus={this.Profile}
            onWillFocus={() => this.setState({ isLoading: false })}

          />:null}
          <StatusBar barStyle="dark-content" backgroundColor="#0ea457" />

          {/* <Image source={{ uri: this.state.image }}
                  style={{
                    width: 80, height: 80, borderRadius: 150 / 2, marginLeft: 5, marginTop: 10
                  }} /> */}

          <View style={{ flexDirection: 'row', padding: 10 }}>

            {this.state.ProfileTag == 'ProfileExpert' ? <Image source={{ uri: this.state.imageexpert }}
              style={{
                width: 80, height: 80, borderRadius: 150 / 2, marginLeft: 5, marginTop: 10
              }} /> : this.state.ProfileTagEndUser == 'ProfileTagEndUser' ? <Image source={{ uri: this.state.imageexpert }}
                style={{
                  width: 80, height: 80, borderRadius: 150 / 2, marginLeft: 5, marginTop: 10
                }} /> : <Image source={{ uri: this.state.image }}
                  style={{
                    width: 80, height: 80, borderRadius: 150 / 2, marginLeft: 5, marginTop: 10
                  }} />}




            <View style={{ flex: 1, flexDirection: 'column', height: '100%' }}>
              {this.state.ProfileTag == 'ProfileExpert' ? <Text style={{ color: '#444', fontWeight: 'bold', padding: 5, fontSize: 18, color: '#3C3C3C', marginLeft: 10, marginRight: 5, marginTop: 30, alignContent: 'center' }}>{this.state.name_ProfileTag}</Text>
                : this.state.ProfileTagEndUser == 'ProfileTagEndUser' ? <Text style={{ color: '#444', fontWeight: 'bold', padding: 5, fontSize: 18, color: '#3C3C3C', marginLeft: 10, marginRight: 5, marginTop: 30, alignContent: 'center' }}>{this.state.name_ProfileTag}</Text> : <Text style={{ color: '#444', fontWeight: 'bold', padding: 5, fontSize: 18, color: '#3C3C3C', marginLeft: 10, marginRight: 5, marginTop: 30, alignContent: 'center' }}>{this.state.name}</Text>}
              {this.state.ProfileTag != 'ProfileExpert' && this.state.ProfileTagEndUser != 'ProfileTagEndUser' && this.state.Expert_Profile != 'Expert_Profile' && this.state.End_User_ != 'End_User_' && this.state.md_Profie_ != 'md_Profie_' ? <Text style={{ fontSize: 14, color: '#ACABAB', marginLeft: 10 }}> Admin </Text> : null}
            </View>
            {this.state.ProfileTag != 'ProfileExpert' && this.state.ProfileTagEndUser != 'ProfileTagEndUser' ? <TouchableOpacity
              onPress={() => this.props.navigation.navigate('EditProfile', { 'mobile': this.state.contact_no, 'email_save': this.state.email, 'companyname': this.state.company_name, 'Qualification': this.state.education_qualification, 'Expertise': this.state.expertise_field, 'Occupation': this.state.occupation, 'image': this.state.image, 'name': this.state.name, 'role_type': this.state.role_type, 'address': this.state.address, 'company_location': this.state.company_location, 'state': this.state.state, 'district': this.state.district, 'pin': this.state.pin, }, this.props)}>
              <Image source={require('../imgs/edit_icon.png')} />
            </TouchableOpacity> : null}
          </View>
          {this.state.ProfileTag != 'ProfileExpert' ? <View style={{ flexDirection: 'row', alignItems: 'center', marginTop: 15, margin: 5 }}>
            <Image source={require('../imgs/mobile_icon.png')} style={styles.sideMenuIcon} />

            {/* this.state.ProfileTag == 'ProfileExpert' ? <Text style={styles.menuText} >{this.state.contact_no_ProfileTag} </Text> */}
            {this.state.ProfileTag == 'ProfileExpert' ? <Text style={styles.menuText} >{this.state.contact_no_ProfileTag} </Text>
              : this.state.ProfileTagEndUser == 'ProfileTagEndUser' ? <Text style={styles.menuText} >{this.state.contact_no_ProfileTag} </Text> : <Text style={styles.menuText} >{this.state.contact_no} </Text>}
          </View> : null}
          <View style={{ flexDirection: 'row', alignItems: 'center', marginTop: 15, margin: 5 }}>
            <Image source={require('../imgs/mail_icon.png')} style={styles.sideMenuIcon} />
            {this.state.ProfileTag == 'ProfileExpert' ? <Text style={styles.menuText} >{this.state.email_ProfileTag}</Text>
              : this.state.ProfileTagEndUser == 'ProfileTagEndUser' ? <Text style={styles.menuText} >{this.state.email_ProfileTag}</Text> : <Text style={styles.menuText} >{this.state.email}</Text>}
          </View>
          <View style={{ margin: 5, marginLeft: 15, marginTop: 20 }}>
            <Text style={mainstyles.profile_label} >Company Name</Text>

          </View>
          <View style={{ margin: 5, marginLeft: 15 }}>
            {this.state.ProfileTag == 'ProfileExpert' ? <Text style={styles.menuText} >{this.state.company_name_ProfileTag}</Text>
              : this.state.ProfileTagEndUser == 'ProfileTagEndUser' ? <Text style={styles.menuText} >{this.state.company_name_ProfileTag}</Text> : <Text style={styles.menuText} >{this.state.company_name}</Text>}
          </View>

          <View style={{ margin: 5, marginLeft: 15, marginTop: 15 }}>

            <Text style={mainstyles.profile_label} >Education Qualification</Text>
          </View>
          <View style={{ margin: 5, marginLeft: 15 }}>
            {this.state.ProfileTag == 'ProfileExpert' ? <Text style={styles.menuText} >{this.state.education_qualification_ProfileTag}</Text>
              : this.state.ProfileTagEndUser == 'ProfileTagEndUser' ? <Text style={styles.menuText} >{this.state.education_qualification_ProfileTag}</Text> : <Text style={styles.menuText} >{this.state.education_qualification}</Text>}
          </View>
          <View style={{ margin: 5, marginLeft: 15, marginTop: 15 }}>

            <Text style={mainstyles.profile_label} >Area Of Expertise Fields</Text>
          </View>
          <View style={{ margin: 5, marginLeft: 15 }}>

            {this.state.ProfileTag == 'ProfileExpert' ? <Text style={styles.menuText} >{this.state.expertise_field_ProfileTag}</Text>
              : this.state.ProfileTagEndUser == 'ProfileTagEndUser' ? <Text style={styles.menuText} >{this.state.expertise_field_ProfileTag}</Text> : <Text style={styles.menuText} >{this.state.expertise_field}</Text>}


          </View>




          {this.state.ProfileTag == 'ProfileExpert' ? <View style={{ margin: 5, marginLeft: 15, marginTop: 15 }}>

            <Text style={mainstyles.profile_label}>Added On</Text>
          </View> : this.state.ProfileTagEndUser == 'ProfileTagEndUser' ? <View style={{ margin: 5, marginLeft: 15, marginTop: 15 }}>

            <Text style={mainstyles.profile_label} >Added On</Text>
          </View> : null}
          <View style={{ margin: 5, marginLeft: 15 }}>

            {this.state.ProfileTag == 'ProfileExpert' ? <Text style={styles.menuText} >{this.state.created_on_ProfileTag}</Text>
              : this.state.ProfileTagEndUser == 'ProfileTagEndUser' ? <Text style={styles.menuText} >{this.state.created_on_ProfileTag}</Text> : null}


          </View>
          <View style={{ margin: 5, marginLeft: 15, marginTop: 15 }}>

            <Text style={mainstyles.profile_label}>Occupation</Text>
          </View>
          <View style={{ margin: 5, marginLeft: 15 }}>

            {this.state.ProfileTag == 'ProfileExpert' ? <Text style={styles.menuText} >{this.state.occupation_ProfileTag}</Text>
              : this.state.ProfileTagEndUser == 'ProfileTagEndUser' ? <Text style={styles.menuText} >{this.state.occupation_ProfileTag}</Text> : <Text style={styles.menuText} >{this.state.occupation}</Text>}
          </View>

          {/* {this.state.ProfileTag == 'ProfileExpert' ? <View style={{ margin: 5, marginLeft: 15, marginTop: 15 }}>

            <Text style={{
              fontSize: 16,
              color: '#BCBBBB',
              marginLeft: 5,
            }} >Description</Text>
          </View> : null}
          {this.state.ProfileTag == 'ProfileExpert' ? <View style={{ margin: 5, marginLeft: 15 }}>

            <Text style={styles.menuText} >{this.state.description}</Text>


          </View> : null} */}


          <View style={{ margin: 5, marginLeft: 15, marginTop: 15 }}>

            <Text style={mainstyles.profile_label}>Address</Text>
          </View>
          <View style={{ margin: 5, marginLeft: 15 }}>

            <Text style={styles.menuText} >{this.state.address}</Text>


          </View>

          <View style={{ margin: 5, marginLeft: 15, marginTop: 15 }}>

            <Text style={mainstyles.profile_label}>Company Location</Text>
          </View>
          <View style={{ margin: 5, marginLeft: 15 }}>

            <Text style={styles.menuText} >{this.state.company_location}</Text>


          </View>

          <View style={{ margin: 5, marginLeft: 15, marginTop: 15 }}>

            <Text style={mainstyles.profile_label}>State</Text>
          </View>
          <View style={{ margin: 5, marginLeft: 15 }}>

            <Text style={styles.menuText} >{this.state.state}</Text>


          </View>
          <View style={{ margin: 5, marginLeft: 15, marginTop: 15 }}>

            <Text style={mainstyles.profile_label}>District</Text>
          </View>
          <View style={{ margin: 5, marginLeft: 15 }}>

            <Text style={styles.menuText} >{this.state.district}</Text>


          </View>
          <View style={{ margin: 5, marginLeft: 15, marginTop: 15 }}>

            <Text style={mainstyles.profile_label}>Pin</Text>
          </View>
          <View style={{ margin: 5, marginLeft: 15 }}>

            <Text style={styles.menuText} >{this.state.pin}</Text>


          </View>


          {this.state.ProfileTag == 'ProfileExpert' ?
            <View style={{ margin: 5, marginLeft: 15, marginTop: 15 }}>

              <Text style={mainstyles.profile_label} >Status</Text>
            </View> : this.state.ProfileTagEndUser == 'ProfileTagEndUser' ? <View style={{ margin: 5, marginLeft: 15, marginTop: 15 }}>

              <Text style={mainstyles.profile_label} >Status</Text>
            </View> : null}
          {this.state.ProfileTag == 'ProfileExpert' ? <View style={{ margin: 5, marginLeft: 15 }}>
            {this.state.status_ProfileTag == 2 ? <Text style={styles.status_block}>Rejected</Text> : this.state.status_ProfileTag == 1 ? <Text style={styles.status_active}>Completed</Text> : this.state.status_ProfileTag == 0 ? <Text style={styles.status_pending}>Pending</Text> : null}

          </View> : this.state.ProfileTagEndUser == 'ProfileTagEndUser' ? <View style={{ margin: 5, marginLeft: 15 }}>
            {this.state.status_ProfileTag == 2 ? <Text style={styles.status_block}>Rejected</Text> : this.state.status_ProfileTag == 1 ? <Text style={styles.status_active}>Completed</Text> : this.state.status_ProfileTag == 0 ? <Text style={styles.status_pending}>Pending</Text> : null}
          </View> : null}

        </View>

      </ScrollView>
    )
  }
}


