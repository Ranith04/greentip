import React, { createRef, Component } from "react";
import styles from "./dateFilterStyles";
import {
  View,
  Text,
  Image,
  FlatList,
  TouchableWithoutFeedback,
  TouchableOpacity,
  AsyncStorage,
  TextInput,
  TouchableHighlight,
  Animated,
  Keyboard,
  Dimensions,
  UIManager,
  Share,
  Modal,
  ImageBackground,
  SafeAreaView,
  ScrollView,
  Linking,
  Alert
} from "react-native";
import Constants from '../Constants';
import Icon from 'react-native-vector-icons/FontAwesome';
import mainstyles from './mainstyles';
;
import HTML from 'react-native-render-html';
export default class RenderHtml extends Component {


  constructor(props) {
    super(props);

    this.state = {
      items: '',
      expertAnswerData: '',
      roleId:'',
      isLoading:false,
      isAnswerDeleted:true
    };

  }



  async componentDidMount() {
    await this.setState({ items: (typeof this.props.itemData != 'undefined') ? this.props.itemData : '' })
    await this.setState({ expertAnswerData: (typeof this.props.expertAnswerData != 'undefined') ? this.props.expertAnswerData : '' });
    var roleId = await AsyncStorage.getItem('role_type');
    await this.setState({ roleId: roleId});


  }

 


  render() {
   console.log('this.props.htmlText',this.props.htmlText)
    return (
      <View style={mainstyles.renderhtml} >
	  
                <HTML html={this.props.htmlText}  />
       
      </View>
    );
  }
}
