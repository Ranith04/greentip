import { StyleSheet } from 'react-native';

export default StyleSheet.create({
    MainContainer: {
        flex: 1
    },

    /********* View Inside ImageBackground *********/
    backgroundImg: {
        width: '100%', 
        height: 250
    },
    header: {
        flexDirection: "row",
    },
    menuIcon: { 
        marginLeft: 20 ,
        marginTop:20
    },
    inboxContainer: {
        position:'absolute',
        right:10,
        alignSelf:'flex-end',
        top:1
    },
    inboxImg: {
        marginRight: 10,
        marginTop:15
    },
    badgeContainer: {
        position:'absolute',
        right:10,
        alignSelf:'flex-end',
        borderRadius:15,
        backgroundColor:'red',
        width:18,
        height:18
    },
    badgeCount: {
        color:'#FFFFFF',
        fontSize:12,
        textAlign:'center',
        fontWeight: 'bold'
    },
    imgContainer: {
        alignItems: 'center',
        margin: 4,
        paddingTop: ( Platform.OS === 'ios' ) ? 20 : 0
    },
    userimg: {
        width: 90,
        height: 90,
        borderRadius: 150/2,
        marginTop:5
    },
    wlcmTxt: {
        alignSelf: 'center',
        margin: 0,
        color:'#FFFFFF',
        fontSize:16,
        marginTop:2
    },
    username: {
        color:'#FFFFFF',
        fontSize:20,
        fontWeight:'bold',
        marginTop:0,
        alignSelf: 'center',
        textTransform: 'capitalize'
    },
    /********* End *********/

    /********* Card Container *********/
    cardContainer: {
        height: '100%',
       marginTop: Platform.OS == 'ios' ? '-10%' : '-16%'    },
    customCard: {
        flexDirection: 'column',
        elevation: 5,
        padding: 10,
        margin: 2,
        marginLeft: 15,
        marginTop:8,
        borderBottomWidth:4,
        marginRight: 15,
        backgroundColor: '#FFFFFF'
    },
    cardContent: {
        flexDirection:'row'
    },
    newQuery: {
        borderBottomColor:'#69A0E2'
    },
    answered: {
        borderBottomColor: '#FF9D59'
    },
    unanswered: {
        borderBottomColor: '#AC3DEA',
    },
    cardImg: {
        borderRadius: 150/2,
        width: 75,
        height: 75
    },
    cardCount: {
        width: '75%',
        color:'#262C2F',
        fontSize:30,
        fontWeight:'600',
        textAlign:'right'
    },
    cardText: {
        fontSize:20,
        textAlign: 'right'
    },
    unansText: {
        color: '#AC3DEA'
    },
    ansText: {
        color: '#FF9D59'
    },
    newText: {
        color:'#69A0E2'
    }
    /********* End *********/
})