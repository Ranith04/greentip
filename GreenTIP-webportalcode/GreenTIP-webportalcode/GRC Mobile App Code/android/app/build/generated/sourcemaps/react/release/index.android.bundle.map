                                    padding={8}
                                    placeholderTextColor='#000'
                                    onChangeText={linkdin => this.setState({ linkdin })}

                                >
                                </TextInput>

                            </View>


                            <View>
                                <Text style={mainstyles.contatus_label}>Facebook URL</Text>
                                <TextInput style={mainstyles.contatus_input}
                                    placeholder={'Facebook URL'}
                                    padding={8}
                                    placeholderTextColor='#000'
                                    onChangeText={facebook => this.setState({ facebook })}

                                >

                                </TextInput>

                            </View>





                            <View>
                                <Text style={mainstyles.contatus_label}>Company Name</Text>
                                <TextInput style={mainstyles.contatus_input} placeholder={'Company Name'}
                                    placeholderTextColor='#000'
                                    padding={8}
                                    onChangeText={Company_Name => this.setState({ Company_Name })}



                                >

                                </TextInput>

                            </View>


                            <View>
                                <Text style={mainstyles.contatus_label}>Occupation</Text>
                                <TextInput style={mainstyles.contatus_input} placeholder={'Occupation'}
                                    placeholderTextColor='#000'
                                    padding={8}
                                    onChangeText={Occupation => this.setState({ Occupation })}


                                ></TextInput>

                            </View>

                            <View>
                                <Text style={mainstyles.contatus_label}>Education Qualification</Text>
                                <TextInput style={mainstyles.contatus_input} placeholder={'Education Qualification'}
                                    placeholderTextColor='#000'
                                    padding={8}
                                    onChangeText={Education => this.setState({ Education })}




                                ></TextInput>
                            </View>

                            <View>
                                <Text style={mainstyles.contatus_label}>Area Of Expertise Fields</Text>
                                <TextInput style={mainstyles.contatus_input} placeholder={'Area Of Expertise Fields'}
                                    placeholderTextColor='#000'
                                    padding={8}
                                    onChangeText={Expertise => this.setState({ Expertise })}

                                ></TextInput>

                            </View>
                            <View>
                                <Text style={mainstyles.contatus_label}>Company Location</Text>
                                <TextInput style={mainstyles.contatus_input} placeholder={'Company Location'} onChangeText={company_location => this.setState({ company_location })}
                                    value={this.state.company_location}
                                    padding={8}
                                    placeholderTextColor='#000'
                                ></TextInput>

                            </View>
                            <View>
                                <Text style={mainstyles.contatus_label}>State</Text>
                                <TextInput style={mainstyles.contatus_input} placeholder={'State'} onChangeText={state => this.setState({ state })}
                                    value={this.state.state}
                                    padding={8}
                                    placeholderTextColor='#000'
                                ></TextInput>

                            </View>
                            <View>
                                <Text style={mainstyles.contatus_label}>District</Text>
                                <TextInput style={mainstyles.contatus_input} placeholder={'District'} onChangeText={district => this.setState({ district })}
                                    value={this.state.district}
                                    padding={8}
