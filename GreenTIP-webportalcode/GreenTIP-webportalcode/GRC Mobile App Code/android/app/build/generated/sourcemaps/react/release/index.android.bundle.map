import Accordion from 'react-native-collapsible/Accordion';
import * as Animatable from 'react-native-animatable';
import ProgressLoader from 'rn-progress-loader';
import Constants from '../Constants';
export default class FAQ extends Component {


    static navigationOptions = {
        title: 'FAQs',
        headerStyle: {
            backgroundColor: '#0ea457',
        },
        headerTintColor: '#FFFFFF',
        headerTitleAlign: 'center',

        headerTitleStyle: {
            fontSize: 20,

        },

    };



    constructor(props) {
        super(props);
        this.handleBackButtonClick = this.handleBackButtonClick.bind(this);
        this.state = {
            activeSections: [],
            collapsed: true,
            multipleSelect: false,
            dataSource: [],
            isLoading: false,

        };


    }

    componentWillMount() {
        BackHandler.addEventListener('hardwareBackPress', this.handleBackButtonClick);

        this.FAQD();

    }

    FAQD = async() => {
        var res = await Constants.isNetworkAvailable();
      if (!res) {
        return false;
      }
        this.setState({ isLoading: false });

        fetch(Constants.FullURL+'/common/all_faqs', {
            method: 'GET',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },

        }).then((response) => response.json())
            .then((responseJson) => {
                console.log(responseJson)
                if (responseJson.status === true) {
                    const data = responseJson.data;
                    this.setState({
                        isLoading: false,
                        dataSource: data
                    });
                } else if (responseJson.status === false) {
                    Alert.alert('Error', responseJson.message);
                }
            })
            .catch(error => {
                this.setState({ loader: false });
               // console.log(error);
            })
    }

    componentWillUnmount() {
        BackHandler.removeEventListener('hardwareBackPress', this.handleBackButtonClick);
    }

    handleBackButtonClick() {
        console.log("hello_props", this.props);
        this.props.navigation.goBack(null);
        return true;
    }

    setSections = sections => {
        this.setState({
            activeSections: sections.includes(undefined) ? [] : sections,
        });
    };

    renderHeader = (section, _, isActive) => {
        return (
            <Animatable.View
                duration={400}
                style={[styles.header, isActive ? styles.active : styles.inactive]}
                transition="backgroundColor">
                <Text style={styles.headerText}>{section.question}</Text>

                <View style={{ alignSelf: 'center', position: 'absolute', top: 6, right: 2 }}>
                    <Image source={require('../imgs/down_arrow.png')} style={{}} />
                </View>
            </Animatable.View>
        );
    };
    renderContent(section, _, isActive) {
        //Accordion Content view
        return (
            <Animatable.View
                duration={400}
                style={[styles.content, isActive ? styles.active : styles.inactive]}
                transition="backgroundColor">
                <Animatable.Text
                    animation={isActive ? 'fadeIn' : undefined}
                    style={{ textAlign: 'justify', fontSize: 16, }}>
                    {section.answer}
                </Animatable.Text>
            </Animatable.View>
        );
    }




    render() {
        // if (this.state.isLoading) {
        //     return (
        //         <View style={stylesIndi.container}>
        //         <ActivityIndicator
        //           visible={this.state.isLoading}
        //           size="large"
        //           color='#0ea457'
        //           style={stylesIndi.activityIndicator} />
        //       </View>
        //     );
        //   }

        const { multipleSelect, activeSections } = this.state;
        return (

            <View style={{ backgroundColor: 'white', flex: 1 }} >

                <ProgressLoader
                    visible={this.state.isLoading}
                    isModal={true} isHUD={true}
                    hudColor={"#00A637"}
                    style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
                    color={"#FFFFFF"} />

                <StatusBar barStyle="dark-content" backgroundColor="#0ea457" />

                <Accordion
                    activeSections={activeSections}
                    sections={this.state.dataSource}
                    touchableComponent={TouchableOpacity}
                    expandMultiple={multipleSelect}
                    renderHeader={this.renderHeader}
                    renderContent={this.renderContent}
                    duration={400}
                    onChange={this.setSections}
                />


            </View>
        );
    }

}

