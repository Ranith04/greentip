                                                <TextInput style={{ fontSize: 15, padding: 10, color: 'black' }
                                                }
                                                    underlineColorAndroid="transparent"
                                                    editable={false}
                                                    placeholderTextColor='#000'
                                                    placeholder={'Select Industrial Category'}
                                                // maxLength={200}

                                                >{this.state.indexChecked_Name.join(",")}
                                                </TextInput>
                                                <View style={{ position: 'absolute', right: 10, alignSelf: 'flex-end', padding: Platform.OS == 'ios' ? 5 : 10 }}>
                                                    <Image source={require('../imgs/add_button.png')} style={{ width: 30, height: 30 }} />
                                                </View>
                                            </View>
                                        </TouchableOpacity>

                                    </View>

                                    : null
