import React from 'react';
import {
  StyleSheet,
  Text,
  View,
  TextInput,
  Button,
  TouchableHighlight,
  Image,
  ImageBackground,
  Alert,
  TouchableOpacity,
  ActivityIndicator,
  BackHandler,
  FlatList,
  StatusBar,
  ScrollView,
  Platform, Linking
} from 'react-native';
import Modal from 'react-native-modal';
import DatePicker from 'react-native-datepicker';
import Icon from 'react-native-vector-icons/FontAwesome';
import { StackActions, NavigationActions, SafeAreaView } from 'react-navigation';
import AsyncStorage from '@react-native-community/async-storage';
import ProgressLoader from 'rn-progress-loader';
import Constants from '../Constants';
import DateFilter from '../Component/dateFilter';
import mainstyles from '../Component/mainstyles';
import ViewDownload from '../Component/viewDownload';
import RenderHtml from '../Component/renderHtml';
export default class AdminResponded extends React.Component {

  state = {
    isVisible: false, //state of modal default false
    isModalVisible: false,
    isLoading: false,
    imgPath: '',
    adminDetails: '',
    adminAnswer: '',
    date: '',
    date_End: '',
    dataSource: [],
    currentPage: 1,
    per_page: Constants.PerPage,
    isFirstTime: true,
    total: 0,

  }
  static navigationOptions = ({ navigation }) => {
    const respond_query = navigation.getParam('responded_query');
    return {
      title: 'Responded',
      headerStyle: {
        backgroundColor: '#0ea457',
      },
      headerTintColor: '#FFFFFF',
      headerTitleAlign: 'center',

      headerTitleStyle: {
        fontSize: 20,

      },

      headerRight: (
        <View style={{ flexDirection: 'row' }}>
          <View style={{ position: 'absolute', right: 10, alignSelf: 'flex-end', bottom: 15 }}>
            <Image source={require('../imgs/inbox_icon.png')} style={{ marginRight: 10 }} />
          </View>
          <View style={{ position: 'absolute', right: 10, bottom: 20, alignSelf: 'flex-end', borderRadius: 15, backgroundColor: 'red', width: 18, height: 18 }}>
            <Text style={{ color: '#FFFFFF', fontSize: 12, textAlign: 'center', fontWeight: 'bold' }}>{respond_query}</Text>
          </View>
        </View>
      )
    }
  }

  componentWillMount() {
    BackHandler.addEventListener('hardwareBackPress', this.handleBackButtonClick);
    this.DashboardDataResponded();

  }

  componentWillUnmount() {
    BackHandler.removeEventListener('hardwareBackPress', this.handleBackButtonClick);
  }

  handleBackButtonClick() {
    console.log("hello_props", this.props);
    this.props.navigation.goBack(null);
    // BackHandler.exitApp();
    return true;
  }

  constructor() {
    super();
    this.handleBackButtonClick = this.handleBackButtonClick.bind(this);
  }

  toggleModal = (adminData, adminAnswer) => {
    console.log(JSON.stringify(adminData));
    console.log('adminans', JSON.stringify(adminAnswer));
    this.setState({ isModalVisible: !this.state.isModalVisible });
    this.setState({ adminDetails: adminData });
    this.setState({ adminAnswer: adminAnswer });
    console.log('vijay');

    // this.getAnswerByExpert();
  };

  toggleModal_Close = () => {
    this.setState({ isModalVisible: !this.state.isModalVisible });
  };


  FlatListItemSeparator = () => {
    return (
      <View
        style={{
          height: 1,
          width: '100%',
          backgroundColor: '#ccc'
        }}
      />
    );


  }

  ResetData = async () => {
    this.setState({ date: '' });
    this.setState({ date_End: '' });
    this.setState({ currentPage: 1 });
    this.DashboardDataResponded();

  }
  DashboardDataResponded = async () => {
    var res = await Constants.isNetworkAvailable();
      if (!res) {
        return false;
      }
    this.setState({ isLoading: true });

    const userIdnewww = await AsyncStorage.getItem('id')
    var params = {
      'user_id': userIdnewww,
      'response_type': 'responded_query',
      'start': this.state.currentPage,
      'per_page': this.state.per_page
    };
    console.log('params', params)

    var formData = new FormData();

    for (var k in params) {
      formData.append(k, params[k]);
    }

    fetch(Constants.FullURL + '/users/dashboard', {
      method: 'POST',
      headers: {
        'authorisation': this.authorisationToken
      },
      body: formData,
    }).then((response) => response.json())

      .then((responseJson) => {
        console.log(JSON.stringify(responseJson))
        if (responseJson.status === true) {
          const type = responseJson.data;

          this.setState(
            {
              isLoading: false,
              dataSource: this.state.currentPage == 1 ? type.queries : [...this.state.dataSource, ...type.queries],
              imgPath: type.imagepath,
              total: type.total,
              isFirstTime: (type.queries.length == 0) ? false : true
            },
            function () {
              this.arrayholder = type.queries;
            }
          );


          //Alert.alert(responseJson.message);

        } else if (responseJson.status === false) {
          Alert.alert('Error', responseJson.message);
        }
      })
      .catch(error => {
        this.setState({ isLoading: false });
        //console.log(error);
      })

  }



  getData = (data) => {
    console.log('mydate', data.date);
    const newData = this.arrayholder.filter(function (item) {

      //applying filter for the inserted text in search bar
      return item.added_on.substring(0, item.added_on.length - 9) >= data.date && item.added_on.substring(0, item.added_on.length - 9) <= data.date_End

    });
    this.setState({
      dataSource: newData,

    });
  }

  handleLoadMore = async () => {
    console.log('load more handled');
    if (this.state.isFirstTime) {
      this.setState({
        currentPage: this.state.currentPage + 1
      })
      this.DashboardDataResponded();
    }

  }
  render() {

    // if (this.state.isLoading) {
    //   return (
    //     <View style={stylesIndi.container}>
    //       <ActivityIndicator
    //         size="large"
    //         color='#0ea457'
    //         style={stylesIndi.activityIndicator} />
    //     </View>
    //   );
    // }
    return (
      <View style={{ flex: 1, backgroundColor: '#fff' }}>
        <StatusBar barStyle="dark-content" backgroundColor="#0ea457" />
        <ProgressLoader
          visible={this.state.isLoading}
          isModal={true} isHUD={true}
          hudColor={"#00A637"}
          style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
          color={"#FFFFFF"} />
        <View style={{ backgroundColor: '#fff' }}>
          <DateFilter getData={this.getData} ResetData={this.ResetData} />
        </View>



        {this.state.dataSource.length === 0 ? <View style={mainstyles.norecordFound}>
          <Text style={mainstyles.norecordFound_Text}>No Query found here</Text>
        </View> : null}

        <FlatList
          data={this.state.dataSource}
          ItemSeparatorComponent={this.FlatListItemSeparator}
          initialNumToRender={this.state.per_page}   // how many item to display first
          onEndReachedThreshold={0.5}
          onEndReached={() => this.callOnScrollEnd = true}
          onMomentumScrollEnd={() => {
            this.callOnScrollEnd && this.handleLoadMore()
            this.callOnScrollEnd = false
          }}
          bounces={false}
          //Item Separator View
          renderItem={({ item }) =>
            (
              <View style={{ flex: 0 }}>
                <TouchableOpacity onPress={() => this.toggleModal(item, item.answerData)}>
                  <View style={{ flexDirection: 'row', backgroundColor: '#FFFFFF', marginBottom: 0 }}>
                    {item.user_image == null ? <Image source={require('../imgs/no_image.jpg')}
                      style={{ alignSelf: 'center', width: 50, height: 50, borderRadius: 150 / 2, marginLeft: 15 }} /> : <Image source={{ uri: this.state.imgPath + item.user_image }} style={{ alignSelf: 'center', width: 50, height: 50, borderRadius: 150 / 2, marginLeft: 15 }} />}
                    <View style={mainstyles.right_container}>
                      <Text style={mainstyles.query}>{item.query}  </Text>
                      <Text style={mainstyles.category_ask}>Category: {item.category_name} </Text>
                      <Text style={mainstyles.category_ask}>Ask: {item.asked_date} </Text>
                      <Text style={mainstyles.category_ask}>Asked By: {item.name} </Text>
                    </View>
                    <Image source={require('../imgs/forwardArr.png')} style={{ alignSelf: 'center', borderRadius: 150 / 2, marginRight: 5 }} />
                  </View>
                </TouchableOpacity>

              </View>


            )}

          enableEmptySections={true}
          keyExtractor={(item, index) => index.toString()}
        />


        {/* MODAL FOR ANSWER REVIEW */}
        <View style={{ flex: 1 }}>
          <View style={{ flex: 1, justifyContent: 'flex-start', alignItems: 'flex-start', flexDirection: 'column' }}>
            <Modal style={{ flex: 1, width: '100%', margin: 0 }} isVisible={this.state.isModalVisible}>
              <SafeAreaView forceInset={{ bottom: 'never' }} style={{ flex: 1, backgroundColor: '#FFFFFF' }}>
                <ScrollView>
                  <View style={{ flex: 1, backgroundColor: '#FFFFFF' }}>
                    <View style={{ flexDirection: 'row', backgroundColor: '#FFFFFF', marginBottom: 2, marginTop: Platform.OS == 'ios' ? 20 : 0 }}>
                      {this.state.adminDetails.user_image != null && this.state.adminDetails.user_image != '' ? <Image source={{ uri: this.state.imgPath + this.state.adminDetails.user_image }} style={{ width: 60, height: 60, borderRadius: 150 / 2, marginTop: 16, marginLeft: 5 }} /> : <Image source={require('../imgs/no_image.jpg')}
                        style={{ width: 60, height: 60, borderRadius: 150 / 2, marginTop: 16, marginLeft: 5 }} />}

                      <View style={mainstyles.right_container}>
                        <Text style={mainstyles.query}>{this.state.adminDetails.query}</Text>
                        <Text style={mainstyles.category_ask}>Category: {this.state.adminDetails.category_name} </Text>
                        <Text style={mainstyles.category_ask}>Ask: {this.state.adminDetails.asked_date} </Text>
                        <Text style={mainstyles.category_ask}>Asked By : {this.state.adminDetails.name} </Text>
                        
                      </View>
                      <TouchableOpacity onPress={() => { this.toggleModal_Close(); }}>
                        <Image source={require('../imgs/close.png')} style={{ borderRadius: 150 / 2, marginTop: 18, marginRight: 8, alignSelf: 'flex-end', opacity: 0.5 }} />
                      </TouchableOpacity>
                    </View>
                    <View>
                      <Text style={{ backgroundColor: '#f4f4f4', padding: 6, paddingLeft: 10, fontSize: 16 }}>Answer</Text>
                    </View>
                    <View style={{ flex: 0, marginBottom: 4, marginTop: 10, backgroundColor: '#FFFFFF' }}>
                      <View style={{ flexDirection: 'row' }}>
                        {this.state.adminAnswer.expert_image ?
                          <Image source={{ uri: this.state.imgPath + this.state.adminAnswer.expert_image }} style={{ width: 50, height: 50, borderRadius: 150 / 2, marginTop: 10, marginLeft: 5 }} />
                          :
                          <Image source={require('../imgs/userImg.png')} style={{ width: 50, height: 50, borderRadius: 150 / 2, marginTop: 14, marginLeft: 5 }} />
                        }

                        <View style={{ flex: 1 }}>
                          <Text style={{ color: 'white', padding: 5, paddingBottom: 0, fontSize: 16, color: '#000', marginLeft: 9, marginTop: 10, fontWeight: 'bold' }}>{this.state.adminAnswer.expert_name}</Text>
                          <Text style={{ color: 'white', fontSize: 12, color: '#000', marginLeft: 10 }}> {this.state.adminAnswer.answer_date} </Text>
                        </View>
                      </View>
                      <RenderHtml htmlText={this.state.adminAnswer.answer}/>
                      
                    </View>
                    {this.state.adminAnswer.upload_full_image != '' &&  <ViewDownload expertAnswerData={this.state.adminDetails?this.state.adminDetails:''} />}
                   
                  </View>
                </ScrollView>
              </SafeAreaView>
            </Modal>
          </View>
        </View>
        {/* MODAL END */}
      </View>
    );
  }
}
const stylesIndi = StyleSheet.create({
  container: {
    flex: 1,
    justifyContent: 'center',
    alignItems: 'center',
    marginTop: 70
  },
  activityIndicator: {
    flex: 1,
    justifyContent: 'center',
    alignItems: 'center',
    height: 80
  }
})

const styless = StyleSheet.create(
  {
    MainContainer:
    {

      alignItems: 'center',
      margin: 5,
      paddingTop: (Platform.OS === 'ios') ? 20 : 0
    }

  });

const styles = StyleSheet.create({
  container: {

    justifyContent: 'flex-start',
    alignItems: 'flex-start',
  },
  circle: {
    width: 36,
    height: 36,
    borderRadius: 18,   //half radius will make it cirlce,
    backgroundColor: 'red'
  },
  headline: {
    textAlign: 'center', // <-- the magic
    fontWeight: 'bold',
    fontSize: 18,
    marginTop: 0,
    width: 200,
    backgroundColor: 'yellow',
  }
});