import React, { Component } from 'react';
import {
  StyleSheet,
  Text,
  View,
  TextInput,
  Button,
  TouchableOpacity,
  TouchableHighlight,
  Image,
  ImageBackground,
  Alert,
  StatusBar,
  ScrollView,
  tintColor,
  BackHandler,
  FlatList, ActivityIndicator,
  Linking
} from 'react-native';
import styles_ from './styles'
import { Popover, PopoverContainer } from 'react-native-simple-popover';
import { StackActions, NavigationActions, SafeAreaView } from 'react-navigation';
import Modal from 'react-native-modal';
import ProgressLoader from 'rn-progress-loader';
import { createAppContainer } from 'react-navigation';
import { createStackNavigator } from 'react-navigation-stack';
import AsyncStorage from '@react-native-community/async-storage';
import { NavigationEvents } from "react-navigation";
import Spinner from 'react-native-loading-spinner-overlay';
import DatePicker from 'react-native-datepicker';
import Icon from 'react-native-vector-icons/FontAwesome';
import Constants from '../Constants';
import DateFilter from '../Component/dateFilter';
import mainstyles from '../Component/mainstyles';
import ViewDownload from '../Component/viewDownload';
import RenderHtml from '../Component/renderHtml';

export default class Answered_Query extends Component {

  arrayholder;
  static navigationOptions = ({ navigation }) => {
    const Answered_Query = navigation.getParam('Answered_Query');
    return {
      title: 'Answered Query',
      headerStyle: {
        backgroundColor: '#0ea457',
      },
      headerTintColor: '#FFFFFF',
      headerTitleAlign: 'center',

      headerTitleStyle: {
        fontSize: 20,

      },

      headerRight: (
        <View style={styles_.View_v1_all}>
          <View style={styles_.View_v2_all}>
            <Image source={require('../imgs/inbox_icon.png')} style={styles_.View_v3_all} />
          </View>
          <View style={styles_.View_v4_all}>
            <Text style={styles_.query_count_all}>{Answered_Query}</Text>
          </View>
        </View>
      )
    }
  }

  constructor(props) {
    super(props);
    //this.toggleModal = this.toggleModal.bind(this);
    this.handleBackButtonClick = this.handleBackButtonClick.bind(this);
    this.arrayholder =[];
    this.state = {
      isVisible: false, //state of modal default false
      isPopoverVisible: 0,
      showPop: false,
      popoverPlacement: 'left',
      isModalVisible: false,
      isLoading: false,
      spinner: true,
      imgPath: '',
      query_item: '',
      enduser_i: '',
      id: '',
      DiscardReason: '',
      isModalVisible_Answer: false,
      question_Answer: '',
      query_id_Answer: '',
      user_image_Answer: '',
      category_name_Answer: '',
      added_on_Answer: '',
      expert_name: '',
      answer_date: '',
      answer: '',
      date: '',
      date_End: '',
      expert_image: '',
      dataSource: [],
      answerData: '',
      currentPage: 1,
      per_page: Constants.PerPage,
      isFirstTime: true,
      total: 0,
      name:''
    }

  }

  toggleModal_Close_Answer = () => {
    this.setState({ isModalVisible_Answer: !this.state.isModalVisible_Answer });

  };
  toggleModal_Answer = (question_Answer, category_name_Answer, added_on_Answer, user_image_Answer, query_id_Answer, expert_name, answer_date, answer, expert_image, answerData,item) => {
    console.log('vijay', answerData);
    this.setState({ user_image_Answer: user_image_Answer });
    this.setState({ query_id_Answer: query_id_Answer });
    this.setState({ category_name_Answer: category_name_Answer });
    this.setState({ added_on_Answer: added_on_Answer });
    this.setState({ expert_name: expert_name });
    this.setState({ answer_date: answer_date });
    this.setState({ answer: answer });
    this.setState({ expert_image: expert_image });
    this.setState({ answerData: answerData });
    this.setState({ name: item.name.toString() });
    this.setState({ item: item });
    this.setState({ isModalVisible_Answer: !this.state.isModalVisible_Answer, question_Answer: question_Answer });



  };


  componentWillMount() {
    BackHandler.addEventListener('hardwareBackPress', this.handleBackButtonClick);
    this.DashboardDataNewQuery();

  }

  componentWillUnmount() {
    BackHandler.removeEventListener('hardwareBackPress', this.handleBackButtonClick);
  }

  handleBackButtonClick() {
    console.log("hello_props", this.props);
    this.props.navigation.goBack(null);
    // BackHandler.exitApp();
    return true;
  }

  FlatListItemSeparator = () => {
    return (
      <View
        style={{
          height: 1,
          width: '100%',
          backgroundColor: '#ccc',
        }}
      />
    );
  }


  ResetData = async () => {
    this.setState({ date: '' });
    this.setState({ date_End: '' });
    this.setState({ currentPage: 1 });
    this.DashboardDataNewQuery();

  }
  DashboardDataNewQuery = async () => {
    this.setState({ isLoading: true });
    const userIdnewww = await AsyncStorage.getItem('id')

    var params = {
      'user_id': userIdnewww,
      'response_type': 'answered_query',
      'start': this.state.currentPage,
      'per_page': this.state.per_page
    };
    console.log('params', params)
    var formData = new FormData();

    for (var k in params) {
      formData.append(k, params[k]);
    }

    fetch(Constants.FullURL + '/users/dashboard', {
      method: 'POST',
      headers: {
        'authorisation': this.authorisationToken
      },
      body: formData,
    }).then((response) => response.json())
      .then((responseJson) => {
        console.log(responseJson)
        if (responseJson.status === true) {
          const type = responseJson.data;
          this.setState(
            {
              isLoading: false,
              dataSource: this.state.currentPage == 1 ? type.queries : [...this.state.dataSource, ...type.queries],
              imgPath: type.imagepath,
              total: type.total,
              isFirstTime: (type.queries.length == 0) ? false : true
            },
            function () {
              this.arrayholder = this.state.currentPage == 1 ? type.queries : [...this.arrayholder, ...type.queries];
            }
          );
        } else if (responseJson.status === false) {
          Alert.alert('Error', responseJson.message);
          this.setState({ isLoading: false });
        }
      })
      .catch(error => {
        this.setState({ isLoading: false });
        console.log(error);
      })
  }
  showPopover = (val) => {
    if (this.state.isPopoverVisible == val) {
      this.setState({ isPopoverVisible: 0 });
    } else {
      this.setState({ isPopoverVisible: val });
    }
    console.log(val);
  }


  getData = (data) => {
    console.log('mydate', data);
    const newData = this.arrayholder.filter(function (item) {

      //applying filter for the inserted text in search bar
      return item.added_on.substring(0, item.added_on.length - 9) >= data.date && item.added_on.substring(0, item.added_on.length - 9) <= data.date_End

    });
    this.setState({
      //setting the filtered newData on datasource
      //After setting the data it will automatically re-render the view
      dataSource: newData,
      //search: date,
    });
  }
  handleLoadMore = async () => {
    console.log('load more handled');
    if (this.state.isFirstTime) {
      this.setState({
        currentPage: this.state.currentPage + 1
      })
      this.DashboardDataNewQuery();
    }
  }
  render() {



    return (

      <View style={{ flex: 1 }}>
        <ProgressLoader
          visible={this.state.isLoading}
          isModal={true} isHUD={true}
          hudColor={"#00A637"}
          style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
          color={"#FFFFFF"} />
        <NavigationEvents
          onDidFocus={this.DashboardDataNewQuery}
          onWillFocus={() => this.setState({ isLoading: false, currentPage: 1 })}
        />
        <View style={styles_.container_ans}>
          <View style={styles_.View_v5_all}>
            <Modal style={styles_.margin} isVisible={this.state.isModalVisible_Answer}>
              <SafeAreaView forceInset={{ bottom: 'never' }} style={{ flex: 1, backgroundColor: '#FFFFFF' }}>
                <ScrollView>
                  <View style={styles_.View_v6_all}>
                    <View style={styles_.View_v7_all}>
                      {this.state.user_image_Answer != null && this.state.user_image_Answer != "" ? <Image source={{ uri: this.state.imgPath + this.state.user_image_Answer }} style={styles_.image_all} /> : <Image source={require('../imgs/no_image.jpg')} style={styles_.image_all} />}

                      {/* <Image source={{ uri: this.state.imgPath + this.state.user_image_Answer }} style={styles_.image_all} /> */}
                      <View style={styles_.View_v8_all}>
                        <Text style={styles_.q_answer_all}>{this.state.question_Answer}</Text>
                        <Text style={styles_.cat_name_all}>Category: {this.state.category_name_Answer}</Text>
                        <Text style={styles_.ask_all}>Ask: {this.state.added_on_Answer}</Text>
                        <Text style={styles_.ask_all}>Asked By: {this.state.name}</Text>
                      </View>
                      <TouchableOpacity onPress={() => { this.toggleModal_Close_Answer(); }}>
                        <Image source={require('../imgs/close.png')} style={styles_.close_image__all} />
                      </TouchableOpacity>
                    </View>
                    <View>
                      <Text style={styles_.ans_tv_all}>Answer</Text>
                    </View>
                    <View style={styles_.View_v9_all}>
                      <View style={styles_.View_v1_all}>
                        {this.state.expert_image != null && this.state.expert_image != "" ? <Image source={{ uri: this.state.imgPath + this.state.expert_image }} style={styles_.image_list_all} /> : <Image source={require('../imgs/no_image.jpg')} style={styles_.image_list_all} />}
                        {/* <Image source={{ uri: this.state.imgPath + this.state.user_image_Answer }} style={styles_.image_list_all} /> */}
                        <View style={styles_.View_v8_all}>

                          <Text style={styles_.expert_name_all}>{this.state.expert_name}</Text>
                          <Text style={styles_.answer_date_all}> {this.state.answer_date} </Text>
                        </View>
                      </View>
                      
                        
                        <RenderHtml htmlText={this.state.answer}/>

                     
                    </View>
                    {this.state.answerData.upload_full_image != '' && <ViewDownload expertAnswerData={this.state.item?this.state.item:''} />}

                   
                  </View>
                </ScrollView>

              </SafeAreaView>
            </Modal>
          </View>
        </View>
        <View style={{ backgroundColor: '#fff' }}>
          <DateFilter getData={this.getData} ResetData={this.ResetData} />
        </View>
        <View style={styles_.View_v16_all}>


        {this.state.dataSource.length === 0 ? <View style={mainstyles.norecordFound}>
          <Text style={mainstyles.norecordFound_Text}>No Query found here</Text>
        </View> : null}
        
          <FlatList
            data={this.state.dataSource}
            keyExtractor={(item) => item.id}
            ItemSeparatorComponent={this.FlatListItemSeparator}
            initialNumToRender={this.state.per_page}   // how many item to display first
            onEndReachedThreshold={0.5}
            onEndReached={() => this.callOnScrollEnd = true}
            onMomentumScrollEnd={() => {
              this.callOnScrollEnd && this.handleLoadMore()
              this.callOnScrollEnd = false
            }}
            bounces={false}
            extraData={this.state}
            renderItem={({ item }) => (
              <View style={styles_.Parent_View_Dash}>
                <StatusBar barStyle="dark-content" backgroundColor="#0ea457" />
                <View style={styles_.View_v17_all}>
                  <View style={styles_.View_v18_all}>
                    <TouchableOpacity underlayColor="#0ea457" onPress={() => {
                      item.answerData.length != 0 ?
                        this.toggleModal_Answer(item.question, item.category_name, item.added_on, item.user_image, item.query_id, item.answerData.expert_name, item.answerData.answer_date, item.answerData.expert_answer, item.answerData.expert_image, item.answerData,item) : null
                    }} style={styles_.Touchable}>
                      <View style={styles_.View_V_10}>
                        <View style={styles_.View_V_11}>
                          {item.user_image == null ? <Image source={require('../imgs/no_image.jpg')}
                            style={styles_.im_all_v} /> : <Image source={{ uri: this.state.imgPath + item.user_image }} style={styles_.im_all_v} />}
                          <View style={styles_.View_V_12}>
                            <Text style={styles_.tv_1_all}>{item.question}  </Text>
                            <Text style={styles_.tv_2_cat_all}>Category: {item.category_name} </Text>
                            <Text style={styles_.tv_3_add_all}>Ask: {item.added_on} </Text>
                            <Text style={styles_.tv_3_add_all}>Asked By: {item.name} </Text>
                            {item.status == 2 ? <View style={styles_.View_v19_all}>
                              <Text style={styles_.status_tv_all}>Status:</Text>
                              <Text style={styles_.discard_tv_all}>Rejected</Text>
                            </View> : null}
                            {item.query_image != null &&  <ViewDownload itemData={item}/>}
                          </View>
                          {item.answerData.length != 0 ? <Image source={require('../imgs/forwardArr.png')} style={styles_.View_im_all} /> : null}
                        </View>
                      </View>
                    </TouchableOpacity>
                  </View>
                </View>
              </View>
            )}

          />

        </View>


      </View>

    )

  }
}
