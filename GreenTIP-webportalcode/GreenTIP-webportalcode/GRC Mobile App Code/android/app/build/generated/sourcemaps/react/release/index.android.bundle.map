import React from 'react';
import {
    StyleSheet,
    Text,
    View,
    TextInput,
    Button,
    TouchableHighlight,
    Image,
    ImageBackground,
    Alert,
    TouchableOpacity,
    ActivityIndicator,
    ScrollView,
    FlatList,
    StatusBar,
    Linking
} from 'react-native';
import Modal from 'react-native-modal';
import { StackActions, NavigationActions, SafeAreaView } from 'react-navigation';
import Spinner from 'react-native-loading-spinner-overlay';
import Toast from 'react-native-simple-toast';
import AsyncStorage from '@react-native-community/async-storage';
import ProgressLoader from 'rn-progress-loader';
import Constants from '../Constants';
import Icon from 'react-native-vector-icons/FontAwesome';
import mainstyles from '../Component/mainstyles';
import RenderHtml from '../Component/renderHtml';
export default class RespondAnswer extends React.Component {
    static navigationOptions = (navigation) => ({
        title: 'Respond',
        headerStyle: {
            backgroundColor: '#0ea457',
        },
        headerTitleStyle: {
            color: '#fff'
        },
        headerTintColor: '#fff',
        headerTitleAlign: 'center',
        // headerRight: () =>
        //     <View style={{ flexDirection: 'row' }}>
        //         <View style={{ position: 'absolute', right: 10, alignSelf: 'flex-end', bottom: 15 }}>
        //             <Image source={require('../imgs/inbox_icon.png')} style={{ marginRight: 10 }} />
        //         </View>
        //         <View style={{ position: 'absolute', right: 10, bottom: 20, alignSelf: 'flex-end', borderRadius: 15, backgroundColor: 'red', width: 18, height: 18 }}>
        //             <Text style={{ color: '#FFFFFF', fontSize: 12, textAlign: 'center', fontWeight: 'bold' }}> 25 </Text>
        //         </View>
        //     </View>
        // ,
    });

    state = {
        isVisible: false, //state of modal default false
        isModalVisible: false,
        assignID: '',
        spinner: false,
        userImg: '',
        question: '',
        categoryName: '',
        addedDate: '',
        expertImage: '',
        expertName: '',
        answerDate: '',
        expertAnswer: '',
        isLoading: false,
        message_user: '',
        role_type: '',
        expertAnswerData: [],
        roleId: '',
        isAnswerDeleted:true,
        name:''
    }
    constructor(props) {
        super(props);
    }

    toggleModal = async (assignQueryID) => {
        this.setState({ assignID: assignQueryID,isAnswerDeleted:true });
        console.log(this.state.assignID);
        await this.getAnswerByExpert();
    };

    toggleModal_Close = () => {
        this.setState({ isModalVisible: !this.state.isModalVisible });
    };

    componentDidMount = async () => {
        const roleId = await AsyncStorage.getItem('role_type')
        this.setState({ roleId: roleId });

        //  console.log('role_type', role_type)
        return this.props.navigation.state.params.adminData.answerData.map((data) => {
            return (
                this.getRoleType(data.user_id)

            )
        })
    }

    getRoleType = async (user_id_) => {


        // this.setState({ isLoading: true });
        // const user_id_ = this.props.navigation.state.params.adminData.answerData.map(x=><Text>{user_id}</Text>);
     //   console.log('user_id_', user_id_)
        const userId = await AsyncStorage.getItem('id')
        var params = {
            'user_id': userId,
            'ans_user_id': user_id_
        };
        // console.log('paramssss', params);
        var formData = new FormData();

        for (var k in params) {
            formData.append(k, params[k]);
        }

        fetch(Constants.FullURL + '/users/getTheUserType', {
            method: 'POST',
            body: formData,
        }).then((response) => response.json())
            .then((responseJson) => {
              //  console.log(responseJson)
                if (responseJson.status === true) {
                    // const role_type = responseJson.data;
                    const role_type = responseJson.data.role_type;
                    this.setState({ role_type: role_type });
                    //  console.log('role_type',role_type)
                    // this.setState({
                    //     isLoading: false,

                    // });
                } else if (responseJson.status === false) {
                    Alert.alert('Error', responseJson.message);
                   // this.setState({ isLoading: false });
                }
            })
            .catch(error => {
               // this.setState({ isLoading: false });
                console.log(error);
            })
    }

    getAnswerByExpert = async () => {
        this.setState({ isLoading: true });
        const userId = await AsyncStorage.getItem('id')
        var params = {
            'user_id': userId,
            'assign_query_id': this.state.assignID
        };
        console.log('paramssss', params);
        var formData = new FormData();

        for (var k in params) {
            formData.append(k, params[k]);
        }

        fetch(Constants.FullURL + '/users/get_answer_by_expert', {
            method: 'POST',
            body: formData,
        }).then((response) => response.json())
            .then((responseJson) => {
                console.log('response',responseJson);
                if (responseJson.status === true) {

                    const respData = responseJson.data;
                    const expertData = responseJson.data.answerData;
                    this.setState({
                        isLoading: false,
                        userImg: respData.user_image,
                        question: respData.question,
                        categoryName: respData.category_name,
                        addedDate: respData.added_on,
                        expertImage: expertData.expert_image,
                        expertName: expertData.expert_name,
                        answerDate: expertData.answer_date,
                        expertAnswer: expertData.expert_answer,
                       
                        expertAnswerData: expertData,
                        name:  respData.name,
                        isModalVisible: !this.state.isModalVisible
                    });
                } else if (responseJson.status === false) {
                    Alert.alert('Error', responseJson.message);
                    this.setState({ isLoading: false });
                }
            })
            .catch(error => {
                this.setState({ isLoading: false });
                console.log(error);
            })
    }

    publishAnswer = async () => {
        this.setState({ isLoading: true });
        const userId = await AsyncStorage.getItem('id')

        var params = {
            'assign_query_id': this.state.assignID,
            'user_id': userId,
            'answer': this.state.expertAnswer
        };
        console.log('paramssss', params);
        var formData = new FormData();

        for (var k in params) {
            formData.append(k, params[k]);
        }

        fetch(Constants.FullURL + '/users/review', {
            method: 'POST',
            body: formData,
        }).then((response) => response.json())
            .then((responseJson) => {
                console.log(responseJson)
                if (responseJson.status === true) {
                    const respData = responseJson.data;
                    this.setState({ isModalVisible: !this.state.isModalVisible });
                    // Alert.alert('Congrats! Your review has been submitted.');
                  //  Toast.show(responseJson.message, Toast.LONG);
                    setTimeout(() => {
                        Toast.show(responseJson.message, Toast.SHORT);
                    }, 500);

                    this.setState({
                        isLoading: false,

                    });
                    this.props.navigation.navigate('AdminRespondQuery');

                } else if (responseJson.status === false) {
                    Alert.alert('Error', responseJson.message);
                    this.setState({ isLoading: false });
                }
            })
            .catch(error => {
                this.setState({ isLoading: false });
                console.log(error);
            })
    }

    disable = () => { }

    FlatListItemSeparator = () => {
        return (
            <View
                style={{
                    height: 1,
                    width: '85%',
                    backgroundColor: '#ccc',
                    marginLeft: '18%'
                }}
            />
        );
    }
    Confirm(assign_query_id) {
        Alert.alert(
            'Are you sure you want to perform this action?',
            '',
            [
                {
                    text: '',
                    onPress: () => console.log('Ask me later pressed')
                },
                {
                    text: 'Cancel',
                    onPress: () => console.log('Cancel Pressed'),
                    style: 'cancel'
                },
                { text: 'OK', onPress: () => this.deleteAttachment(assign_query_id) }
            ],
            { cancelable: false }
        );
    }
    deleteAttachment = async (assign_query_id) => {
        this.setState({ isLoading: true });
        const userId = await AsyncStorage.getItem('id')
        var params = {
            'user_id':userId,
            'assign_query_id': assign_query_id,

        };
        console.log('paramssss', params);
        var formData = new FormData();

        for (var k in params) {
            formData.append(k, params[k]);
        }

        fetch(Constants.FullURL + '/users/deleteAttachment', {
            method: 'POST',
            body: formData,
        }).then((response) => response.json())
            .then((responseJson) => {
                console.log(responseJson)
                if (responseJson.status === true) {
                    const respData = responseJson.data;
                    // Alert.alert('Congrats! Your review has been submitted.');
                    Toast.show(responseJson.message, Toast.LONG);


                    this.setState({
                        isLoading: false,
                        isAnswerDeleted:false

                    });
                } else if (responseJson.status === false) {
                    Alert.alert('Error', responseJson.message);
                    this.setState({ isLoading: false });
                }
            })
            .catch(error => {
                this.setState({ isLoading: false });
                console.log(error);
            })
    }
    render() {

        const nav = this.props.navigation.state.params.adminData.answerData;
        console.log('test hello', nav)
        return (
            <View style={{ flex: 1, backgroundColor: '#FFFFFF' }}>
               
                <StatusBar barStyle="dark-content" backgroundColor="#0ea457" />

                <ProgressLoader
                    visible={this.state.isLoading}
                    isModal={true} isHUD={true}
                    hudColor={"#00A637"}
                    style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
                    color={"#FFFFFF"} />
                <View style={{ flex: 0, backgroundColor: '#FFFFFF' }}>
                    <View style={{ flexDirection: 'row', backgroundColor: '#FFFFFF', marginBottom: 2 }}>
                        {this.props.navigation.state.params.adminData.user_image != null ? <Image source={{ uri: this.props.navigation.state.params.imgpath + this.props.navigation.state.params.adminData.user_image }} style={{ width: 60, height: 60, borderRadius: 150 / 2, marginTop: 18, marginLeft: 5 }} /> : <Image source={require('../imgs/no_image.jpg')}
                            style={{ width: 60, height: 60, borderRadius: 150 / 2, marginTop: 18, marginLeft: 5 }} />}

                        <View style={mainstyles.right_container}>
                            <Text style={mainstyles.query}>{this.props.navigation.state.params.adminData.question}</Text>
                            <Text style={mainstyles.category_ask} >Category: {this.props.navigation.state.params.adminData.category_name} </Text>
                            <Text style={mainstyles.category_ask}>Ask: {this.props.navigation.state.params.adminData.asked_date} </Text>
                            <Text style={mainstyles.category_ask}>Asked By: {this.props.navigation.state.params.adminData.name} </Text>
                        </View>
                    </View>
                    {this.state.role_type == 3 ? <TouchableOpacity onPress={() => this.props.navigation.navigate('AssignExpert', { 'query': this.props.navigation.state.params.adminData.question, 'enduser_image': this.props.navigation.state.params.adminData.user_image, 'imgPath': this.props.navigation.state.params.imgpath, 'id': this.props.navigation.state.params.id, 'AssigntoMD': 'AssigntoMD','respondAnswerQuery':'respondAnswerQuery' })} style={[styles.buttonContainer, styles.loginButton]}>
                        <Text style={styles.loginText}>Re-Assign To MD</Text>
                    </TouchableOpacity> : <TouchableOpacity onPress={() => this.props.navigation.navigate('AssignExpert', { 'query': this.props.navigation.state.params.adminData.question, 'enduser_image': this.props.navigation.state.params.adminData.user_image, 'imgPath': this.props.navigation.state.params.imgpath, 'id': this.props.navigation.state.params.id,'respondAnswerQuery':'respondAnswerQuery' })} style={[styles.buttonContainer, styles.loginButton]}>
                            <Text style={styles.loginText}>Re-Assign To Expert</Text>
                        </TouchableOpacity>}

                    <View>
                        <Text style={{ backgroundColor: '#f4f4f4', padding: 6, paddingLeft: 10, fontSize: 16 }}>Answer</Text>
                    </View>
                    <FlatList
                        data={this.props.navigation.state.params.adminData.answerData}
                        ItemSeparatorComponent={this.FlatListItemSeparator}
                        //Item Separator View
                        renderItem={({ item }) => (
                            <View style={{ flex: 0 }}>
                                <View style={{ flex: 0, marginBottom: 0, backgroundColor: '#FFFFFF' }}>
                                    {item.answer ?
                                        <TouchableOpacity onPress={() => { item.answer ? this.toggleModal(item.assign_query_id) : this.disable() }}>
                                            <View style={{ flexDirection: 'row' }}>
                                                {
                                                    item.expert_image ?
                                                        <Image source={{ uri: this.props.navigation.state.params.imgpath + item.expert_image }} style={{ width: 50, height: 50, borderRadius: 150 / 2, marginTop: 14, marginLeft: 5 }} />
                                                        :
                                                        <Image source={require('../imgs/no_image.jpg')} style={{ width: 50, height: 50, borderRadius: 150 / 2, marginTop: 14, marginLeft: 5 }} />
                                                }
                                                <View style={{ flex: 1, height: '100%' }}>
                                                    <Text style={{ color: 'white', padding: 5, paddingBottom: 0, fontSize: 16, color: '#3C3C3C', marginLeft: 6, marginTop: 14, fontWeight: 'bold' }}>{item.expert_name}</Text>
                                                    {
                                                        item.answer_date ?
                                                            <Text style={{ fontSize: 12, color: '#000', marginLeft: 8 }}> {item.answer_date} </Text>
                                                            :
                                                            <Text style={{ color: '#ff0000', fontSize: 12, marginLeft: 8 }}> (Pending) </Text>
                                                    }
                                                </View>
                                                {item.answer ?
                                                    <Image source={require('../imgs/forwardArr.png')} style={{ borderRadius: 150 / 2, marginTop: 50, marginRight: 5 }} />
                                                    :
                                                    <Text></Text>
                                                }
                                            </View>
                                            <RenderHtml htmlText={item.answer}/>
                                            </TouchableOpacity>
                                        :
                                        <View>
                                            <View style={{ flexDirection: 'row' }}>
                                                {
                                                    item.expert_image ?
                                                        <Image source={{ uri: this.props.navigation.state.params.imgpath + item.expert_image }} style={{ width: 50, height: 50, borderRadius: 150 / 2, marginTop: 14, marginLeft: 5 }} />
                                                        :
                                                        <Image source={require('../imgs/no_image.jpg')} style={{ width: 50, height: 50, borderRadius: 150 / 2, marginTop: 14, marginLeft: 5 }} />
                                                }
                                                <View style={{ flex: 1, height: '100%' }}>
                                                    <Text style={{ color: 'white', padding: 5, paddingBottom: 0, fontSize: 16, color: '#3C3C3C', marginLeft: 6, marginTop: 14, fontWeight: 'bold' }}>{item.expert_name}</Text>
                                                    <Text style={{ color: '#ff0000', fontSize: 12, marginLeft: 8 }}> (Pending) </Text>
                                                </View>
                                            </View>
                                            <Text></Text>
                                        </View>
                                    }
                                </View>
                            </View>
                        )}

                        enableEmptySections={true}
                        keyExtractor={(item, index) => index.toString()}
                    />
                </View>

                {/* MODAL FOR ANSWER REVIEW */}
                <View style={styles.container}>
                    <View style={{ flex: 1, justifyContent: 'flex-start', alignItems: 'flex-start', flexDirection: 'column' }}>
                        <Modal style={{ flex: 1, width: '100%', margin: 0 }} isVisible={this.state.isModalVisible}>
                            <SafeAreaView forceInset={{ bottom: 'never' }} style={{ flex: 1, backgroundColor: '#FFFFFF' }}>
                                <View style={{ flex: 1, backgroundColor: '#FFFFFF' }}>
                                    <View style={{ flexDirection: 'row', backgroundColor: '#FFFFFF', marginBottom: 2, marginTop: Platform.OS == 'ios' ? 20 : 0 }}>
                                        {this.state.userImg == null ? <Image source={require('../imgs/no_image.jpg')}
                                            style={{ width: 60, height: 60, borderRadius: 150 / 2, marginTop: 16, marginLeft: 5 }} /> : <Image source={{ uri: this.props.navigation.state.params.imgpath + this.state.userImg }} style={{ width: 60, height: 60, borderRadius: 150 / 2, marginTop: 16, marginLeft: 5 }} />}
                                        {/* <Image source={{ uri: this.props.navigation.state.params.imgpath + this.state.userImg }} style={{ width: 60, height: 60, borderRadius: 150 / 2, marginTop: 16, marginLeft: 5 }} /> */}
                                        <View style={mainstyles.right_container}>
                                            <Text style={mainstyles.query}>{this.state.question}</Text>
                                            <Text style={mainstyles.category_ask}>Category: {this.state.categoryName} </Text>
                                            <Text style={mainstyles.category_ask}>Ask: {this.state.addedDate} </Text>
                                            <Text style={mainstyles.category_ask}>Asked By: {this.state.name} </Text>
                        
                                        </View>
                                        <TouchableOpacity onPress={() => { this.toggleModal_Close(); }}>
                                            <Image source={require('../imgs/close.png')} style={{ borderRadius: 150 / 2, marginTop: 18, marginRight: 8, alignSelf: 'flex-end', opacity: 0.5 }} />
                                        </TouchableOpacity>
                                    </View>
                                    <View>
                                        <Text style={{ backgroundColor: '#f4f4f4', padding: 6, paddingLeft: 10, fontSize: 16 }}>Answer</Text>
                                    </View>
                                    <View style={{ flex: 0, marginBottom: 4, marginTop: 10, backgroundColor: '#FFFFFF' }}>
                                        <View style={{ flexDirection: 'row' }}>
                                            {this.state.expertImage ==null?<Image source={{ uri: Constants.APIURL + 'assets/grocery_crud/themes/bootstrap/img/a0.jpg' }} style={{ width: 50, height: 50, borderRadius: 150 / 2, marginTop: 10, marginLeft: 5 }} />:<Image source={{ uri: this.props.navigation.state.params.imgpath + this.state.expertImage }} style={{ width: 50, height: 50, borderRadius: 150 / 2, marginTop: 10, marginLeft: 5 }} />}
                                            <View style={mainstyles.right_container}>
                                                <Text style={{ padding: 5, paddingBottom: 0, fontSize: 16, color: '#000', marginLeft: 9, marginTop: 10, fontWeight: 'bold' }}>{this.state.expertName}</Text>
                                                <Text style={{ fontSize: 12, color: '#000', marginLeft: 10 }}> {this.state.answerDate} </Text>
                                            </View>
                                        </View>
                                        <View>
                                            <ScrollView>
                                                <TextInput style={{ height: 200, borderColor: '#C8C8C8', borderWidth: 1, marginTop: 20, textAlignVertical: 'top', width: '96%', marginLeft: '2%', color: 'black', }}
                                                    underlineColorAndroid="transparent"
                                                    paddingLeft={10}
                                                    fontSize={15}
                                                    returnKeyType="done"
                                                    //blurOnSubmit={true}
                                                    multiline={true}
                                                    numberOfLines={10}
                                                    onChangeText={expertAnswer => this.setState({ expertAnswer })}
                                                    value={this.state.expertAnswer} />
                                            </ScrollView>
                                        </View>



                                    </View>
                                    {(this.state.expertAnswerData.upload_full_image != '' && this.state.isAnswerDeleted) && <View style={{ flex: 1, flexDirection: 'row', width: '100%', padding: '2%', }}>
                                        <View style={{ width: '50%' }}>
                                            {/* <TouchableOpacity onPress={() => Linking.openURL(this.state.expertAnswerData.upload_full_image)}>
                                                <Icon name="eye" size={20} color="#00AD39" /> 
                                                    <Text style={{ color: '#00AD39', fontSize: 18 }}>Attachment</Text>
                                                </TouchableOpacity>*/}
                                        </View>
                                        <View style={{ width: '50%' }}>



                                            <View style={(this.state.roleId == '0') ? mainstyles.deleteBtn : ''}>
                                                <TouchableOpacity onPress={() => Linking.openURL(this.state.expertAnswerData.upload_full_image)}>
                                                    <Text style={{ color: '#00AD39', fontSize: 18, textAlign: 'right' }}><Icon name="eye" size={20} color="#00AD39" />View</Text>
                                                </TouchableOpacity>
                                                {this.state.roleId == '0' && <TouchableOpacity onPress={() => this.Confirm(this.state.expertAnswerData.id)}>
                                                    <Text style={{ color: 'red', fontSize: 18, textAlign: 'right', alignItems: 'flex-end' }}><Icon name="trash" size={20} color="red" /> Delete </Text>
                                                </TouchableOpacity>}
                                            </View>
                                        </View>
                                    </View>}

                                </View>

                                <View style={{
                                    flexDirection: 'row',
                                }}>
                                    {this.state.role_type == 3 ? <TouchableHighlight underlayColor="#F9AE2D" onPress={() => {
                                        this.setState({ isModalVisible: !this.state.isModalVisible }),
                                            this.props.navigation.navigate('AssignExpert', { 'query': this.props.navigation.state.params.adminData.question, 'enduser_image': this.props.navigation.state.params.adminData.user_image, 'imgPath': this.props.navigation.state.params.imgpath, 'id': this.props.navigation.state.params.id, 'AssigntoMD': 'AssigntoMD' })
                                    }} style={{
                                        height: 50,
                                        flexDirection: 'row',
                                        justifyContent: 'center',
                                        alignItems: 'center',
                                        width: '50%',
                                        backgroundColor: "#F9AE2D"
                                    }}>
                                        <Text style={{ color: 'white', fontSize: 18 }}>Re-Assign To MD</Text>
                                    </TouchableHighlight> :
                                        <TouchableHighlight underlayColor="#F9AE2D" onPress={() => {
                                            this.setState({ isModalVisible: !this.state.isModalVisible }),
                                                this.props.navigation.navigate('AssignExpert', { 'query': this.props.navigation.state.params.adminData.question, 'enduser_image': this.props.navigation.state.params.adminData.user_image, 'imgPath': this.props.navigation.state.params.imgpath, 'id': this.props.navigation.state.params.id, 'respondAnswerQuery': 'respondAnswerQuery' })
                                        }} style={{
                                            height: 50,
                                            flexDirection: 'row',
                                            justifyContent: 'center',
                                            alignItems: 'center',
                                            width: '50%',
                                            backgroundColor: "#F9AE2D"
                                        }}>
                                            <Text style={{ color: 'white', fontSize: 18 }}>Re-Assign To Expert</Text>
                                        </TouchableHighlight>}


                                    <TouchableOpacity underlayColor="#00AD39" onPress={() => this.publishAnswer()} style={{
                                        height: 50,
                                        flexDirection: 'row',
                                        justifyContent: 'center',
                                        alignItems: 'center',
                                        width: '50%',
                                        backgroundColor: "#00AD39"
                                    }}
                                    >
                                        <Text style={{ color: 'white', fontSize: 18 }}>Publish</Text>
                                    </TouchableOpacity>



                                </View>
                            </SafeAreaView>
                        </Modal>
                    </View>
                </View>
                {/* MODAL END */}
            </View>
        );
    }
}


