            >

                <View style={{ flex: 1, flexDirection: 'column', backgroundColor: '#FFFFFF' }}>

                    <ProgressLoader
                        visible={this.state.isLoading}
                        isModal={true} isHUD={true}
                        hudColor={"#00A637"}
                        style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
                        color={"#FFFFFF"} />

                    <StatusBar barStyle="dark-content" backgroundColor="#0ea457" />

                    <View style={{ flex: 1, flexDirection: 'column', backgroundColor: '#FFFFFF', marginBottom: '20%' }}>

                        {/* <Icon.Button
    name="edit"
    backgroundColor="#3b5998"
    onPress={this.edit}
  >
    Edit
</Icon.Button> */}
                        <TouchableHighlight underlayColor="#ffffff00" onPress={() => {
                            this.Fle_Picker();
                        }}
                            style={{ flexDirection: 'row', padding: 10, alignItems: 'center', justifyContent: 'center' }} >


                            <View style={{ flexDirection: 'row' }}>


                                {this.state.image === '' ? <Image source={require('../imgs/no_image.jpg')}
                                    style={{
                                        width: 80, height: 80, borderRadius: 150 / 2, marginLeft: 5
                                    }} /> : <Image source={{ uri: this.state.image != null ? this.state.image : "" }}
                                        style={{
                                            width: 80, height: 80, borderRadius: 150 / 2, marginLeft: 5
                                        }} />}

                                <Image source={require('../imgs/edit_icon.png')}
                                    style={{
                                        // marginBottom: 20
                                        //backgroundColor: '#ccc',
                                        position: 'absolute',
                                        right: 0,
                                        bottom: 0
                                    }} />

                                {/* <Image source={require('../imgs/edit_icon.png')}
                                style={{
                                                require('../imgs/userIcon.png')

                                     width: 20,height: 20, marginLeft: 10, position: 'absolute', bottom: 8, right: '42%'
                                }} /> */}

                            </View>
                        </TouchableHighlight>

                        <View style={mainstyles.addExpertContainer}>
                            <View>
                                <Text style={mainstyles.contatus_label}>First Name*</Text>
                                <TextInput
                                    style={mainstyles.contatus_input}
                                    placeholder={'First Name'}
                                    padding={8}
                                    placeholderTextColor='#000'
                                    onChangeText={First_name => this.setState({ First_name })}



                                >

                                </TextInput>

                            </View>


                            <View>
                                <Text style={mainstyles.contatus_label}>Last Name*</Text>
                                <TextInput style={mainstyles.contatus_input}
                                    placeholder={'Last Name'}
                                    padding={8}
                                    placeholderTextColor='#000'
                                    onChangeText={Last_name => this.setState({ Last_name })}

                                >
                                </TextInput>

                            </View>



                            <View>
                                <Text style={mainstyles.contatus_label}>Email Address *</Text>
                                <TextInput style={mainstyles.contatus_input}
                                    placeholder={'Email Address'}
                                    placeholderTextColor='#000'
                                    padding={8}
                                    keyboardType={'email-address'}
                                    onChangeText={Email => this.setState({ Email })}


                                ></TextInput>

                            </View>



                            <View>
                                <Text style={mainstyles.contatus_label}>Password *</Text>
