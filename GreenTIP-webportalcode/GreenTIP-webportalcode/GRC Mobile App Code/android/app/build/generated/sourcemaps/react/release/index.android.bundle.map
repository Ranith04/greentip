    componentWillMount() {
        BackHandler.addEventListener('hardwareBackPress', this.handleBackButtonClick);
    }

    componentWillUnmount() {
        BackHandler.removeEventListener('hardwareBackPress', this.handleBackButtonClick);
    }

    handleBackButtonClick() {
        console.log("hello_props", this.props);
        this.props.navigation.goBack(null);
        // BackHandler.exitApp();
        return true;
    }


    validate_field = () => {
        const { First_name, Last_name, Email, Password, linkdin, facebook, Company_Name, Occupation, Education, Expertise, Description, Phone } = this.state;

        const reg = /^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/;
        const name_ = /^[a-zA-Z]+$/;

        if (name_.test(First_name) === false) {
            alert("Please Enter First Name")
            return false
        }
        else if (name_.test(Last_name) === false) {
            alert("Please Enter Last Name")
            return false
        }

        else if (reg.test(Email) === false) {
            alert("Enter Valid Email Address")
            return false
        }
        else if (Password.length < 8) {
            alert("Password field must be at least 8 characters in length")
            return false
        }

        // else if (Phone.length < 10) {
        //     alert("Enter Valid Mobile Number")
        //     return false
        // }

        return true
    }



    Add_Expert = async () => {
        if (this.validate_field()) {
            this.setState({ isLoading: true });
            const userIdnewww = await AsyncStorage.getItem('id')
            const { First_name, Last_name, Email, Password, linkdin, facebook, Company_Name, Occupation, Education, Expertise, Description, image, real_Path_type, real_Path_name, Phone,company_location,state,district,pin } = this.state;
            const photo = {
                uri: image,
                type: real_Path_type,
                name: real_Path_name
            };

            const formData = new FormData();

            if (photo.type === '') {
                formData.append('userFile', '');
            } else {
                formData.append('userFile', photo);
            }
            formData.append("first_name", First_name);
            formData.append("last_name", Last_name);
            formData.append("email", Email);
            //  formData.append('contact_no', Phone);
            formData.append('company_name', Company_Name);
            formData.append('occupation', Occupation);
            formData.append('education_qualification', Education);
            formData.append('expertise_field', Expertise);
            formData.append('user_id', userIdnewww);
            formData.append('password', Password);
            formData.append('list_by', 'expert_user');
            formData.append('description', '');
            formData.append('linkdin', linkdin);
            formData.append('facebook', facebook);
            formData.append('company_location', company_location);
            formData.append('state', state);
            formData.append('district', district);
            formData.append('pin', pin);
            fetch(Constants.FullURL + '/users/admin_insert_user', {
                method: 'POST',
                headers: {
                    'authorisation': this.authorisationToken
                },
                body: formData,
            }).then((response) => response.json())

                .then((responseJson) => {
                    console.log(responseJson)
                    if (responseJson.status === true) {
                        //Alert.alert(responseJson.message);
                      //  Toast.show(responseJson.message, Toast.SHORT);
                        setTimeout(() => {
                            Toast.show(responseJson.message, Toast.SHORT);
                        }, 500);

                        { this.setState({ isVisible: false }) }

                        this.setState({
                            isLoading: false,
                        });

                        this.props.navigation.navigate('ExpertManagement');


                    } else if (responseJson.status === false) {
                        this.setState({
                            isLoading: false,
                        });
                        Alert.alert('Error', responseJson.message);

                    }
                })
                .catch(error => {
                    this.setState({ isLoading: false });
                    console.log(error);
                })
        }


    }


    Fle_Picker = async () => {

        try {
            const res = await DocumentPicker.pick({
                type: [DocumentPicker.types.images],
            });
            const split = res.uri.split('/');
            const name = split.pop();
            const inbox = split.pop();
            const realPath = `${RNFS.TemporaryDirectoryPath}${inbox}/${name}`;
            //let source = { uri: res.uri };

            this.setState({
                // file_name: res.name,
                image: res.uri,
                real_Path_name: res.name,
                real_Path_type: res.type,
            });
            console.log('uri', res.uri)
            console.log('type', res.type)
            console.log('name', res.name)
            console.log('size', res.size)
        } catch (err) {
            if (DocumentPicker.isCancel(err)) {
                // User cancelled the picker, exit any dialogs or menus and move on
            } else {
                throw err;
            }
        }
    }



    render() {


        return (
            <KeyboardAwareScrollView contentContainerStyle={{ flexGrow: 1 }}
