                </TouchableHighlight>

                <View style={{ flex: 1, flexDirection: 'column', height: '100%' }}>
                  <Text style={{ fontWeight: 'bold', padding: 5, fontSize: 18, color: '#000', marginLeft: 10, marginRight: 5, marginTop: 30, alignContent: 'center' }}>{this.state.name}</Text>
                  {this.state.ProfileTag != 'ProfileExpert' && this.state.ProfileTagEndUser != 'ProfileTagEndUser' && this.state.role_type != '1' && this.state.role_type != '3' && this.state.role_type != '2' ? <Text style={{ fontSize: 14, color: '#000', marginLeft: 10 }}> Admin </Text> : null}
                </View>
              </View>
              {this.state.ProfileTag != 'ProfileExpert' ? <View style={{
                flexDirection: 'row',
                justifyContent: 'center',
                alignItems: 'center',
                borderWidth: 1,
                borderColor: '#C8C8C8',
                height: 45,
                borderRadius: 5,
                width: "90%",
                marginLeft: 15, marginRight: 15,
                margin: 10
              }}>
                <Image
                  source={require('../imgs/mobile_icon.png')} //Change your icon image here
                  style={{
                    padding: 10,
                    margin: 5,
                    resizeMode: 'stretch',
                    alignItems: 'center'
                  }}
                />
                <TextInput
                  style={{ flex: 1, color: 'black' }}
                  underlineColorAndroid="transparent"
                  keyboardType={'numeric'}
                  placeholderTextColor='#000'
                  maxLength={10}
                  returnKeyType="done"
                  value={this.state.mobile}
                  onChangeText={mobile => this.setState({ mobile })}
                >

                </TextInput>
              </View> : null}


              {this.state.ProfileTag == 'ProfileExpert' ? <View style={{
                flexDirection: 'row',
                justifyContent: 'center',
                alignItems: 'center',
                borderWidth: 1,
                borderColor: '#C8C8C8',
                height: 45,
                borderRadius: 5,
                width: "90%",
                marginLeft: 15, marginRight: 15,
                margin: 10
              }}>

                <Image
                  source={require('../imgs/mail_icon.png')} //Change your icon image here
                  style={{
                    padding: 10,
                    margin: 5,
                    resizeMode: 'stretch',
                    alignItems: 'center'
                  }}
                />

                <TextInput
                  style={{ flex: 1, color: 'black' }}
                  keyboardType={'email-address'}
                  editable={false}
                  onChangeText={email_save => this.setState({ email_save })}
                  underlineColorAndroid="transparent"
                  value={this.state.email_save}
                  placeholderTextColor='#000'

                >
                </TextInput>
              </View> : this.state.ProfileTagEndUser == 'ProfileTagEndUser' ?
                  <View style={{
                    flexDirection: 'row',
                    justifyContent: 'center',
                    alignItems: 'center',
                    borderWidth: 1,
                    borderColor: '#C8C8C8',
                    height: 45,
                    borderRadius: 5,
                    width: "90%",
                    marginLeft: 15, marginRight: 15,
                    margin: 10
                  }}>

                    <Image
                      source={require('../imgs/mail_icon.png')} //Change your icon image here
                      style={{
                        padding: 10,
                        margin: 5,
                        resizeMode: 'stretch',
                        alignItems: 'center'
                      }}
                    />

                    <TextInput
                      style={{ flex: 1, color: 'black' }}
                      keyboardType={'email-address'}
                      editable={false}
                      onChangeText={email_save => this.setState({ email_save })}
                      underlineColorAndroid="transparent"
                      value={this.state.email_save}
                      placeholderTextColor='#000'

                    >
                    </TextInput>
                  </View> : <View style={{
                    flexDirection: 'row',
                    justifyContent: 'center',
                    alignItems: 'center',
                    borderWidth: 1,
                    borderColor: '#C8C8C8',
                    height: 45,
                    borderRadius: 5,
                    width: "90%",
                    marginLeft: 15, marginRight: 15,
                    margin: 10
                  }}>

                    <Image
                      source={require('../imgs/mail_icon.png')} //Change your icon image here
                      style={{
                        padding: 10,
                        margin: 5,
                        resizeMode: 'stretch',
                        alignItems: 'center'
                      }}
                    />

                    <TextInput
                      style={{ flex: 1, color: 'black' }}
                      keyboardType={'email-address'}
                      editable={false}
                      onChangeText={email_save => this.setState({ email_save })}
                      underlineColorAndroid="transparent"
                      value={this.state.email_save}
                      editable={false}
                      placeholderTextColor='#000'

                    >
                    </TextInput>
                  </View>}

              <View style={mainstyles.addExpertContainer}>
                <View>
                  <Text style={mainstyles.contatus_label}>Full Name *</Text>
                  <TextInput
                    style={mainstyles.contatus_input} onChangeText={name => this.setState({ name })}
                    value={this.state.name}
                    padding={8}
                    placeholderTextColor='#000'
                  >
                  </TextInput>

                </View>



                {this.state.ProfileTag === 'ProfileExpert' ? <View>
                  <Text style={mainstyles.contatus_label}>LinkedIn URL</Text>
                  <TextInput style={mainstyles.contatus_input}
                    placeholder={'LinkedIn URL'} onChangeText={linkdin => this.setState({ linkdin })}
                    value={this.state.linkdin}
                    padding={8}
                    placeholderTextColor='#000'
                  >

                  </TextInput>

                </View> : null}

                {this.state.ProfileTag === 'ProfileExpert' ? <View>
                  <Text style={mainstyles.contatus_label}>Facebook URL</Text>
                  <TextInput style={mainstyles.contatus_input}
                    placeholder={'Facebook URL'} onChangeText={facebook => this.setState({ facebook })}
                    value={this.state.facebook}
                    padding={8}
                    placeholderTextColor='#000'
                  >
                  </TextInput>

                </View> : null}

                <View>
                  <Text style={mainstyles.contatus_label}>Company Name</Text>
                  <TextInput style={mainstyles.contatus_input} placeholder={'Company Name'} onChangeText={companyname => this.setState({ companyname })}
                    value={this.state.companyname}
                    padding={8}
                    placeholderTextColor='#000'

                  >

                  </TextInput>

                </View>

                <View>
                  <Text style={mainstyles.contatus_label}>Education Qualification</Text>
                  <TextInput style={mainstyles.contatus_input} placeholder={'Education Qualification'} onChangeText={Qualification => this.setState({ Qualification })}
                    value={this.state.Qualification}
                    padding={8}
                    placeholderTextColor='#000'


                  ></TextInput>

                </View>
                <View>
                  <Text style={mainstyles.contatus_label}>Area Of Expertise Fields</Text>
                  <TextInput style={mainstyles.contatus_input} placeholder={'Area Of Expertise Fields'}
                    onChangeText={Expertise => this.setState({ Expertise })}
                    value={this.state.Expertise}
                    padding={8}
                    placeholderTextColor='#000'
                  ></TextInput>
                </View>
                <View>
                  <Text style={mainstyles.contatus_label}>Occupation</Text>
                  <TextInput style={mainstyles.contatus_input} placeholder={'Occupation'} onChangeText={Occupation => this.setState({ Occupation })}
                    value={this.state.Occupation}
                    placeholderTextColor='#000'
                    padding={8}
                  ></TextInput>

                </View>


                <View>
                  <Text style={mainstyles.contatus_label}>Address</Text>
                  <TextInput style={mainstyles.contatus_input} placeholder={'Address'} onChangeText={Address => this.setState({ Address })}
                    value={this.state.Address}
                    padding={8}
                    placeholderTextColor='#000'
                  ></TextInput>

                </View>

                <View>
                  <Text style={mainstyles.contatus_label}>Company Location</Text>
                  <TextInput style={mainstyles.contatus_input} placeholder={'Company Location'} onChangeText={company_location => this.setState({ company_location })}
                    value={this.state.company_location}
                    padding={8}
                    placeholderTextColor='#000'
                  ></TextInput>

                </View>
                <View>
                  <Text style={mainstyles.contatus_label}>State</Text>
                  <TextInput style={mainstyles.contatus_input} placeholder={'State'} onChangeText={state => this.setState({ state })}
                    value={this.state.state}
                    padding={8}
                    placeholderTextColor='#000'
                  ></TextInput>

                </View>
                <View>
                  <Text style={mainstyles.contatus_label}>District</Text>
                  <TextInput style={mainstyles.contatus_input} placeholder={'District'} onChangeText={district => this.setState({ district })}
                    value={this.state.district}
                    padding={8}
                    placeholderTextColor='#000'
                  ></TextInput>

                </View>
                <View>
                  <Text style={mainstyles.contatus_label}>Pin Code</Text>
                  <TextInput style={mainstyles.contatus_input} placeholder={'Pin Code'} onChangeText={pin => this.setState({ pin })}
                    value={this.state.pin}
                    padding={8}
                    placeholderTextColor='#000'
                  ></TextInput>

                </View>

                {/* {this.state.ProfileTag === 'ProfileExpert' ? <View style={{ margin: 5, marginLeft: 15, marginTop: 8 }}>

                <Text style={{
                  fontSize: 16,
                  color: '#BCBBBB',
                  marginLeft: 5,
                }} >Description</Text>
              </View> : null}
              {this.state.ProfileTag === 'ProfileExpert' ? <View style={{ margin: 5 }}>
                <TextInput style={{ height: 85, textAlignVertical: 'top', color: 'black', width: "90%", borderColor: '#C8C8C8', borderWidth: 1, marginLeft: 15, marginRight: 15, marginTop: 3, paddingLeft: 10 }}
                  onChangeText={description => this.setState({ description })}
                  value={this.state.description}
                  placeholderTextColor='#C7C7CD'
                ></TextInput>

              </View> : null} */}

              </View>

            </View>
          </View>
          <View style={mainstyles.submitBtnCss}>
            {this.state.ProfileTag === 'ProfileExpert' ?
              <TouchableOpacity
                onPress={() => this.Save_Edit_Expert()}

              >

                <Text style={mainstyles.submitBtnTextCss} >Save</Text>
              </TouchableOpacity> : this.state.ProfileTagEndUser === 'ProfileTagEndUser' ? <TouchableOpacity
                onPress={() => this.Save_Edit_User()}

              >

                <Text style={mainstyles.submitBtnTextCss}>Save</Text>
              </TouchableOpacity> : <TouchableOpacity
                onPress={() => this.Save_Profile()}

              >

                  <Text style={mainstyles.submitBtnTextCss}>Save</Text>
                </TouchableOpacity>}
          </View>




        </View>
      </KeyboardAwareScrollView>
    )
  }
}


