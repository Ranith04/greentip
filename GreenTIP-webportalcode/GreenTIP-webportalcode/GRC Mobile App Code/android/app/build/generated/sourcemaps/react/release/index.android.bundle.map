import React, { Component } from 'react';
import {
    StyleSheet,
    Text,
    View,
    ScrollView,
    TextInput,
    Button,
    TouchableOpacity,
    TouchableHighlight,
    Image,
    ImageBackground,
    Alert,
    StatusBar,
    ActivityIndicator,
    FlatList, Linking
} from 'react-native';
import { StackActions, NavigationActions, SafeAreaView } from 'react-navigation';
import AsyncStorage from '@react-native-community/async-storage';
import { DrawerActions } from 'react-navigation-drawer';
import { BackHandler } from 'react-native';
import Modal from 'react-native-modal';
import styles from './styles'
import { NavigationEvents } from "react-navigation";
import ProgressLoader from 'rn-progress-loader';
import Constants from '../Constants';
import Icon from 'react-native-vector-icons/FontAwesome';
import DateFilter from '../Component/dateFilter';
import mainstyles from '../Component/mainstyles';
import RenderHtml from '../Component/renderHtml';
export default class QueryDashboard extends Component {
    arrayholder;
    static navigationOptions = ({ navigation }) => {
        const count = navigation.getParam('count');
        const title = navigation.getParam('title');

        return {
            title: title,
            headerStyle: {
                backgroundColor: '#0ea457',
            },
            headerTintColor: '#FFFFFF',
            headerTitleAlign: 'center',

            headerTitleStyle: {
                fontSize: 20,

            },

            headerRight: (
                <View style={{ flexDirection: 'row' }}>
                    <View style={{ position: 'absolute', right: 10, alignSelf: 'flex-end', bottom: 15 }}>
                        <Image source={require('../imgs/inbox_icon.png')} style={{ marginRight: 10 }} />
                    </View>
                    <View style={{ position: 'absolute', right: 10, bottom: 20, alignSelf: 'flex-end', borderRadius: 15, backgroundColor: 'red', width: 18, height: 18 }}>
                        <Text style={{ color: '#FFFFFF', fontSize: 12, textAlign: 'center', fontWeight: 'bold' }}>{count}</Text>
                    </View>
                </View>
            )
        }
    }

    constructor(props) {
        super(props);
        this.arrayholder = [];
        this.handleBackButtonClick = this.handleBackButtonClick.bind(this);
        this.state = {
            isVisible: false, //state of modal default false
            isPopoverVisible: 0,
            showPop: false,
            popoverPlacement: 'left',
            isModalVisible: false,
            isModalVisible_Answer: false,
            isLoading: false,
            spinner: true,
            imgPath: '',
            query_item: '',
            enduser_i: '',
            id: '',
            DiscardReason: '',

            question_Answer: '',
            query_id_Answer: '',
            enduser_image: '',
            category_name_Answer: '',
            added_on_Answer: '',
            expert_name: '',
            answer_date: '',
            answer: '',
            expert_image: '',
            currentPage: 1,
            per_page: Constants.PerPage,
            isFirstTime: true,
            total: 0,
            answerData: '',
            dataSource:[]

        }
        //this.DashboardEndUser();
    }


    componentWillMount() {
        // this._retrieveData()
        BackHandler.addEventListener('hardwareBackPress', this.handleBackButtonClick);
        //new Common().check_intra_add();

    }


    componentWillUnmount() {
        BackHandler.removeEventListener('hardwareBackPress', this.handleBackButtonClick);
        //this._retrieveData();

        //new Common().check_intra_Re();
    }




    

    handleBackButtonClick() {
        console.log("hello_props", this.props);
        this.props.navigation.goBack(null);
        // BackHandler.exitApp();
        return true;
      }
    toggleDrawer = () => {
        //Props to open/close the drawer
        this.props.navigation.dispatch(DrawerActions.toggleDrawer());
        // this.props.navigationProps.toggleDrawer();
        //this.props.navigation.toggleDrawer()
    };

    toggleModal_Close_Answer = () => {
        this.setState({ isModalVisible_Answer: !this.state.isModalVisible_Answer });

    };
    toggleModal_Answer = (question_Answer, category_name_Answer, added_on_Answer, enduser_image, query_id_Answer, expert_name, answer_date, answer, expert_image, answerData) => {
        this.setState({ isModalVisible_Answer: !this.state.isModalVisible_Answer, question_Answer: question_Answer });
        this.setState({ enduser_image: enduser_image });
        this.setState({ query_id_Answer: query_id_Answer });
        this.setState({ category_name_Answer: category_name_Answer });
        this.setState({ added_on_Answer: added_on_Answer });
        this.setState({ expert_name: expert_name });
        this.setState({ answer_date: answer_date });
        this.setState({ answer: answer });
        this.setState({ expert_image: expert_image });
        this.setState({ answerData: answerData });



    };

    ResetData = async () => {
        console.log('resetData');
        this.setState({ date: '' });
        this.setState({ date_End: '' });
        this.setState({ currentPage: 1 });
        this.DashboardEndUser();
    
      }
    getData = (data) => {
        console.log('mydate', data);
        const newData = this.arrayholder.filter(function (item) {
    
          //applying filter for the inserted text in search bar
          return item.added_on.substring(0, item.added_on.length - 9) >= data.date && item.added_on.substring(0, item.added_on.length - 9) <= data.date_End
    
        });
        this.setState({
          //setting the filtered newData on datasource
          //After setting the data it will automatically re-render the view
          dataSource: newData,
          //search: date,
        });
      }





    DashboardEndUser = async () => {
        var type = this.props.navigation?.state.params.type;
        this.setState({ isLoading: true });

        const userIdnewww = await AsyncStorage.getItem('id')
        var params = {
            'user_id': userIdnewww,
            'response_type': type,
            'start': this.state.currentPage,
            'per_page': this.state.per_page
        };
        console.log('params', params)
        var formData = new FormData();

        for (var k in params) {
            formData.append(k, params[k]);
        }

        fetch(Constants.FullURL + '/users/dashboard', {
            method: 'POST',
            headers: {
                'authorisation': this.authorisationToken
            },
            body: formData,
        }).then((response) => response.json())

            .then((responseJson) => {
                console.log(responseJson)
                if (responseJson.status === true) {
                    const type = responseJson.data;

                    this.setState(
                        {
                            isLoading: false,
                            dataSource: this.state.currentPage == 1 ? type.queries : [...this.state.dataSource, ...type.queries],
                            total: type.total,
                            isFirstTime: (type.queries.length == 0) ? false : true
                            // imgPath: type.imagepath
                            //   total_inbox:type.total
                        },
                        function () {
                            this.arrayholder = this.state.currentPage == 1 ? type.queries : [...this.arrayholder, ...type.queries];
                        }
                    );


                    //Alert.alert(responseJson.message);

                } else if (responseJson.status === false) {
                    Alert.alert('Error', responseJson.message);
                    this.setState({ isLoading: false });
                }
            })
            .catch(error => {
                this.setState({ isLoading: false });
                console.log(error);
            })
    }
    handleLoadMore = async () => {
        console.log('load more handled');
        if (this.state.isFirstTime) {
            this.setState({
                currentPage: this.state.currentPage + 1
            })
            this.DashboardEndUser();
        }
    }
    render() {

        return (
            <SafeAreaView forceInset={{ bottom: 'never' }} style={{ flex: 1, backgroundColor: '#FFFFFF' }}>
                <View style={styles.Parent_View}>
                    <NavigationEvents
                        onDidFocus={this.DashboardEndUser}
                        onWillFocus={() => this.setState({ isLoading: false, currentPage: 1 })}
                    />
                    <ProgressLoader
                        visible={this.state.isLoading}
                        isModal={true} isHUD={true}
                        hudColor={"#00A637"}
                        style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
                        color={"#FFFFFF"} />
                    <StatusBar barStyle="dark-content" backgroundColor="#0ea457" />
                    <View style={styles.Main_View}>
                        <Modal style={styles.Margin} isVisible={this.state.isModalVisible_Answer}>
                            <SafeAreaView forceInset={{ bottom: 'never' }} style={{ flex: 1, backgroundColor: '#FFFFFF' }}>
                                <ScrollView>
                                    <View style={styles.Child_View}>
                                        <View style={styles.Image_View}>

                                            <Image source={{ uri: Constants.APIURL + 'assets/uploads/users/' + this.state.enduser_image }} style={styles.Image_Style} />
                                            <View style={styles.View_V3}>
                                                <Text style={styles.question_Answer}>{this.state.question_Answer}</Text>

                                                <Text style={styles.category_name_Answer}>Category: {this.state.category_name_Answer}</Text>
                                                <Text style={styles.Ask}>Ask: {this.state.added_on_Answer}</Text>
                                            </View>
                                            <TouchableOpacity onPress={() => { this.toggleModal_Close_Answer(); }}>
                                                <Image source={require('../imgs/close.png')} style={styles.Close} />
                                            </TouchableOpacity>
                                        </View>
                                        <View>
                                            <Text style={styles.Answer}>Answer</Text>
                                        </View>
                                        <View style={styles.View_V4}>
                                            <View style={styles.View_V5}>
                                                <Image source={{ uri: Constants.APIURL + 'assets/uploads/users/' + this.state.expert_image }} style={styles.Image_Child_View} />
                                                <View style={styles.View_V6}>

                                                    <Text style={styles.expert_name}>{this.state.expert_name}</Text>
                                                    <Text style={styles.answer_date}> {this.state.answer_date} </Text>
                                                </View>
                                            </View>
                                           {/*  <View style={styles.View_V7} >

                                                <Text style={styles.View_Answer_Scroll}>{this.state.answer}</Text>

                                            </View> */}
                                             <RenderHtml htmlText={this.state.answer}/>

                                        </View>
                                        {this.state.answerData.upload_full_image != '' && <View style={{ flex: 1, flexDirection: 'row', width: '100%', padding: '2%', }}>
                                            <View style={{ width: '50%' }}>
                                                {/* <TouchableOpacity onPress={() => Linking.openURL(this.state.adminAnswer.upload_full_image)}>
                                               <Icon name="eye" size={20} color="#00AD39" /> 
                                                    <Text style={{ color: '#00AD39', fontSize: 18 }}>Attachment</Text>
                                                </TouchableOpacity>*/}
                                            </View>
                                            <View style={{ width: '50%' }}>
                                                <TouchableOpacity onPress={() => Linking.openURL(this.state.answerData.upload_full_image)}>
                                                    <Text style={{ color: '#00AD39', fontSize: 18, textAlign: 'right' }}><Icon name="eye" size={20} color="#00AD39" /> View </Text>
                                                </TouchableOpacity>
                                            </View>
                                        </View>}

                                    </View>
                                </ScrollView>
                            </SafeAreaView>
                        </Modal>
                    </View>

                    <View style={{ backgroundColor: '#fff' }}>
                        <DateFilter getData={this.getData} ResetData={this.ResetData} />
                    </View>
                    {this.state.dataSource.length === 0 ? <View style={mainstyles.norecordFound}>
                        <Text style={mainstyles.norecordFound_Text}>No Query found here</Text>
                    </View> : null}

                    <FlatList
                        data={this.state.dataSource}
                        keyExtractor={(item) => item.id}
                        ItemSeparatorComponent={() => <View
                            style={styles.Sperator}
                        />}
                        initialNumToRender={this.state.per_page}   // how many item to display first
                        onEndReachedThreshold={0.5}
                        onEndReached={() => this.callOnScrollEnd = true}
                        onMomentumScrollEnd={() => {
                            this.callOnScrollEnd && this.handleLoadMore()
                            this.callOnScrollEnd = false
                        }}
                        bounces={false}
                        extraData={this.state}
                        renderItem={({ item }) => (
                            <View style={{ flex: 1 }}>
                                <TouchableOpacity underlayColor="#0ea457" onPress={() => {
                                    item.answerData.length != 0 ?
                                        this.toggleModal_Answer(item.query, item.category_name, item.added_on, item.enduser_image, item.query_id, item.answerData.expert_name, item.answerData.answer_date, item.answerData.answer, item.answerData.expert_image, item.answerData) : null
                                }}
                                    style={styles.Touchable}>
                                    <View style={styles.View_V_10}>

                                        <View style={styles.View_V_11}>
                                            {item.enduser_image == null ? <Image source={require('../imgs/no_image.jpg')}
                                                style={styles.Image_V} /> : <Image source={{ uri: Constants.APIURL + 'assets/uploads/users/' + item.enduser_image }} style={styles.Image_V} />}

                                            <View style={styles.View_V_12}>
                                                <Text style={styles.query_v}>{item.query}  </Text>
                                                <Text style={styles.category_name_v}>Category: {item.category_name} </Text>
                                                <Text style={styles.added_on_v}>Ask: {item.added_on} </Text>
                                                
                                                <View style={{ flexDirection: 'row', flexWrap: 'wrap' }}>
                                                    <Text style={{ fontSize: 14, color: '#000', marginLeft: 10 }}>Status:</Text>
                                                    <Text style={{ fontSize: 14, color: (item.status == 2) ? 'red' : ((item.status == 1) ? '#008000' : '#FAC564'), marginLeft: 5 }}>{(item.status == 2) ? 'Rejected' : ((item.status == 1) ? 'Completed' : 'Pending')}</Text>
                                                </View>
                                                {item.query_image != null && <View style={{ flexDirection: 'row', width: '100%', paddingBottom: '2%' }}>
                                                    <View style={{ width: '50%' }}>
                                                        {/* <TouchableOpacity onPress={() => Linking.openURL(this.state.adminAnswer.upload_full_image)}>
                                               <Icon name="eye" size={20} color="#00AD39" /> 
                                                    <Text style={{ color: '#00AD39', fontSize: 18 }}>Attachment</Text>
                                                </TouchableOpacity>*/}
                                                    </View>
                                                    <View style={{ width: '50%' }}>
                                                        <TouchableOpacity onPress={() => Linking.openURL(Constants.APIURL + item.query_image)}>
                                                            <Text style={{ color: '#00AD39', fontSize: 18, textAlign: 'right' }}><Icon name="eye" size={20} color="#00AD39" /> View </Text>
                                                        </TouchableOpacity>
                                                    </View>
                                                </View>}
                                            </View>
                                            {item.answerData.length != 0 ? <Image source={require('../imgs/forwardArr.png')} style={styles.forward_arrow} /> : null}
                                        </View>

                                    </View>
                                </TouchableOpacity>
                            </View>
                        )}
                    />
                </View>
            </SafeAreaView>

        )
    }
}




