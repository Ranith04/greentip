    constructor(props) {
        super(props);
        //setting default state
        this.forceUpdateHandler = this.forceUpdateHandler.bind(this);
        this.handleBackButtonClick = this.handleBackButtonClick.bind(this);
        this.state = { isLoading: true, search: '' };
        this.arrayholder = [];
        this.state = {
            indexChecked: [],
            indexChecked_Name: []
        };
        this.state = {
            file_name: '',
            category_name: '',
            category_id: [],
            Subject: '',
            message: '',
            email: '',
            real_Path: '',
            real_Path_uri: '',
            real_Path_name: '',
            real_Path_type: ''
        };
    }
    state = {
        checked: false,
        termsAccepted: false,
        checkedEmail: false,
        isVisible: false, //state of modal default false
        isModalVisible: false,
        checkedUser: false,
        checkedExpert: false,
        mdchecked: false,
    };

    forceUpdateHandler() {
        this.forceUpdate();
    };

    componentWillMount() {
        BackHandler.addEventListener('hardwareBackPress', this.handleBackButtonClick);
    }

    componentWillUnmount() {
        BackHandler.removeEventListener('hardwareBackPress', this.handleBackButtonClick);
    }

    handleBackButtonClick() {
        console.log("hello_props", this.props);
        this.props.navigation.goBack(null);
        // BackHandler.exitApp();
        return true;
    }

    toggleModal = () => {

        this.setState({ isModalVisible: !this.state.isModalVisible });
    };


    async componentDidMount() {
        var res = await Constants.isNetworkAvailable();
        if (!res) {
            return false;
        }
        return fetch(Constants.FullURL + '/common/industrial_categories')
            .then(response => response.json())
            .then(responseJson => {
                this.setState(
                    {
                        isLoading: false,
                        dataSource: responseJson.data,
                    },
                    function () {
                        this.arrayholder = responseJson.data;
                    }
                );
            })
            .catch(error => {
                // console.error(error);
            });
    }
    search = text => {
        console.log(text);
    };
    clear = () => {
        this.search.clear();
    };
    SearchFilterFunction(text) {
        //passing the inserted text in textinput
        const newData = this.arrayholder.filter(function (item) {
            //applying filter for the inserted text in search bar
            const itemData = item.name ? item.name.toUpperCase() : ''.toUpperCase();
            const textData = text.toUpperCase();
            return itemData.indexOf(textData) > -1;
        });
        this.setState({
            //setting the filtered newData on datasource
            //After setting the data it will automatically re-render the view
            dataSource: newData,
            search: text,
        });
    }
    ListViewItemSeparator = () => {
        //Item sparator view
        return (
            <View style={{
                height: 1,
                width: '85%',
                backgroundColor: '#ccc',
                marginLeft: '18%'
            }}
            />
        );
    };

    Add_Category = (name, id) => {
        // this.setState({
        //     category_name: name,
        //     category_id: id,
        // });

        //console.log('id',id)
        var newArray = this.state.category_id.slice();
        newArray.push(id);
        this.setState({ category_id: newArray, category_name: name })
        this.setState({ isModalVisible: !this.state.isModalVisible });
    }
    Fle_Picker = async () => {
        try {
            const res = await DocumentPicker.pick({
                type: [DocumentPicker.types.images, DocumentPicker.types.pdf, DocumentPicker.types.zip, DocumentPicker.types.allFiles],
            });
            const split = res.uri.split('/');
            const name = split.pop();
            const inbox = split.pop();
            const realPath = `${RNFS.TemporaryDirectoryPath}${inbox}/${name}`;
            this.setState({
                file_name: res.name,
                real_Path_uri: res.uri,
                real_Path_name: res.name,
                real_Path_type: res.type,
            });
            // console.log('uri', res.uri)
            // console.log('type', res.type)
            // console.log('name', res.name)
            // console.log('size', res.size)
        } catch (err) {
            if (DocumentPicker.isCancel(err)) {
                // User cancelled the picker, exit any dialogs or menus and move on
            } else {
                throw err;
            }
        }
    }
    validate_field = () => {
        const { first_name, email, message_user, isModalVisible, Check_Box, category_name, Subject, message, checkedEmail } = this.state;
        const reg = /\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,4}\b/i;
        const name_ = /^[a-zA-Z]+$/;
        // console.log('checkedEmail', checkedEmail)

        if (this.state.checked == undefined && this.state.checkedEmail == undefined && this.state.checkedUser == undefined && this.state.checkedExpert == undefined && this.state.mdchecked == undefined) {
            alert("Please select at least one checkbox")
            return false
        } else if (this.state.checkedEmail == true) {
            if (reg.test(email) === false) {
                alert("Enter Valid Email Address")
                return false
            }
            if (Subject == "") {
                alert("Please Enter Subject")
                return false
            }
            if (message == "") {
                alert("Please Enter Message")
                return false
            }
        }
        else if (this.state.checked == true) {
            if (category_name == "") {
                alert("Please select Industrial Category")
                return false
            }
            if (Subject == "") {
                alert("Please Enter Subject")
                return false
            }
            if (message == "") {
                alert("Please Enter Message")
                return false
            }
        }

        else if (this.state.checkedUser == true) {

            if (Subject == "") {
                alert("Please Enter Subject")
                return false
            }
            if (message == "") {
                alert("Please Enter Message")
                return false
            }
        }

        else if (this.state.checkedExpert == true) {

            if (Subject == "") {
                alert("Please Enter Subject")
                return false
            }
            if (message == "") {
                alert("Please Enter Message")
                return false
            }
        }
        else if (this.state.mdchecked == true) {

            if (Subject == "") {
                alert("Please Enter Subject")
                return false
            }
            if (message == "") {
                alert("Please Enter Message")
                return false
            }
        }
        // else if (this.state.checkedEmail == true) {
        //     if (Subject == "") {
        //         alert("Please Enter Subject")
        //         return false
        //     }
        // }

        // else if (this.state.checkedEmail == true) {
        //     if (message == "") {
        //         alert("Please Enter Message")
        //         return false
        //     }
        // }

        return true
    }
    Send_Email = async () => {
        if (this.validate_field()) {
            var res = await Constants.isNetworkAvailable();
            if (!res) {
                return false;
            }
            this.setState({ isLoading: true });
            var that = this;
            const userId = await AsyncStorage.getItem('id')
            const { message_user, email, Subject, message, real_Path, real_Path_uri, real_Path_name, real_Path_type, } = this.state;
            var photo = {
                uri: real_Path_uri,
                type: real_Path_type,
                name: real_Path_name
            };
            console.log('iddd', this.state.indexChecked.map(i => Number(i)))

            //console.log('photo', photo.uri)
            const formData = new FormData();
            formData.append("user_id", userId);
            if (this.state.checkedExpert == true) {
                formData.append("sent_to[0]", 'experts');
            }
            if (this.state.checkedUser == true) {
                formData.append("sent_to[1]", 'users');
            }
            if (this.state.checked == true) {
                formData.append("sent_to[2]", 'industrial_category');
            }
            formData.append("sent_to[3]", 'Admin');
            if (this.state.checkedEmail == true) {
                formData.append("sent_to[4]", 'emailid');
            }
            if (this.state.mdchecked == true) {
                formData.append("sent_to[5]", 'md');
            }
            formData.append("email", email.replace(/\s/g, ""));
            formData.append("category_id[0]", this.state.indexChecked.toString());
            formData.append("subject", Subject);
            formData.append("message", message);
            if (photo.uri != '' && photo.type != '' && photo.name != '') {
                formData.append('attachment_file', photo);
            }
            fetch(Constants.FullURL + '/users/bulkEmailNotification', {
                method: 'POST',
                headers: {
                    'Content-Type': 'multipart/form-data'
                },
                body: formData,
            }).then((response) => response.json())

                .then((responseJson) => {
                    console.log(responseJson)

                    if (responseJson.status === true) {

                        this.setState({
                            // isLoading: false,
                        });
                        // Alert.alert(responseJson.message);
                        this.setState({
                            isLoading: false,
                            file_name: '',
                            // checked: false,
                            // checkedEmail: false,
                            // checkedUser: false,
                            // checkedExpert: false,
                        });
                        //Alert.alert(responseJson.message);

                        setTimeout(() => {
                            Toast.show(responseJson.message, Toast.SHORT);
                        }, 500);


                        // const { checked } = this.state;
                        // const { checkedEmail } = this.state;
                        // const { checkedUser } = this.state;
                        // const { checkedExpert } = this.state;
                        that.setState({ checked: undefined });
                        that.setState({ checkedEmail: undefined });
                        that.setState({ checkedUser: undefined });
                        that.setState({ checkedExpert: undefined });
                        that.setState({ mdchecked: undefined });
                        that.setState({ file_name: '' });
                        that.setState({ message: '' });
                        that.setState({ Subject: '' });
                        that.setState({ real_Path_uri: '' });
                        that.setState({ real_Path_type: '' });
                        that.setState({ real_Path_name: '' });

                        //  console.log('email.trim', email.replace(/\s/g, ""))
                        //  console.log('photo.type', photo.type)
                        //  console.log('photo.name', photo.name)

                        // var photo = {
                        //     uri: '',
                        //     type: '',
                        //     name: ''
                        // };
                        // photo.uri = '';
                        // photo.type = '';
                        // photo.name = '';
                        this.forceUpdateHandler();

                    } else if (responseJson.status === false) {
                        this.setState({
                            isLoading: false,
                        });
                        Alert.alert('Error', responseJson.message);
                    }
                })
                .catch(error => {
                    this.setState({ isLoading: false });
                    // console.log('error', error);


                })
        }
    }

    checkCategory() {
        // console.log('categorysss', this.state.checked);
        this.setState({
            checked: !this.state.checked, category_name: '', category_id: [], indexChecked: [],
            indexChecked_Name: []
        });
    }

    Select_Category(id, name) {

        var indexChecked = [...this.state.indexChecked] // clone state
        var indexChecked_Name = [...this.state.indexChecked_Name] // clone state


        if (indexChecked.includes(id))
            indexChecked = indexChecked.filter(_id => _id !== id)
        else
            indexChecked.push(id)

        this.setState({ indexChecked })


        if (indexChecked_Name.includes(name))
            indexChecked_Name = indexChecked_Name.filter(_id => _id !== name)
        else
            indexChecked_Name.push(name)

        this.setState({ indexChecked_Name })

        // console.log('id', id)
        // var newArray = this.state.indexChecked.slice();
        // var newArray1 = this.state.indexChecked_Name.slice();

        // newArray.push(id);
        // newArray1.push(name);


        // this.setState({ indexChecked: newArray, indexChecked_Name: newArray1 })
    }
