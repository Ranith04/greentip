import NetInfo from "@react-native-community/netinfo";
import Toast from 'react-native-simple-toast';
export default class AppConstants {

    //static APIURL = 'http://demo.triazinesoft.com/greentip_live/'
    static APIURL = 'http://grcgreentip.com/'
    static VERSION = 'v1'
    static FullURL = this.APIURL + 'api/' + this.VERSION
    static PerPage = 10;
    static async isNetworkAvailable() {
        const response = await NetInfo.fetch();
        //console.log('myres', JSON.stringify(response));
        if (!response.isConnected && !response.isInternetReachable) {
            Toast.show('No Internet Connection!', Toast.LONG);
            return false;
        } else {
            return true;
        }
    }
    
}