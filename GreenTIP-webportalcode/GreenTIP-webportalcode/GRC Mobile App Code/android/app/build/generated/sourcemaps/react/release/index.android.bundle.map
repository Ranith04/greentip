import Constants from '../../Constants';
export default class Pending_Query_Report extends Component {


    static navigationOptions = ({ navigation }) => {
        const new_query = navigation.getParam('Pending_Query_Report');
        return {
            title: 'Pending Queries',
            headerStyle: {
                backgroundColor: '#0ea457',
            },
            headerTintColor: '#FFFFFF',
            headerTitleAlign: 'center',

            headerTitleStyle: {
                fontSize: 20,

            },

            headerRight: (
                <View style={{ flexDirection: 'row' }}>
                    <View style={{ position: 'absolute', right: 10, alignSelf: 'flex-end', bottom: 15 }}>
                        <Image source={require('../../imgs/inbox_icon.png')} style={{ marginRight: 10 }} />
                    </View>
                    <View style={{ position: 'absolute', right: 10, bottom: 20, alignSelf: 'flex-end', borderRadius: 15, backgroundColor: 'red', width: 18, height: 18 }}>
                        <Text style={{ color: '#FFFFFF', fontSize: 12, textAlign: 'center', fontWeight: 'bold' }}>{new_query}</Text>
                    </View>
                </View>
            )
        }
    }

    constructor(props) {
        super(props);
        this.toggleModal = this.toggleModal.bind(this);
        this.handleBackButtonClick = this.handleBackButtonClick.bind(this);
        this.state = {
            isVisible: false, //state of modal default false
            isPopoverVisible: 0,
            showPop: false,
            popoverPlacement: 'left',
            isModalVisible: false,
            isLoading: false,
            spinner: true,
            imgPath: '',
            query_item: '',
            enduser_i: '',
            id: '',
            DiscardReason: '',
            date: '',
            date_End: '',

            isModalVisible_Answer: false,
            question_Answer: '',
            query_id_Answer: '',
            user_image_Answer: '',
            category_name_Answer: '',
            added_on_Answer: '',
            expert_name: '',
            answer_date: '',
            answer: '',
            answer_image: '',
            array: [],
            dataSource: [],
            currentPage: 1,
            per_page: Constants.PerPage,
            isFirstTime: true,
            total: 0,



        }

    }


    toggleModal_Close = () => {
        this.setState({ isModalVisible: !this.state.isModalVisible });

    };
    toggleModal = (query, enduser_image, id) => {
        console.log('enduser_image', enduser_image)
        this.setState({ isModalVisible: !this.state.isModalVisible, query_item: query });
        this.setState({ enduser_i: enduser_image });
        this.setState({ id: id });
    };


    componentWillMount() {
        BackHandler.addEventListener('hardwareBackPress', this.handleBackButtonClick);
        this.mdPendingQueriesReports();

    }

    ResetData = async () => {
        this.setState({ date: '' });
        this.setState({ date_End: '' });
        this.setState({ currentPage: 1 });
        this.mdPendingQueriesReports();

    }

    componentWillUnmount() {
        BackHandler.removeEventListener('hardwareBackPress', this.handleBackButtonClick);
    }

    handleBackButtonClick() {
        console.log("hello_props", this.props);
        this.props.navigation.goBack(null);
        // BackHandler.exitApp();
        return true;
    }


    toggleModal_Close_Answer = () => {
        this.setState({ isModalVisible_Answer: !this.state.isModalVisible_Answer });

    };

    toggleModal_Answer = (question_Answer, category_name_Answer, added_on_Answer, user_image_Answer, query_id_Answer, answerDataValue) => {
        this.setState({ isModalVisible_Answer: !this.state.isModalVisible_Answer, question_Answer: question_Answer });
        this.setState({ user_image_Answer: user_image_Answer });
        this.setState({ query_id_Answer: query_id_Answer });
        this.setState({ category_name_Answer: category_name_Answer });
        this.setState({ added_on_Answer: added_on_Answer });
        // this.setState({ expert_name: expert_name });
        // this.setState({ answer_date: answer_date });
        // this.setState({ answer: answer });
        //this.setState({ answer_image: answer_image });
        this.setState({ array: answerDataValue });
        console.log('answer', answerDataValue);




    };
    FlatListItemSeparator = () => {
        return (
            <View
                style={{
                    height: 1,
                    width: '100%',
                    backgroundColor: '#ccc'
                }}
            />
        );
    }

    validate_field = () => {
        const { DiscardReason } = this.state;

        if (DiscardReason == "") {
            alert("Enter Valid Discard Reason")
            return false
        }
        return true
    }

    Discard_Query = async () => {
        if (this.validate_field()) {
            this.setState({ isLoading: true });
            const user_id = await AsyncStorage.getItem('id')


            var params = {
                'query_id': this.state.id,
                'user_id': user_id,
            };

            console.log('params', params)
            var formData = new FormData();

            for (var k in params) {
                formData.append(k, params[k]);
            }

            fetch(Constants.FullURL+'/users/discard_query', {
                method: 'POST',
                headers: {
                    'authorisation': this.authorisationToken
                },
                body: formData,
            }).then((response) => response.json())

                .then((responseJson) => {
                    console.log(responseJson)
                    if (responseJson.status === true) {
                        const type = responseJson.data;
                        // Alert.alert(responseJson.message);
                       // Toast.show(responseJson.message, Toast.SHORT);

                        setTimeout(() => {
                            Toast.show(responseJson.message, Toast.SHORT);
                        }, 500);

                        this.setState({ isModalVisible: !this.state.isModalVisible });

                        this.setState(
                            {
                                isLoading: false,

                            },
                            function () {
                                // this.arrayholder = type.queries;
                            }
                        );
                        // this.mdNewQueriesReports();
                    } else if (responseJson.status === false) {
                        Alert.alert('Error', responseJson.message);
                        this.setState({ isLoading: false });

                    }
                })
                .catch(error => {
                    this.setState({ isLoading: false });
                })
        }
    }

    mdPendingQueriesReports = async () => {
        this.setState({ isLoading: true });
        const userIdnewww = await AsyncStorage.getItem('id')

        var params = {
            'user_id': userIdnewww,
            'start': this.state.currentPage,
            'per_page': this.state.per_page

        };
        console.log('params', params)
        var formData = new FormData();

        for (var k in params) {
            formData.append(k, params[k]);
        }

        fetch(Constants.FullURL+'/users/mdPendingQueriesReports', {
            method: 'POST',
            headers: {
                'authorisation': this.authorisationToken
            },
            body: formData,
        }).then((response) => response.json())

            .then((responseJson) => {
                console.log(responseJson)
                if (responseJson.status === true) {
                    const type = responseJson.data;

                    this.setState(
                        {
                            isLoading: false,
                            dataSource: this.state.currentPage == 1 ? type : [...this.state.dataSource, ...type],
                            isFirstTime: (type.length == 0) ? false : true
                        },
                        function () {
                            this.arrayholder = type


                        }
                    );


                    //Alert.alert(responseJson.message);

                } else if (responseJson.status === false) {
                    Alert.alert('Error', responseJson.message);
                    this.setState({ isLoading: false });
                }
            })
            .catch(error => {
                this.setState({ isLoading: false });
                console.log(error);
            })
    }
    showPopover = (val) => {
        if (this.state.isPopoverVisible == val) {
            this.setState({ isPopoverVisible: 0 });
        } else {
            this.setState({ isPopoverVisible: val });
        }
        console.log(val);
    }

    CheckDate = (date, endDate) => {
        if (this.state.date == '') {
            alert("Please Select Start date");

        }
        else if (this.state.date_End == '') {
            alert("Please Select End date");
        }
        else if (this.state.date > this.state.date_End) {
            alert("End date should be greater than Start date");
        }
        else {

            const newData = this.arrayholder.filter(function (item) {

                //applying filter for the inserted text in search bar
                return item.asked_date.substring(0, item.asked_date.length - 9) >= date && item.asked_date.substring(0, item.asked_date.length - 9) <= endDate

            });
            this.setState({
                //setting the filtered newData on datasource
                //After setting the data it will automatically re-render the view
                dataSource: newData,
                search: date,
            });

        }

    }
    handleLoadMore = async () => {
        console.log('load more handled');
        if (this.state.isFirstTime) {
          this.setState({
            currentPage: this.state.currentPage + 1
          })
          this.mdPendingQueriesReports();
        }
    
      }
    render() {
        // if (this.state.isLoading) {
        //     return (
        //         <View style={stylesIndi.container}>
        //             <ActivityIndicator
        //                 visible={this.state.isLoading}
        //                 size="large"
        //                 color='#0ea457'
        //                 style={stylesIndi.activityIndicator} />
        //         </View>
        //     );
        // }
        return (


            <View style={{ flex: 1 }}>

                <NavigationEvents onDidFocus={this.mdPendingQueriesReports} onWillFocus={() => this.setState({ isLoading: false,currentPage:1 })} />

                <ProgressLoader
                    visible={this.state.isLoading}
                    isModal={true} isHUD={true}
                    hudColor={"#00A637"}
                    style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
                    color={"#FFFFFF"} />






                <View style={{
                    justifyContent: 'flex-start',
                    alignItems: 'flex-start'
                }}>


                    <View style={{
                        flex: 1, justifyContent: 'flex-start',
                        alignItems: 'flex-start', flexDirection: 'column'
                    }}>
                        <Modal style={{
                            margin: 0
                        }} isVisible={this.state.isModalVisible_Answer}>
                            <View style={{ flex: 1, backgroundColor: '#FFFFFF' }}>
                                <View style={{
                                    flexDirection: 'row', backgroundColor: '#FFFFFF', marginBottom: 2
                                }}>
                                    <Image source={{ uri:Constants.APIURL+'assets/uploads/users/' + this.state.user_image_Answer }} style={{
                                        width: 60, height: 60, borderRadius: 150 / 2, marginTop: 16, marginLeft: 5
                                    }} />
                                    <View style={{ flex: 1, height: '100%' }}>
                                        <Text style={{
                                            padding: 0, marginTop: 18, fontSize: 15, color: '#3C3C3C', marginLeft: 10, marginRight: 5, fontWeight: '600'
                                        }}>{this.state.question_Answer}</Text>
                                        <Text style={{
                                            fontSize: 14, color: '#ACABAB', marginLeft: 10
                                        }}>Category: {this.state.category_name_Answer}</Text>
                                        <Text style={{ paddingTop: 2, paddingBottom: 5, fontSize: 14, color: '#ACABAB', marginLeft: 10, marginBottom: 10 }}>Ask: {this.state.added_on_Answer}</Text>
                                    </View>
                                    <TouchableOpacity onPress={() => { this.toggleModal_Close_Answer(); }}>
                                        <Image source={require('../../imgs/close.png')} style={{ borderRadius: 150 / 2, marginTop: 18, marginRight: 8, alignSelf: 'flex-end', opacity: 0.5 }} />
                                    </TouchableOpacity>
                                </View>
                                <View>
                                    <Text style={{ backgroundColor: '#f4f4f4', padding: 6, paddingLeft: 10, fontSize: 16 }}>Answer</Text>
                                </View>
                                <FlatList
                                    data={this.state.array}
                                    // keyExtractor={(item) => item.id}
                                    keyExtractor={(item, index) => {
                                        return item.id;
                                    }}
                                    ItemSeparatorComponent={this.FlatListItemSeparator}
                                    extraData={this.state}
                                    renderItem={({ item }) => (
                                        <View style={{ flex: 1 }}>


                                            <View style={{ flex: 0, marginBottom: 4, backgroundColor: '#FFFFFF' }}>
                                                <View style={{ flexDirection: 'row' }}>
                                                    <Image source={{ uri:Constants.APIURL+'assets/uploads/users/' + item.expert_image }} style={{ width: 50, height: 50, borderRadius: 150 / 2, marginTop: 10, marginLeft: 5 }} />
                                                    <View style={{ flex: 1, height: '100%' }}>
                                                        <Text style={{ color: 'white', padding: 5, paddingBottom: 0, fontSize: 16, color: '#3C3C3C', marginLeft: 9, marginTop: 10, fontWeight: 'bold' }}>{item.expert_name}</Text>
                                                        <Text style={{ color: 'white', fontSize: 12, color: '#ACABAB', marginLeft: 10 }}> {item.answer_date} </Text>
                                                    </View>
                                                </View>
                                                <ScrollView>
                                                    <Text style={{ color: 'white', marginBottom: 4, paddingTop: 15, alignSelf: 'stretch', fontSize: 16, color: '#ACABAB', marginLeft: 10, textAlign: 'justify' }}>{item.answer}</Text>
                                                </ScrollView>

                                            </View>
                                        </View>



                                    )}

                                />

                            </View>

                        </Modal>
                    </View>
                </View>


                <View style={{ flex: 1, backgroundColor: '#fff' }}>



                    <View style={{ flexDirection: 'row', height: 55, borderColor: '#C8C8C8', borderBottomWidth: 1, padding: 5, justifyContent: 'center' }} >

                        <DatePicker
                            style={{ width: "25%", marginRight: 20 }}
                            date={this.state.date} //initial date from state
                            maxDate={new Date()}  //maxDate
                            mode="date" //The enum of date, datetime and time
                            placeholder="Start Date"
                            format="YYYY-MM-DD"
                            // minDate="01-01-2016"
                            // maxDate="01-01-2019"
                            confirmBtnText="Confirm"
                            cancelBtnText="Cancel"
                            customStyles={{
                                dateIcon: {
                                    width: 0,
                                    height: 0,
                                },
                                dateInput: { borderWidth: 0 }
                            }}
                            onDateChange={(date) => { this.setState({ date: date }) }}
                        />


                        <DatePicker
                            style={{ width: "25%", marginRight: 10 }}

                            date={this.state.date_End} //initial date from state
                            mode="date" //The enum of date, datetime and time
                            placeholder="End Date"
                            format="YYYY-MM-DD"
                            maxDate={new Date()}  //maxDate


                            // minDate="01-01-2016"
                            // maxDate="01-01-2019"
                            confirmBtnText="Confirm"
                            cancelBtnText="Cancel"
                            customStyles={{
                                dateIcon: {
                                    width: 0,
                                    height: 0,
                                },
                                dateInput: { borderWidth: 0 }
                            }}
                            onDateChange={(date_End) => { this.setState({ date_End: date_End }) }}

                        />
                        {/* <TouchableHighlight style={{}} underlayColor="#ffffff00"
  onPress={() => {
    this.CheckDate(this.state.date, this.state.date_End);
  }} >
  <Icon name="calendar" size={35} color="#0ea457" />
</TouchableHighlight> */}


                        <TouchableHighlight
                            style={{
                                marginRight: 5,
                                marginLeft: 1,
                                height: 35,
                                width: "20%",
                                marginTop: 1,
                                // paddingTop: 10,
                                // paddingBottom: 10,
                                backgroundColor: 'white',
                                borderRadius: 4,
                                borderWidth: 1,
                                borderColor: '#00A637'
                            }}
                            onPress={() => {
                                this.CheckDate(this.state.date, this.state.date_End);
                            }}
                            //onPress={this.ResetData()}
                            //  onPress={() => navigate('HomeScreen')}
                            underlayColor='#fff'>
                            <Text style={{
                                color: 'black',
                                fontSize: 14,
                                textAlign: 'center',
                                paddingLeft: 10,
                                paddingTop: 7,
                                paddingRight: 10
                            }}>Filter</Text>
                        </TouchableHighlight>



                        <TouchableHighlight
                            style={{
                                //   marginRight: 10,
                                marginLeft: 10,
                                // height: 35,
                                // height: 35,
                                // width: "15%",
                                //  width: "15%",
                                // marginTop: 1,
                                // paddingTop: 10,
                                // paddingBottom: 10,
                                //  backgroundColor: 'white',
                                //  borderRadius: 4,
                                //  borderWidth: 1,
                                //  borderColor: '#00A637'
                            }}
                            onPress={() => {
                                this.ResetData();
                            }}
                            //onPress={this.ResetData()}
                            //  onPress={() => navigate('HomeScreen')}
                            underlayColor='#fff'>
                            <View  >
                                <Image source={require('../../imgs/reloa.png')} style={{
                                    tintColor: '#0ea457', height: 35,
                                }} />
                            </View>
                        </TouchableHighlight>

                        {/* <TouchableHighlight
  style={{
    height: 40,
    width: 50,
    //  borderRadius:10,
    fontSize:14,
    
    marginLeft: 10,
    marginRight: 10,
    marginTop: 3
  }}>
  <Button onPress={this.ResetData()}
    title="Reset"
    fontSize={14}
    backgroundColor='#00A637'

  // accessibilityLabel="Learn more about this button"
  />
</TouchableHighlight> */}

                        {/* <TouchableHighlight underlayColor="#ffffff00" style={{ marginLeft: 10 }}

  onPress={() => {

    this.ResetData();

  }}

>
  
  <Icon name='Reload' size={35} color="#0ea457" />
</TouchableHighlight> */}
                    </View>
                    {this.state.dataSource.length === 0 ? <View style={{
                        position: 'absolute',
                        top: 0, left: 0,
                        right: 0, bottom: 0,
                        justifyContent: 'center',
                        alignItems: 'center'
                    }}>
                        <Text style={{
                            textAlign: 'center',
                            color: '#999',
                            fontSize: 16,
                            marginTop: '15%'
                        }}>No Query found here</Text>

                    </View> : null}
                    <FlatList
                        data={this.state.dataSource}
                        keyExtractor={(item) => item.id}
                        ItemSeparatorComponent={this.FlatListItemSeparator}
                        initialNumToRender={this.state.per_page}   // how many item to display first
                        onEndReachedThreshold={0.5}
                        onEndReached={() => this.callOnScrollEnd = true}
                        onMomentumScrollEnd={() => {
                          this.callOnScrollEnd && this.handleLoadMore()
                          this.callOnScrollEnd = false
                        }}
                        bounces={false}
                        extraData={this.state}
                        renderItem={({ item }) => (
                            <PopoverContainer >
                                <View style={{ flex: 1 }}>
                                    <StatusBar barStyle="dark-content" backgroundColor="#0ea457" />
                                    <View style={{ flex: 1, flexDirection: 'column', alignItems: 'center' }}>
                                        <View style={{ flexDirection: 'row', backgroundColor: '#FFFFFF' }}>
                                            {item.user_image == null ? <Image source={require('../../imgs/no_image.jpg')}
                                                style={{ alignSelf: 'center', width: 50, height: 50, borderRadius: 150 / 2, marginLeft: 15 }} /> : <Image source={{ uri:Constants.APIURL+'assets/uploads/users/' + item.user_image }} style={{ alignSelf: 'center', width: 50, height: 50, borderRadius: 150 / 2, marginLeft: 15 }} />}

                                            <View style={{ flex: 1, height: '100%' }}>
                                                <Text style={{ color: 'white', padding: 5, fontSize: 15, color: '#444', fontWeight: '600', marginLeft: 6, marginRight: 5 }}>{item.question}  </Text>


                                                <Text style={{ color: 'white', fontSize: 14, color: '#ACABAB', marginLeft: 10 }}>Category: {item.category_name} </Text>

                                                <Text style={{ color: 'white', paddingTop: 2, fontSize: 14, color: '#ACABAB', marginLeft: 10 }}>Ask: {item.asked_date} </Text>
                                                <View style={{ flexDirection: 'row', flexWrap: 'wrap', paddingBottom: 10, alignContent: 'center', marginLeft: 10 }}>
                                                    {item.status == 2 ? <Text style={{ color: 'white', fontSize: 14, color: '#ACABAB', marginTop: 2 }}>Status:</Text> : item.status == 1 ? <Text style={{ color: 'white', fontSize: 14, color: '#ACABAB', marginTop: 2 }}>Status:</Text> : item.status == 0 ? <Text style={{ color: 'white', fontSize: 14, color: '#ACABAB', marginTop: 2 }}>Status:</Text> : null}
                                                    {item.status == 2 ? <Text style={{ color: 'white', fontSize: 14, color: 'red', marginTop: 2, marginLeft: 5 }}>Rejected</Text> : item.status == 1 ? <Text style={{ color: 'white', fontSize: 14, color: '#62CB9C', marginTop: 2, marginLeft: 5 }}>Completed</Text> : item.status == 0 ? <Text style={{ color: 'white', fontSize: 14, color: '#FAC564', marginTop: 2, marginLeft: 5 }}>Pending</Text> : null}

                                                    <Text>
                                                    </Text>
                                                </View>
                                            </View>



                                        </View>
                                    </View>
                                </View>
                            </PopoverContainer>

                        )}


                    />

                </View>





            </View>

        )

    }
}

