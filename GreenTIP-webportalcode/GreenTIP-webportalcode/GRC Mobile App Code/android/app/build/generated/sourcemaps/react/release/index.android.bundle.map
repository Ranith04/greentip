                                                                    <View style={{ flexDirection: 'row', flexWrap: 'wrap', backgroundColor: '#0ea457', padding: 5, alignContent: 'center', shadowColor: '#000', shadowOffset: { width: 0, height: 1 }, shadowOpacity: 0.8, shadowRadius: 2 }}>
                                                                        <Image source={require('../../imgs/edit_white_icon.png')} style={{ marginRight: 15 }} />
                                                                        <Text style={{ color: 'white', fontSize: 15, marginRight: 20 }} >Edit</Text>
                                                                        <Text>
                                                                        </Text>
                                                                    </View>
                                                                </TouchableOpacity>


                                                                <TouchableOpacity onPress={() => {
                                                                    this.Delete_User(item.id);
                                                                }}>
                                                                    <View style={{ flexDirection: 'row', flexWrap: 'wrap', backgroundColor: '#FFFFFF', padding: 5, alignContent: 'center', shadowColor: '#000', shadowOffset: { width: 0, height: 1 }, shadowOpacity: 0.8, shadowRadius: 2 }}>
                                                                        <Image source={require('../../imgs/delete_white_icon.png')} style={{ marginRight: 15, tintColor: '#0ea457' }} />

                                                                        <Text style={{ color: 'black', fontSize: 15, marginRight: 20 }}>Delete</Text>
                                                                        <Text>
                                                                        </Text>
                                                                    </View>
                                                                </TouchableOpacity>



                                                            </View>
                                                        )}>
                                                        <TouchableOpacity onPress={() => this.showPopover(item.id)}>
                                                            <Image source={require('../../imgs/dott.png')} style={{ borderRadius: 150 / 2, marginTop: 25, marginRight: 5 }} />
                                                        </TouchableOpacity>
                                                    </Popover>


                                                </View>

                                            </View>

                                        </View>
                                    </TouchableOpacity>

                                </View>
                            </PopoverContainer>
                        )}
                    />

                </View>

                <TouchableOpacity
                    activeOpacity={0.7}
                    style={styles.TouchableOpacityStyle}
                    onPress={() => this.props.navigation.navigate('AddExpert')}>
                    <Image
                        source={{
                            uri: 'https://i.stack.imgur.com/bowrw.png',
                        }}
                        style={styles.FloatingButtonStyle}
                    />
                </TouchableOpacity>
            </View>


        )

    }
}






