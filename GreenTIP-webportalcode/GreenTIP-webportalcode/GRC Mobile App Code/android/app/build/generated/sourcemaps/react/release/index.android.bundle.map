                                                        <Text style={{ color: 'white', fontSize: 14, color: '#000', marginTop: 2, marginRight: 5, paddingLeft: 5, flexShrink: 1 }}> {item.email}</Text>
                                                        <View style={{ flexDirection: 'row', flexWrap: 'wrap', paddingBottom: 15 }}>
