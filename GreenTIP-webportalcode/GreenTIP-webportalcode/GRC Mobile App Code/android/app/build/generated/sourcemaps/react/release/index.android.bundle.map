import React, { Component } from 'react';
import {
    StyleSheet,
    Text,
    View,
    TextInput,
    Button,
    TouchableOpacity,
    TouchableHighlight,
    Image,
    ImageBackground,
    Alert,
    Icon,
    StatusBar,
    ScrollView,
    tintColor,
    BackHandler,
    FlatList, ActivityIndicator, SafeAreaView
} from 'react-native';
import { Popover, PopoverContainer } from 'react-native-simple-popover';
import Modal from 'react-native-modal';
import { createAppContainer } from 'react-navigation';
import { createStackNavigator } from 'react-navigation-stack';
import AsyncStorage from '@react-native-community/async-storage';
import { NavigationEvents } from "react-navigation";
import Spinner from 'react-native-loading-spinner-overlay';
import Constants from '../../Constants';
export default class Report_Dashboard extends Component {


    static navigationOptions = ({ navigation }) => {
        return {
            title: 'Report',
            headerStyle: {
                backgroundColor: '#0ea457',
            },
            headerTintColor: '#FFFFFF',
            headerTitleAlign: 'center',

            headerTitleStyle: {
                fontSize: 20,

            },


        }
    }

    constructor(props) {
        super(props);
        this.handleBackButtonClick = this.handleBackButtonClick.bind(this);
        this.state = {
            isVisible: false, //state of modal default false
            isPopoverVisible: 0,
            showPop: false,
            popoverPlacement: 'left',
            isModalVisible: false,
            isLoading: false,
            spinner: true,
            imgPath: '',
            query_item: '',
            enduser_i: '',
            id: '',
            DiscardReason: '',

        }

    }




    componentWillMount() {
        BackHandler.addEventListener('hardwareBackPress', this.handleBackButtonClick);
        this.Dashboard_Count()

    }

    componentWillUnmount() {
        BackHandler.removeEventListener('hardwareBackPress', this.handleBackButtonClick);
    }

    handleBackButtonClick() {
        console.log("hello_props", this.props);
        this.props.navigation.goBack(null);
        // BackHandler.exitApp();
        return true;
    }

    Dashboard_Count = async () => {
        const userId = await AsyncStorage.getItem('id');
        const formData = new FormData();
        formData.append("user_id", userId);
        fetch(Constants.FullURL + '/users/reports', {
            method: 'POST',
            body: formData,
        }).then((response) => response.json())
            .then((responseJson) => {
                if (responseJson.status === true) {
                    this.setState({ total: responseJson.data.total });
                    //AsyncStorage.setItem('count', this.state.total_inbox)
                    this.setState({ new_query: responseJson.data.new });
                    this.setState({ respond_query: responseJson.data.pending });
                    this.setState({ responded_query: responseJson.data.closed });

                } else if (responseJson.status === false) {
                    Alert.alert('Error', responseJson.message);
                    this.setState({ isLoading: false });
                }
                console.log(responseJson);
            })
            .catch((error) => {
                console.error(error);
                alert(error);
            });
    }



    render() {
        return (
            <View style={{ flex: 1 }}>
                <StatusBar barStyle="dark-content" backgroundColor="#0ea457" />
                <View style={{ height: '100%', marginTop: 20 }} >
                    <SafeAreaView>
                        <ScrollView>
                            <View style={{ flexDirection: 'column', elevation: 5, padding: 10, margin: 2, marginLeft: 15, marginTop: 10, borderBottomWidth: 4, borderBottomColor: '#69A0E2', marginRight: 15, backgroundColor: '#FFFFFF' }}>
                                <TouchableOpacity onPress={() => this.props.navigation.navigate('New_Query_Report', { 'count': this.state.new_query, 'title': 'New Queries', 'url': 'mdNewQueriesReports' }, this.props)}>
                                    <View style={{ flexDirection: 'row' }}>
                                        <Image source={require('../../imgs/new-query.png')} style={{ borderRadius: 150 / 2, width: 75, height: 75, justifyContent: 'center' }} />
                                        <View style={{ width: '75%' }}>
                                            <Text style={{ color: '#262C2F', fontSize: 30, marginLeft: 25, marginTop: 3, fontWeight: '600', textAlign: 'right', alignItems: 'flex-end' }}> {this.state.new_query} </Text>

                                        </View>
                                    </View>
                                    <Text style={{ color: '#69A0E2', fontSize: 20, marginLeft: 15, marginTop: 3, textAlign: 'right' }}>New Queries</Text>
                                </TouchableOpacity>
                            </View>

                            <View style={{ flexDirection: 'column', elevation: 5, padding: 10, margin: 2, marginLeft: 15, marginTop: 8, borderBottomWidth: 4, borderBottomColor: '#FF9D59', marginRight: 15, backgroundColor: '#FFFFFF' }}>
                                <TouchableOpacity onPress={() => this.props.navigation.navigate('New_Query_Report', { 'count': this.state.respond_query, 'title': 'Pending Queries', 'url': 'mdPendingQueriesReports'  }, this.props)}>
                                    <View style={{ flexDirection: 'row' }}>
                                        <Image source={require('../../imgs/pending-query.png')} style={{ borderRadius: 150 / 2, width: 75, height: 75 }} />
                                        <View style={{ width: '75%' }} >
                                            <Text style={{ color: '#262C2F', fontSize: 30, marginLeft: 25, marginTop: 3, fontWeight: '600', textAlign: 'right', alignItems: 'flex-end' }}> {this.state.respond_query} </Text>
                                        </View>

                                    </View>
                                    <Text style={{ color: '#FF9D59', fontSize: 20, marginLeft: 15, marginTop: 3, textAlign: 'right' }}>Pending Queries</Text>
                                </TouchableOpacity>
                            </View>

                            <View style={{ flexDirection: 'column', elevation: 5, padding: 10, margin: 2, marginLeft: 15, marginTop: 8, borderBottomWidth: 4, borderBottomColor: '#AC3DEA', marginRight: 15, backgroundColor: '#FFFFFF' }}>
                                <TouchableOpacity onPress={() => this.props.navigation.navigate('New_Query_Report', { 'count': this.state.responded_query, 'title': 'Closed Queries', 'url': 'mdClosedQueriesReports' }, this.props)}>
                                    <View style={{ flexDirection: 'row' }}>
                                        <Image source={require('../../imgs/closed-query.png')} style={{ borderRadius: 150 / 2, width: 75, height: 75 }} />
                                        <View style={{ width: '75%' }} >
                                            <Text style={{ color: '#262C2F', fontSize: 30, marginLeft: 25, marginTop: 3, fontWeight: '600', textAlign: 'right', alignItems: 'flex-end' }}> {this.state.responded_query} </Text>
                                        </View>
                                    </View>
                                    <Text style={{ color: '#AC3DEA', fontSize: 20, marginLeft: 15, marginTop: 3, textAlign: 'right' }}>Closed Queries</Text>
                                </TouchableOpacity>
                            </View>

                            <View style={{ flexDirection: 'column', elevation: 5, padding: 10, margin: 2, marginLeft: 15, marginTop: 8, borderBottomWidth: 4, borderBottomColor: '#24BA71', marginRight: 15, backgroundColor: '#FFFFFF' }}>
                                <TouchableOpacity onPress={() => this.props.navigation.navigate('New_Query_Report', { 'count': this.state.total ,'title': 'Total Queries', 'url': 'mdTotalQueriesReports'}, this.props)}>
                                    <View style={{ flexDirection: 'row' }}>
                                        <Image source={require('../../imgs/total-query.png')} style={{ borderRadius: 150 / 2, width: 75, height: 75 }} />
                                        <View style={{ width: '75%' }} >
                                            <Text style={{ color: '#262C2F', fontSize: 30, marginLeft: 25, marginTop: 3, fontWeight: '600', textAlign: 'right', alignItems: 'flex-end' }}> {this.state.total} </Text>
                                        </View>
                                    </View>
                                    <Text style={{ color: '#24BA71', fontSize: 20, marginLeft: 15, marginTop: 3, textAlign: 'right' }}>Total Queries</Text>
                                </TouchableOpacity>
                            </View>
                        </ScrollView>
                    </SafeAreaView>
                </View>
            </View>
        )
    }
}

