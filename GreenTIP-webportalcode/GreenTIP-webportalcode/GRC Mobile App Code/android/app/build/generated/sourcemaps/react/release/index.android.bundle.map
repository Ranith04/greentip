import React, { Component } from 'react';
import {
  StyleSheet,
  Text,
  View,
  TextInput,
  TouchableOpacity,
  TouchableHighlight,
  Image,
  Alert,
  StatusBar,
  BackHandler,
  FlatList,
  ActivityIndicator
} from 'react-native';
import DatePicker from 'react-native-datepicker';
import Icon from 'react-native-vector-icons/FontAwesome';
import Toast from 'react-native-simple-toast';
import { Popover, PopoverContainer } from 'react-native-simple-popover';
import AsyncStorage from '@react-native-community/async-storage';
import { NavigationEvents } from "react-navigation";
import ProgressLoader from 'rn-progress-loader';
import Constants from '../../Constants';
import DateFilter from '../../Component/dateFilter';
import mainstyles from '../../Component/mainstyles';
import ViewDownload from '../../Component/viewDownload';
export default class MD_NewQuery extends Component {

  static navigationOptions = ({ navigation }) => {
    const all_query = navigation.getParam('all_query');
    const answered_query = navigation.getParam('answered_query');
    const unanswered_query = navigation.getParam('unanswered_query');
    if (all_query) { var title = 'New Query' } else if (answered_query) { var title = 'Answered Query' } else { var title = 'UnAnswered Query' }
    return {
      title: title,
      headerStyle: {
        backgroundColor: '#0ea457',
      },
      headerTintColor: '#FFFFFF',
      headerTitleAlign: 'center',

      headerTitleStyle: {
        fontSize: 20,
      },

      headerRight: (
        <View style={{ flexDirection: 'row' }}>
          <View style={{ position: 'absolute', right: 10, alignSelf: 'flex-end', bottom: 15 }}>
            <Image source={require('../../imgs/inbox_icon.png')} style={{ marginRight: 10 }} />
          </View>
          <View style={{ position: 'absolute', right: 10, bottom: 20, alignSelf: 'flex-end', borderRadius: 15, backgroundColor: 'red', width: 18, height: 18 }}>
            {all_query ?
              <Text style={{ color: '#FFFFFF', fontSize: 12, textAlign: 'center', fontWeight: 'bold' }}>{all_query}</Text>
              : answered_query ?
                <Text style={{ color: '#FFFFFF', fontSize: 12, textAlign: 'center', fontWeight: 'bold' }}>{answered_query}</Text>
                : unanswered_query ?
                  <Text style={{ color: '#FFFFFF', fontSize: 12, textAlign: 'center', fontWeight: 'bold' }}>{unanswered_query}</Text>
                  : null}
          </View>
        </View>
      )
    }
  }

  constructor(props) {
    super(props);
    this.handleBackButtonClick = this.handleBackButtonClick.bind(this);
    this.state = {
      isVisible: false, //state of modal default false
      isPopoverVisible: 0,
      showPop: false,
      popoverPlacement: 'left',
      isModalVisible: false,
      isLoading: false,
      spinner: true,
      imgPath: '',
      query_item: '',
      enduser_i: '',
      id: '',
      DiscardReason: '',
      date: '',
      date_End: '',
      dataSource: [],
      currentPage: 1,
      per_page: Constants.PerPage,
      isFirstTime: true,
      total: 0,
    }

  }

  componentWillMount() {
    BackHandler.addEventListener('hardwareBackPress', this.handleBackButtonClick);
    this.DashboardDataNewQuery();

  }

  componentWillUnmount() {
    BackHandler.removeEventListener('hardwareBackPress', this.handleBackButtonClick);
  }

  ResetData = async () => {
    this.setState({ date: '' });
    this.setState({ date_End: '' });
    this.setState({ currentPage: 1 });
    this.DashboardDataNewQuery();

  }

  handleBackButtonClick() {
    console.log("hello_props", this.props);
    this.props.navigation.goBack(null);
    // BackHandler.exitApp();
    return true;
  }

  FlatListItemSeparator = () => {
    return (
      <View
        style={{
          height: 1,
          width: '100%',
          backgroundColor: '#ccc'
        }}
      />
    );
  }

  validate_field = (id) => {
    Alert.alert(
      'Alert',
      'Are you sure you want to discard this query ?',
      [
        {
          text: 'DISCARD',
          onPress: () => this.Discard_Query(id)
        },
        {
          text: 'CANCEL',
          onPress: () => console.log('Cancel Pressed')
        }
      ],
      { cancelable: false }
    )
  }

  Discard_Query = async (queryID) => {
    this.setState({ isLoading: true });
    const user_id = await AsyncStorage.getItem('id')
    var params = {
      'query_id': queryID,
      'user_id': user_id,
    };

    console.log('params', params)
    var formData = new FormData();

    for (var k in params) {
      formData.append(k, params[k]);
    }


    fetch(Constants.FullURL+'/users/discard_query', {
      method: 'POST',
      headers: {
        'authorisation': this.authorisationToken
      },
      body: formData,
    }).then((response) => response.json())

      .then((responseJson) => {
        console.log(responseJson)
        if (responseJson.status === true) {
          const type = responseJson.data;
          // Alert.alert(responseJson.message);
        //  Toast.show(responseJson.message, Toast.SHORT);

          setTimeout(() => {
            Toast.show(responseJson.message, Toast.SHORT);
        }, 500);


          this.setState(
            {
              isLoading: false,

            },
            function () {
              // this.arrayholder = type.queries;
            }
          );
          this.setState({ currentPage: 1 });
          this.DashboardDataNewQuery();
        } else if (responseJson.status === false) {
          Alert.alert('Error', responseJson.message);
          this.setState({ isLoading: false });

        }
      })
      .catch(error => {
        this.setState({ isLoading: false });
      })
  }

  DashboardDataNewQuery = async () => {
    this.setState({ isLoading: true });
    const userIdnewww = await AsyncStorage.getItem('id')
    const nav = this.props.navigation.state.params;
    if (nav.all_query) {
      var params = { 'user_id': userIdnewww, 'response_type': 'expert', 'start': this.state.currentPage,'per_page': this.state.per_page };
    } else if (nav.answered_query) {
      var params = { 'user_id': userIdnewww, 'response_type': 'answered_expert', 'start': this.state.currentPage,'per_page': this.state.per_page };
    } else {
      var params = { 'user_id': userIdnewww, 'response_type': 'unanswered_expert', 'start': this.state.currentPage,'per_page': this.state.per_page };
    }

    console.log('params', params)
    var formData = new FormData();

    for (var k in params) {
      formData.append(k, params[k]);
    }

    fetch(Constants.FullURL+'/users/dashboard', {
      method: 'POST',
      body: formData,
    }).then((response) => response.json())

      .then((responseJson) => {
        console.log(responseJson)
        if (responseJson.status === true) {
          const type = responseJson.data;
          console.log('type', type)

          this.setState(
            {
              isLoading: false,
              dataSource: this.state.currentPage == 1 ? type.queries : [...this.state.dataSource, ...type.queries],
              imgPath: Constants.APIURL+'assets/uploads/users/',
              total: type.total,
              isFirstTime: (type.queries.length == 0) ? false : true
            },
            function () {
              this.arrayholder = type.queries;
            }
          );

        } else if (responseJson.status === false) {
          Alert.alert('Error', responseJson.message);
          this.setState({ isLoading: false });
        }
      })
      .catch(error => {
        this.setState({ isLoading: false });
        console.log(error);
      })
  }
  showPopover = (val) => {
    if (this.state.isPopoverVisible == val) {
      this.setState({ isPopoverVisible: 0 });
    } else {
      this.setState({ isPopoverVisible: val });
    }
    console.log(val);
  }
  responseAnswer = (item) => {
    if (item.status == 1) {
      this.props.navigation.navigate('MD_Respond', { 'userData': item });
    }
  }

 
  getData = (data) => {
    console.log('mydate', data.date);
    const newData = this.arrayholder.filter(function (item) {

      //applying filter for the inserted text in search bar
      return item.added_on.substring(0, item.added_on.length - 9) >= data.date && item.added_on.substring(0, item.added_on.length - 9) <= data.date_End

    });
    this.setState({
      dataSource: newData,

    });
  }
  handleLoadMore = async () => {
    console.log('load more handled');
    if (this.state.isFirstTime) {
      this.setState({
        currentPage: this.state.currentPage + 1
      })
      this.DashboardDataNewQuery();
    }

  }

  render() {
    // if (this.state.isLoading) {
    //   return (
    //     <View style={stylesIndi.container}>
    //       <ActivityIndicator
    //         visible={this.state.isLoading}
    //         size="large"
    //         color='#0ea457'
    //         style={stylesIndi.activityIndicator} />
    //     </View>
    //   );
    // }


    return (
      <View style={{ flex: 1 }}>
        <NavigationEvents onDidFocus={this.DashboardDataNewQuery} onWillFocus={() => this.setState({ isLoading: false , currentPage: 1})} />

        <ProgressLoader
          visible={this.state.isLoading}
          isModal={true} isHUD={true}
          hudColor={"#00A637"}
          style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
          color={"#FFFFFF"} />

        <View style={{ flex: 1, backgroundColor: '#fff' }}>

        <View style={{ backgroundColor: '#fff' }}>
          <DateFilter getData={this.getData} ResetData={this.ResetData} />
        </View>

        {this.state.dataSource.length === 0 ? <View style={mainstyles.norecordFound}>
          <Text style={mainstyles.norecordFound_Text}>No Query found here</Text>
        </View> : null}
        <FlatList
            data={this.state.dataSource}
            keyExtractor={(item) => item.id}
            ItemSeparatorComponent={this.FlatListItemSeparator}
            initialNumToRender={this.state.per_page}   // how many item to display first
            onEndReachedThreshold={0.5}
            onEndReached={() => this.callOnScrollEnd = true}
            onMomentumScrollEnd={() => {
              this.callOnScrollEnd && this.handleLoadMore()
              this.callOnScrollEnd = false
            }}
            bounces={false}
            extraData={this.state}
            renderItem={({ item }) => (
              <PopoverContainer>
                <View style={{ flex: 1 }}>
                  <StatusBar barStyle="dark-content" backgroundColor="#0ea457" />
                  <TouchableOpacity style={{ flex: 1, flexDirection: 'column', alignItems: 'center' }} onPress={() => this.responseAnswer(item)}>
                    <View style={{ flexDirection: 'row', backgroundColor: '#FFFFFF', paddingTop: 8, paddingBottom: 8 }}>

                      {item.user_image ? <Image source={{ uri: this.state.imgPath + item.user_image }} style={{ alignSelf: 'center', width: 50, height: 50, borderRadius: 150 / 2, marginLeft: 15 }} />
                        : <Image source={require('../../imgs/no_image.jpg')} style={{ alignSelf: 'center', width: 50, height: 50, borderRadius: 150 / 2, marginLeft: 15 }} />}
                      <View style={mainstyles.right_container}>
                        {item.question ? <Text  style={mainstyles.query}>{item.question}</Text> : null}
                        {item.category_name ? <Text  style={mainstyles.category_ask}>Category: {item.category_name} </Text> : <Text style={{ paddingBottom: 0, margin: 0 }}></Text>}
                        {item.added_on ? <Text  style={mainstyles.category_ask}>Ask: {item.added_on} </Text> : null}
                        {item.name ? <Text  style={mainstyles.category_ask}>Asked By: {item.name} </Text> : null}
                        {item.status == 2 ? <View style={{ flexDirection: 'row', flexWrap: 'wrap', paddingBottom: 15 }}>
                          <Text style={{ color: 'white', fontSize: 14, color: '#000', marginLeft: 10, paddingLeft: 0 }}>Status:</Text>
                          <Text style={{ color: 'white', fontSize: 14, color: 'red', marginLeft: 5 }}>Rejected</Text>
                        </View> : null}
                        {item.query_image != null &&  <ViewDownload itemData={item?item:''}/>}
                      </View>
                      {item.status == 1 ? <Image source={require('../../imgs/forwardArr.png')} style={{ alignSelf: 'center', borderRadius: 150 / 2, marginRight: 5 }} /> : null}



                      <View style={styles.container}>
                        {item.status == 0 ? <Popover placement={this.state.popoverPlacement} isVisible={this.state.isPopoverVisible === item.id} component={() => (
                          <View style={{ borderColor: 'black', elevation: 5, margin: 2, backgroundColor: '#FFFFFF', marginRight: -10, marginTop: 10, shadowColor: '#000', shadowOffset: { width: 0, height: 1 }, shadowOpacity: 0.8, shadowRadius: 2 }} >
                            <TouchableHighlight underlayColor="#0ea45701" style={{ borderBottomWidth: 1, borderBottomColor: '#ccc', elevation: 0.5 }} onPress={() => this.props.navigation.navigate('MD_Respond', { 'userData': item })}>
                              <Text style={{ backgroundColor: '#fff', padding: 8, color: '#000', fontSize: 15, paddingRight: 20 }} > Respond </Text>
                            </TouchableHighlight>
                            <TouchableOpacity onPress={() => {
                              this.validate_field(item.query_id);
                            }}>
                              <Text style={{ backgroundColor: '#FFFFFF', color: 'black', padding: 8, fontSize: 15 }}> Discard  </Text>
                            </TouchableOpacity>
                          </View>
                        )}>
                          <TouchableOpacity onPress={() => this.showPopover(item.id)}>
                            <Image source={require('../../imgs/dott.png')} style={{ borderRadius: 150 / 2, marginTop: 12, marginRight: 5 }} />
                          </TouchableOpacity>
                        </Popover> : null}
                      </View>
                    
                    </View>
                  </TouchableOpacity>
                </View>
              </PopoverContainer>
            )} />
        </View>
      </View>
    )
  }
}

const stylesIndi = StyleSheet.create({
  container: {
    flex: 1,
    justifyContent: 'center',
    alignItems: 'center',
    marginTop: 70
  },
  activityIndicator: {
    flex: 1,
    justifyContent: 'center',
    alignItems: 'center',
    height: 80
  }
})

const styles = StyleSheet.create({
  container: {
    justifyContent: 'flex-start',
    alignItems: 'flex-start',
  },
  input: {
    margin: 2,
    height: 100,
    borderColor: '#EEEEEE',
    borderWidth: 1,
    marginBottom: 30,
    marginTop: 20,
    marginLeft: 20,
    textAlignVertical: 'top',
    width: '90%',
    color: 'black',
  },
  buttonContainer: {
    height: 50,
    flexDirection: 'row',
    justifyContent: 'center',
    alignItems: 'center',
    width: '100%',
    borderRadius: 3,
  },
  loginButton: {
    backgroundColor: "#00AD39",
    justifyContent: 'center',
  }
});