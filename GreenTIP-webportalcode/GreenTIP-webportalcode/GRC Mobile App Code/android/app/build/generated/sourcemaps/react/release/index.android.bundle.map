export default class Drawermenu extends React.Component {
  constructor(props) {
    super(props);
    // console.log('huy',this.props);
    this.state = {
      sideMenu: '',
      collapsed: true,
      userName: '',
      userImg: '',
      image: '',
      total_inbox: '',
      menuimage: '',
    }
  }
  toggleExpanded = () => {
    //Toggling the state of single Collapsible
    this.setState({ collapsed: !this.state.collapsed });
  };


  componentDidMount = async () => {
    //  setInterval(() => this.setState({ time: Date.now()}), 1000)
    this._retrieveData()
    setInterval(this._retrieveData, 1000);
  }
  // componentWillMount = async () => {
  //   //  setInterval(() => this.setState({ time: Date.now()}), 1000)
  //   this._retrieveData()
  //   setInterval(this._retrieveData, 1000);
  // }
  _removeData = () => {
    this.props.navigation.dispatch(DrawerActions.closeDrawer());
    Alert.alert(
      'Confirm Logout',
      'Are you sure you want to log out?',
      [
        {
          text: 'CANCEL',
        },
        {
          text: 'LOGOUT',
          onPress: () => this.logout()
        }
      ],
      {
        cancelable: false
      }
    )
  };

  logout = async () => {
    try {
      await AsyncStorage.removeItem('role_type');
      await AsyncStorage.removeItem('userName');
      await AsyncStorage.removeItem('email');
      await AsyncStorage.removeItem('contact_no');
      this.props.navigation.navigate('Login');
    } catch (error) {
      // Error retrieving data
      console.log(error.message);
    }
  }
  _retrieveData = async () => {
    try {
      const namemenu = await AsyncStorage.getItem('role_type')
      const userName = await AsyncStorage.getItem('userName');
      const userImg = await AsyncStorage.getItem('userImg');
      const menuimage = await AsyncStorage.getItem('userimage')
      const total_inbox = await AsyncStorage.getItem('total_inbox')

      //console.log("menuimage",image)
      if (total_inbox !== null) {
        this.setState({ total_inbox: JSON.parse(total_inbox) });

        //console.log('count',total_inbox)


      }

      this.setState({ userName: userName });
      this.setState({ userImg: userImg });
      this.setState({ sideMenu: namemenu });
      this.setState({ menuimage: menuimage });

      // console.log('menuimage', menuimage)

    } catch (e) {
      // alert('Failed to load name.')
    }
  };

