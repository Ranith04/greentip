import React from 'react';
import {
  StyleSheet,
  Text,
  View,
  TextInput,
  Button,
  TouchableHighlight,
  Image,
  ImageBackground,
  Alert,
  TouchableOpacity,
  ActivityIndicator, BackHandler
} from 'react-native';
import { StackActions, NavigationActions, SafeAreaView } from 'react-navigation';
import { DrawerActions } from 'react-navigation-drawer';
import Toast from 'react-native-simple-toast';
import { TextInputLayout } from 'rn-textinputlayout';
import ProgressLoader from 'rn-progress-loader';
import Constants from '../Constants';
export default class ForgotPassword extends React.Component {
  static navigationOptions = {
    header: null,
  };
  toggleDrawer = () => {
    //Props to open/close the drawer
    this.props.navigation.dispatch(DrawerActions.toggleDrawer());
    // this.props.navigationProps.toggleDrawer();
    //this.props.navigation.toggleDrawer()
  };
  constructor(props) {
    super(props);
    console.log("constructor props", props);
    this.handleBackButtonClick = this.handleBackButtonClick.bind(this);
    this.state = {
      userEmail: '',
    }
  }
  componentWillMount() {
    BackHandler.addEventListener('hardwareBackPress', this.handleBackButtonClick);
  }
  componentWillUnmount() {
    BackHandler.removeEventListener('hardwareBackPress', this.handleBackButtonClick);
  }
  handleBackButtonClick() {
    //console.log("hello_props", this.props);
    this.props.navigation.goBack(null);
    // BackHandler.exitApp();
    return true;
  }
  validate_field = () => {
    const { userEmail } = this.state;
    const reg = /^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/;

    if (reg.test(userEmail) === false) {
        alert("Enter Valid Email Address")
        return false
    } 
    return true
}
  async forgotPass() {
    if (this.validate_field()) {
    
    const { userEmail } = this.state;
    const formData = new FormData();
    formData.append("email", userEmail);
    var res = await Constants.isNetworkAvailable();
      if (!res) {
        return false;
      }
     // this.setState({ isLoading: true });

    //console.log(JSON.stringify(formData));
    fetch(Constants.FullURL+'/authentication/forgot_password', {
      method: 'POST',
      body: formData,
    }).then((response) => response.json())
      .then((responseJson) => {
        // If server response message same as Data Matched
       // console.log(responseJson);
        if (responseJson.status == true) {
          // Alert.alert('Success',responseJson.message);
         // this.setState({ isLoading: false });
         // Toast.show(responseJson.message, Toast.LONG);
          setTimeout(() => {
            Toast.show(responseJson.message, Toast.SHORT);
        }, 500);
        } else {            
          Alert.alert('Alert', responseJson.message);
         // this.setState({ isLoading: false });
        }
      }
      ).catch((error) => {
      //  Alert.alert('Alert', error);
     // this.setState({ isLoading: false });
      });
  }
}
  render() {
    return (
      <SafeAreaView forceInset={{ bottom: 'never' }} style={{ flex: 1, backgroundColor: '#EAFCFD' }}>
        <View style={{ flex: 1 }}>
        <ProgressLoader
visible={this.state.isLoading}
isModal={true} isHUD={true}
hudColor={"#00A637"}
style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
color={"#FFFFFF"} />
          <ImageBackground style={{ width: '100%', height: '100%' }} resizeMode='stretch' source={require('../imgs/login-bg.png')} >
            <TouchableOpacity onPress={this.toggleDrawer.bind(this)}>
              <Image style={{ marginLeft: 20, marginTop: 20 }} resizeMode='contain' source={require('../imgs/menu_icon_for_login_screen.png')} />
            </TouchableOpacity>
            <Text style={{ color: 'black', justifyContent: 'flex-start', alignItems: 'flex-start', marginTop: 50, marginLeft: 30, fontSize: 24 }}>Forgot Password</Text>
            <View style={{ height: 0, width: 70, borderTopColor: '#fb7524', borderTopWidth: 3, marginTop: 10, marginLeft: 30 }}></View>

            <View style={styles.container}>
              <View style={{}}>
                <TextInputLayout style={{ marginHorizontal: 36 }}>
                  <TextInput style={{ fontSize: 16, height: 40, color: 'black' }} placeholder={'Email address *'} placeholderTextColor='#000' onChangeText={(userEmail) => this.setState({ userEmail })} />
                </TextInputLayout>
              </View>

              {/* <View style={{ justifyContent: "center", alignItems: "center" }}>
                {this.state.isLoading && <ActivityIndicator size="large" color={"#00AD39"} />}
              </View> */}

              <TouchableHighlight style={[styles.buttonContainer, styles.forgotButton]} onPress={() => this.forgotPass()}>
                <Text style={styles.forgotText}>SUBMIT</Text>
              </TouchableHighlight>

              <View style={{ flexDirection: 'row', marginTop: 20, alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ color: '#000', fontSize: 14, marginTop: 2, alignItems: 'center' }}>Not have an account?</Text>
                <Text style={{ color: '#00AD39', fontSize: 14, marginTop: 2, alignItems: 'center' }} onPress={() => this.props.navigation.navigate('SignUp')}> Sign Up</Text>
              </View>

              <View style={{ flexDirection: 'row', marginTop: 20, alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ color: '#000', fontSize: 14, marginTop: 2, alignItems: 'center' }}>OR</Text>
              </View>
              <View style={{ flexDirection: 'row', marginTop: 20, alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ color: '#000', fontSize: 14, marginTop: 2, alignItems: 'center' }}>Return to</Text>
                <Text style={{ color: '#00AD39', fontSize: 14, marginTop: 2, alignItems: 'center' }} onPress={() => this.props.navigation.navigate('Login')}> Login</Text>
              </View>
            </View>
          </ImageBackground>
        </View>
      </SafeAreaView>
    );
  }
};
const styles = StyleSheet.create({
  logoImg: {
    width: 70 + '%',
    height: 20 + '%',
    marginTop: 15 + '%',
    marginBottom: 5 + '%',
    marginLeft: 15.5 + '%'
  },
  buttonContainer: {
    height: 45,
    flexDirection: 'row',
    justifyContent: 'center',
    alignItems: 'center',
    marginBottom: 10,
    width: '80%',
    marginLeft: 40,
    borderRadius: 3,
  },
  forgotButton: {
    backgroundColor: "#00AD39",
    marginTop: 30,
    justifyContent: 'center',
  },
  forgotText: {
    color: 'white',
    fontSize: 16,
    fontWeight: 'bold',

  }
});