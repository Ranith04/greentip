import React, { Component } from 'react';
import {
    StyleSheet,
    Text,
    View,
    ScrollView,
    TextInput,
    Button,
    TouchableOpacity,
    TouchableHighlight,
    Image,
    ImageBackground,
    Alert
} from 'react-native';
import styles from './styles'
import { StackActions, NavigationActions, SafeAreaView } from 'react-navigation';
import AsyncStorage from '@react-native-community/async-storage';
import { DrawerActions } from 'react-navigation-drawer';
import { BackHandler } from 'react-native';
import { NavigationEvents } from "react-navigation";
import Constants from '../Constants';

export default class Expert_Dashboard extends Component {
    static navigationOptions = {
        header: null,
    };

    componentDidMount() {
        const { navigation } = this.props;
        this.setState({ image: navigation.getParam('image') });
      
        console.log('imkkkkkk', navigation.getParam('image'));

    }

    componentWillMount() {
        this.getData()
        this._retrieveData()
        BackHandler.addEventListener('hardwareBackPress', this.handleBackButton);

        //new Common().check_intra_add();
    }

    componentWillUnmount() {
        BackHandler.removeEventListener('hardwareBackPress', this.handleBackButton);
        this._retrieveData();
        //new Common().check_intra_Re();
    }
    _removeData = async () => {
        try {
           /*  await AsyncStorage.removeItem('role_type');
            await AsyncStorage.removeItem('userName');
            await AsyncStorage.removeItem('email');
            await AsyncStorage.removeItem('contact_no'); */
            BackHandler.exitApp()
        } catch (error) {
            // Error retrieving data
            console.log(error.message);
        }

    };

    handleBackButton = () => {
        Alert.alert(
          'Exit App',
          'Are you sure you want to exit?', [{
            text: 'CANCEL',
            onPress: () => console.log('Cancel Pressed'),
            style: 'cancel'
          },
          {
            text: 'EXIT',
            onPress: () => {this._removeData()}
          },],
          {
            cancelable: false
          }
        )
        return true;
      }

    onButtonPress = () => {
        BackHandler.removeEventListener('hardwareBackPress', this.handleBackButton);
        // then navigate

    }

    toggleDrawer = () => {
        //Props to open/close the drawer
        this.props.navigation.dispatch(DrawerActions.toggleDrawer());
        // this.props.navigationProps.toggleDrawer();
        //this.props.navigation.toggleDrawer()
    };

    state = {
        total_inbox: '',
        All_query: '',
        answered_query: '',
        unanswered_query: '',
        userName: '',
        userImg: '',
        image: ''

    }





    _storeData = async (total_inbox) => {
        try {
            await AsyncStorage.setItem('total_inbox', total_inbox);
            console.log('total_inbox', total_inbox)
            //alert(userImg);
            // alert('_storeData')

        } catch (error) {
            // Error saving data
        }
    };

    _retrieveData = async () => {
        try {
            const name = await AsyncStorage.getItem('role_type');
            //Alert.alert(this.state.userName);
            if (name !== null) {
                // this.setState({ name })
                // alert('okay.')
            }
        } catch (e) {
            // alert('Failed to load name.')
        }
    };

    getData = async () => {
        try {
            const userName = await AsyncStorage.getItem('userName');
            const userImg = await AsyncStorage.getItem('userimage');
            this.setState({ userName: userName });
            this.setState({ userImg: userImg });
            this.Dashboard_Count();
        } catch (e) {
            alert(e);
        }
    }

    Dashboard_Count = async () => {
        const userId = await AsyncStorage.getItem('id')

        const formData = new FormData();
        formData.append("user_id", userId);
        fetch(Constants.FullURL+'/users/count_dashboard', {
            method: 'POST',
            body: formData,
        }).then((response) => response.json())
            .then((responseJson) => {
                console.log(responseJson);
                if (responseJson.status === true) {
                    this.setState({ total_inbox: responseJson.data.total_inbox });
                    AsyncStorage.setItem('count', this.state.total_inbox)
                    this.setState({ All_query: responseJson.data.all });
                    this.setState({ answered_query: responseJson.data.answered_query });
                    this.setState({ unanswered_query: responseJson.data.unanswered_query });
                    this._storeData(JSON.stringify(responseJson.data.total_inbox))

                } else if (responseJson.status === false) {
                    Alert.alert('Error', responseJson.message);
                    this.setState({ isLoading: false });
                }
                console.log(responseJson);
            })
            .catch((error) => {
                console.error(error);
                alert(error);
            });
    }

    constructor(props) {
        super(props);
        this._retrieveData();
        //Alert.alert('res',this.props.navigation.state.params.name);
    }

    render() {
        return (
            <SafeAreaView forceInset={{ bottom: 'never' }} style={{ flex: 1 }}>
                 {Platform.OS === 'ios' &&
 <View style={{
     width: "100%",
     height: 100, // For all devices, even X, XS Max
     position: 'absolute',
     top: 0,
     left: 0,
     backgroundColor: "#0ea457"}}
/>}

                <View style={styles.Parent_View_Dash}>
                    <NavigationEvents
                        onDidFocus={this.getData}
                        onWillFocus={() => this.setState({ isLoading: false })}

                    />
                    <ImageBackground source={require('../imgs/bgg.png')} style={styles.bg_Dash}>
                        <View style={styles.View_v1_Dash}>
                            <TouchableOpacity onPress={this.toggleDrawer.bind(this)}>
                                <Image source={require('../imgs/menu_dash.png')} style={styles.menu_dash_Dash} />
                            </TouchableOpacity>

                        </View>

                        <View style={styles.MainContainer_dash}>
                            {/* <Image source={{ uri: this.state.image}}
                            style={styles.image_dash} /> */}

                            {this.state.userImg != null && this.state.userImg != "" ? <Image source={{ uri: this.state.userImg }} style={styles.image_dash} /> : <Image source={require('../imgs/no_image.jpg')} style={styles.image_dash} />}
                            

                            {/* {this.state.image == null ? <Image source={require('../imgs/no_image.jpg')}
                                style={styles.image_dash} /> : <Image source={{ uri: this.state.image }} style={styles.image_dash} />} */}
                        </View>

                        <View style={styles.View_v4_Dash}>
                            <Text style={styles.tv_welcome_Dash}>Welcome</Text>
                        </View>

                        <View style={styles.View_v5_Dash}>
                            <Text style={styles.user_tv_dash}>{this.state.userName}</Text>
                        </View>
                    </ImageBackground>
                    <View style={styles.View_v6_Dash} >
                        <SafeAreaView>
                            <ScrollView>
                                <View style={styles.View_v7_Dash}>
                                    <TouchableOpacity onPress={() => this.props.navigation.navigate('All_Query', { 'All_Query': this.state.All_query }, this.props)}>
                                        <View style={styles.View_v8_Dash}>
                                            <Image source={require('../imgs/new_query.png')} style={styles.image_new_query_dash} />
                                            <View style={styles.View_v9_Dash}>
                                                <Text style={styles.All_Query_tv_dash}> {this.state.All_query} </Text>

                                            </View>
                                        </View>
                                        <Text style={styles.All_Query_tv_2_dash}>All Query</Text>
                                    </TouchableOpacity>
                                </View>

                                <View style={styles.View_v10_Dash}>
                                    <TouchableOpacity onPress={() => this.props.navigation.navigate('Answered_Query', { 'Answered_Query': this.state.answered_query }, this.props)}>
                                        <View style={{ flexDirection: 'row' }}>
                                            <Image source={require('../imgs/respond.png')} style={{ borderRadius: 150 / 2, width: 75, height: 75 }} />
                                            <View style={{ width: '75%' }} >
                                                <Text style={{ color: '#262C2F', fontSize: 30, marginLeft: 25, marginTop: 3, fontWeight: '600', textAlign: 'right', alignItems: 'flex-end' }}> {this.state.answered_query} </Text>
                                            </View>

                                        </View>
                                        <Text style={{ color: '#FF9D59', fontSize: 20, marginLeft: 15, marginTop: 3, textAlign: 'right' }}>Answered Query</Text>
                                    </TouchableOpacity>
                                </View>

                                <View style={{ flexDirection: 'column', elevation: 5, padding: 10, margin: 2, marginLeft: 15, marginTop: 8, borderBottomWidth: 4, borderBottomColor: '#AC3DEA', marginRight: 15, backgroundColor: '#FFFFFF' }}>
                                    <TouchableOpacity onPress={() => this.props.navigation.navigate('Unanswered_Query', { 'Unanswered_Query': this.state.unanswered_query }, this.props)}>
                                        <View style={styles.View_v8_Dash}>
                                            <Image source={require('../imgs/responded.png')} style={styles.respond_dash_image} />
                                            <View style={{ width: '75%' }} >
                                                <Text style={styles.un_tv_dash}> {this.state.unanswered_query} </Text>
                                            </View>
                                        </View>
                                        <Text style={styles.un_t2_dash}>UnAnswered Query</Text>
                                    </TouchableOpacity>
                                </View>
                            </ScrollView>
                        </SafeAreaView>
                    </View>
                </View>
            </SafeAreaView>

        )
    }
}