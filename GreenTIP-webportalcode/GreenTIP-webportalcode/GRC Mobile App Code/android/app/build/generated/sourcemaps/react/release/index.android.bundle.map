import React, { Component } from 'react';
import {
  StyleSheet,
  Text,
  View,
  TextInput,
  Button,
  TouchableOpacity,
  TouchableHighlight,
  Image,
  ImageBackground,
  Alert,
  Icon,
  tintColor,
  ScrollView,
  StatusBar,
  FlatList,
  ActivityIndicator,
  Platform,
  Dimensions
} from 'react-native';
import { SearchBar } from 'react-native-elements';
import AsyncStorage from '@react-native-community/async-storage';
const iconChecked = require("../imgs/ck.png");
import Toast from 'react-native-simple-toast';
const width = Dimensions.get("window").width;
import Spinner from 'react-native-loading-spinner-overlay';
import ProgressLoader from 'rn-progress-loader';
import Constants from '../Constants';
export default class AssignExpert extends Component {

  static navigationOptions = ({ navigation }) => {
    const { params = {} } = navigation.state;
    if (params.handleSave === 'AssigntoMD') {
      return {

        title: 'Assign to MD',
        headerStyle: {
          backgroundColor: '#0ea457',
        },
        headerTintColor: '#FFFFFF',
        headerTitleAlign: 'center',

        headerTitleStyle: {
          fontSize: 20,
        },
      };
    }
    else {
      return {

        title: 'Assign to expert',
        headerStyle: {
          backgroundColor: '#0ea457',
        },
        headerTintColor: '#FFFFFF',
        headerTitleAlign: 'center',

        headerTitleStyle: {
          fontSize: 20,
        },
      };
    }

  };



  constructor(props) {
    super(props);
    //setting default state
    this.state = { isLoading: true, search: '' };
    this.arrayholder = [];
  }
  state = {
    total_inbox: '',
    isVisible: false, //state of modal default false
    isPopoverVisible: false,
    popoverPlacement: 'bottom',
    isModalVisible: false,
    spinner: true,
    isLoading: true,
    ProfileMD: '',
  }

  componentWillMount() {
    const { navigation } = this.props;
    this.setState({ ProfileMD: navigation.getParam('AssigntoMD') })
  }


  componentDidMount = async () => {

    if (this.state.ProfileMD === 'AssigntoMD') {
      this.props.navigation.setParams({ handleSave: this.state.ProfileMD });
    }


    if (this.state.ProfileMD === 'AssigntoMD') {

      this.AssignToMDList();
    }
    else {

      this.AssignToExpertList();
    }

  }

  AssignToMDList = async () => {
    this.setState({ isLoading: true });
    const { navigation } = this.props;
    const userIdnewww = await AsyncStorage.getItem('id')
    const query_id = navigation.getParam('id');
    var params = {
      'user_id': userIdnewww,
      'query_id': query_id,
    };
  //  console.log('params', params)
    var formData = new FormData();

    for (var k in params) {
      formData.append(k, params[k]);
    }

    // http://grcgreentip.com/api/v1/users/admin_users

    return fetch(Constants.FullURL+'/users/assign_to_md_list', {
      method: 'POST',
      headers: {
        'authorisation': this.authorisationToken
      },
      body: formData,
    }).then((response) => response.json())

      .then((responseJson) => {
        console.log(responseJson)
        if (responseJson.status === true) {
          const data = responseJson.data;
          this.setState(
            {
              isLoading: false,
              dataSource: data,
            },
            function () {
              this.arrayholder = data;
            }
          );
          //Alert.alert(responseJson.message);

        } else if (responseJson.status === false) {
          Alert.alert('Error', responseJson.message);
        }
      })
      .catch(error => {
        this.setState({ isLoading: false });
        console.log(error);
      })

  }

  AssignToExpertList = async () => {
    this.setState({ isLoading: true });
    const { navigation } = this.props;
    const userIdnewww = await AsyncStorage.getItem('id')
    const query_id = navigation.getParam('id');
    var params = {
      'user_id': userIdnewww,
      'query_id': query_id,
      // 'per_page': '10',
      // 'list_by': 'expert_user',
    };
    console.log('params', params)
    var formData = new FormData();

    for (var k in params) {
      formData.append(k, params[k]);
    }
    // http://grcgreentip.com/api/v1/users/admin_users
    return fetch(Constants.FullURL+'/users/assign_to_expert_list', {
      method: 'POST',
      headers: {
        'authorisation': this.authorisationToken
      },
      body: formData,
    }).then((response) => response.json())

      .then((responseJson) => {
        console.log(responseJson)
        if (responseJson.status === true) {
          const data = responseJson.data;
          this.setState(
            {
              isLoading: false,
              dataSource: data,
            },
            function () {
              this.arrayholder = data;
            }
          );


          //Alert.alert(responseJson.message);

        } else if (responseJson.status === false) {
          Alert.alert('Error', responseJson.message);
        }
      })
      .catch(error => {
        this.setState({ isLoading: false });
        console.log(error);
      })

  }



  search = text => {
    console.log(text);
  };
  clear = () => {
    this.search.clear();
  };
  SearchFilterFunction(text) {
    //passing the inserted text in textinput
    const newData = this.arrayholder.filter(function (item) {
      //applying filter for the inserted text in search bar
      const itemData = item.name ? item.name.toUpperCase() : ''.toUpperCase();
      const textData = text.toUpperCase();
      return itemData.indexOf(textData) > -1;
    });
    this.setState({
      //setting the filtered newData on datasource
      //After setting the data it will automatically re-render the view
      dataSource: newData,
      search: text,
    });
  }
  ListViewItemSeparator = () => {
    //Item sparator view
    return (
      <View
        style={{
          height: 1,
          width: '85%',
          backgroundColor: '#ccc',
          marginLeft: '18%'
        }}
      />
    );
  };

  Assign_Query_To_MD = async (md_id) => {
    this.setState({ isLoading: true });
    const { navigation } = this.props;
    const user_id = await AsyncStorage.getItem('id')
    const query_id = navigation.getParam('id');
    var params = {
      'query_id': query_id,
      'md_id': md_id,
      'user_id': user_id,
    };

    // console.log('params', params)
    var formData = new FormData();

    for (var k in params) {
      formData.append(k, params[k]);
    }

    fetch(Constants.FullURL+'/users/assign_to_md', {
      method: 'POST',
      headers: {
        'authorisation': this.authorisationToken
      },
      body: formData,
    }).then((response) => response.json())

      .then((responseJson) => {
        console.log(responseJson)
        if (responseJson.status === true) {
          const type = responseJson.data;
          this.setState(
            {
              isLoading: false,
            },
            function () {
              // this.arrayholder = type.queries;
            }
          );
          // Alert.alert(responseJson.message);
        //  Toast.show(responseJson.message, Toast.SHORT);
          setTimeout(() => {
            Toast.show(responseJson.message, Toast.SHORT);
        }, 500);
          //respondAnswerQuery
          const { navigation } = this.props;
          const respondAnswerQuery = navigation.getParam('respondAnswerQuery');
          if (respondAnswerQuery == 'respondAnswerQuery') {
            this.props.navigation.navigate('AdminRespondQuery');
          }
          else {
            this.props.navigation.navigate('NewQuery');

          }

        } else if (responseJson.status === false) {
          Alert.alert('Error', responseJson.message);
          this.setState(
            {
              isLoading: false,

            }
          );
        }
      })
      .catch(error => {
        this.setState({ isLoading: false });
        console.log(error);
      })
  }
  Assign_Query_To_Expert = async (expert_id) => {
    this.setState({ isLoading: true });
    const { navigation } = this.props;
    const user_id = await AsyncStorage.getItem('id')
    const query_id = navigation.getParam('id');
    var params = {
      'query_id': query_id,
      'expert_id': expert_id,
      'user_id': user_id,
    };

    console.log('params', params)
    var formData = new FormData();
    for (var k in params) {
      formData.append(k, params[k]);
    }
    console.log(formData);
    fetch(Constants.FullURL+'/users/query_assign_to_expert', {
      method: 'POST',
      body: formData,
    }).then((response) => response.json())

      .then((responseJson) => {
        console.log(responseJson)
        if (responseJson.status === true) {
          const type = responseJson.data;

          this.setState(
            {
              isLoading: false,

            },
            function () {
              // this.arrayholder = type.queries;
            }
          );


          // Alert.alert(responseJson.message);
          //Toast.show(responseJson.message, Toast.SHORT);
          setTimeout(() => {
            Toast.show(responseJson.message, Toast.SHORT);
        }, 500);

          //respondAnswerQuery
          const { navigation } = this.props;
          const respondAnswerQuery = navigation.getParam('respondAnswerQuery');
          if (respondAnswerQuery == 'respondAnswerQuery') {
            this.props.navigation.navigate('AdminRespondQuery');
          }
          else {
            this.props.navigation.navigate('NewQuery');

          }

        } else if (responseJson.status === false) {
          Alert.alert('Error', responseJson.message);
          this.setState(
            {
              isLoading: false,

            }
          );
        }
      })
      .catch(error => {
        this.setState({ isLoading: false });
        console.log(error);
      })

  }

  render() {
    const { navigation } = this.props;
    const query = navigation.getParam('query');
    const enduser_image = navigation.getParam('enduser_image');
    const imgPath = navigation.getParam('imgPath');
 //   console.log('enduser_image',enduser_image)

    // if (this.state.isLoading) {
    //   return (
    //     <View style={stylesIndi.container}>
    //       <ActivityIndicator
    //         visible={this.state.isLoading}
    //         size="large"
    //         color='#0ea457'
    //         style={stylesIndi.activityIndicator} />
    //     </View>
    //   );
    // }

    return (
      <View style={{ flex: 1, backgroundColor: '#fff' }}>
        <StatusBar barStyle="dark-content" backgroundColor="#0ea457" />
        <ProgressLoader
          visible={this.state.isLoading}
          isModal={true} isHUD={true}
          hudColor={"#00A637"}
          style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
          color={"#FFFFFF"} />
        <View style={{ flexDirection: 'row', backgroundColor: '#FFFFFF', padding: 10 }}>
          {enduser_image != null ? <Image source={{ uri: imgPath + enduser_image }}
            style={{ width: 40, height: 40, borderRadius: 150 / 2, marginLeft: 4 }} /> : <Image source={require('../imgs/no_image.jpg')}
              style={{ width: 40, height: 40, borderRadius: 150 / 2, marginLeft: 4 }} />}

          <View style={{ flex: 1, flexDirection: 'column', height: '100%' }}>
            <Text style={{ color: 'white', padding: 5, fontSize: 16, color: '#000', marginLeft: 10, marginRight: 5,fontWeight:'bold' }}>{query}</Text>
          </View>
        </View>

        {/* <View>
          <Text style={{ backgroundColor: '#f4f4f4', paddingTop: 8, paddingLeft: 14, fontSize: 16, alignItems: 'center' }}>Search expert</Text>
        </View> */}

        <View style={stylessssss.container}>
          <View style={stylessssss.SectionStyle}>
            <Image source={require('../imgs/search.png')} style={stylessssss.ImageStyle} />
            <TextInput
              style={{ flex: 1, marginLeft: 10, color: 'black' }}
              onChangeText={text => this.SearchFilterFunction(text)}
              value={this.state.search}
              placeholderTextColor='#000'
              onClear={text => this.SearchFilterFunction('')}
              underlineColorAndroid="transparent"
              placeholder={'Search Expert'}
              fontSize={16}
            />
          </View>
        </View>

        <View style={styles.viewStyle}>
          <FlatList
            data={this.state.dataSource}
            ItemSeparatorComponent={() => <View
              style={{
                height: 1,
                width: '100%',
                backgroundColor: '#ccc'
              }}
            />}
            keyExtractor={(item) => item.id}
            extraData={this.state}
            renderItem={({ item }) => (
              // Single Comes here which will be repeatative for the FlatListItems
              <TouchableHighlight underlayColor="transparent" onPress={() => this.setState({ indexChecked: item.id })}>
                <View style={{ flexDirection: 'column', padding: 5, paddingLeft: 10 }}>
                  <View style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'flex-start' }}>

                    {item.image == null ? <Image source={require('../imgs/no_image.jpg')}
                      style={{ width: 40, height: 40, borderRadius: 150 / 2, marginTop: 10 }} /> : <Image source={{ uri:Constants.APIURL+'assets/uploads/users/' + item.image }} style={{ width: 40, height: 40, borderRadius: 150 / 2, marginTop: 10 }} />}

                    <View style={{ flex: 1, height: '100%' }}>
                      <Text style={styles_search_expert.alignCenter}>{item.name}</Text>
                      <Text style={{ color: 'white', fontSize: 14, color: '#000', paddingLeft: 8, paddingBottom: 8 }}>{item.email}</Text>
                      {this.state.indexChecked === item.id && <Image source={iconChecked} style={styles_search_expert.iconChecked} />}
                    </View>
                    {/* <View style={{ flexDirection: 'row', justifyContent: 'flex-start', alignContent: 'center', paddingLeft: 4, width: width - 30 }}>
                      <View style={styles_search_expert.contentChecked}>
                        <Text style={styles_search_expert.alignCenter}>{item.name}</Text>
                        {this.state.indexChecked === item.id && <Image source={iconChecked} style={styles_search_expert.iconChecked} />}
                        <Text style={{ color: 'white', fontSize: 14, color: '#ACABAB', paddingLeft: 60 }}>{item.email}</Text>
                      </View>
                    </View> */}
                  </View>
                </View>
              </TouchableHighlight>
            )} />

          {this.state.ProfileMD === 'AssigntoMD' ?

            <TouchableHighlight onPress={() => { this.Assign_Query_To_MD(this.state.indexChecked); }} style={[stylesssss.buttonContainer, stylesssss.loginButton]} >
              <Text style={stylesssss.loginText}>Assign</Text>
            </TouchableHighlight> : <TouchableHighlight onPress={() => { this.Assign_Query_To_Expert(this.state.indexChecked); }} style={[stylesssss.buttonContainer, stylesssss.loginButton]} >
              <Text style={stylesssss.loginText}>Assign</Text>
            </TouchableHighlight>}


        </View>
      </View>
    )
  }
}


