                                    padding={8}
                                    placeholderTextColor='#000'
                                    onChangeText={Password => this.setState({ Password })}
                                    secureTextEntry={true}

                                >

                                </TextInput>

                            </View>


                            {/* <View style={{ margin: 5, marginTop: 8 }}>
                            <TextInput style={{ height: 45, color: 'black', width: "90%", borderColor: '#C8C8C8', borderWidth: 1, marginLeft: 15, marginRight: 15, marginTop: 3, paddingLeft: 10 }}
