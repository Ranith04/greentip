import React, { Component } from 'react';
import {
  StyleSheet,
  Text,
  View,
  TextInput,
  TouchableOpacity,
  TouchableHighlight,
  Image,
  Alert,
  StatusBar,
  BackHandler,
  FlatList,
  ActivityIndicator,
  ScrollView,
  Linking
} from 'react-native';
import Toast from 'react-native-simple-toast';
import AsyncStorage from '@react-native-community/async-storage';
import ProgressLoader from 'rn-progress-loader';
import { NavigationEvents } from "react-navigation";
import Constants from '../../Constants';
import DocumentPicker from 'react-native-document-picker';
const RNFS = require('react-native-fs');
import Icon from 'react-native-vector-icons/FontAwesome';
import mainstyles from '../../Component/mainstyles';
import ViewDownload from '../../Component/viewDownload';
import RenderHtml from '../../Component/renderHtml';
export default class MD_Respond extends Component {

  static navigationOptions = ({ navigation }) => {
    return {
      title: 'Respond By MD',
      headerStyle: {
        backgroundColor: '#0ea457',
      },
      headerTintColor: '#FFFFFF',
      headerTitleAlign: 'center',

      headerTitleStyle: {
        fontSize: 20,
      },
    }
  }

  state = {
    isModalVisible: false,
    assignID: '',
    isLoading: false,
    message_user: '',
    file_name: '',
    real_Path: '',
    real_Path_uri: '',
    real_Path_name: '',
    real_Path_type: ''
  }

  constructor(props) {
    super(props);
    this.handleBackButtonClick = this.handleBackButtonClick.bind(this);
  }

  componentWillMount() {
    BackHandler.addEventListener('hardwareBackPress', this.handleBackButtonClick);
  }

  componentWillUnmount() {
    BackHandler.removeEventListener('hardwareBackPress', this.handleBackButtonClick);
  }

  handleBackButtonClick() {
    console.log("hello_props", this.props);
    this.props.navigation.goBack(null);
    return true;
  }

  FlatListItemSeparator = () => {
    return (
      <View
        style={{
          height: 1,
          width: '100%',
          backgroundColor: '#ccc'
        }}
      />
    );
  }

  validate_field = () => {
    const { message_user } = this.state;

    if (message_user == "") {
      alert("Enter a Valid Message")
      return false
    }
    return true
  }

  submitAnswer = async () => {

    if (this.validate_field()) {
      this.setState({ isLoading: true });
      const userId = await AsyncStorage.getItem('id')
      const nav = this.props.navigation.state.params.userData;
      const { real_Path_uri, real_Path_name, real_Path_type } = this.state;
      var photo = {
        uri: real_Path_uri,
        type: real_Path_type,
        name: real_Path_name
      };
      var params = {
        'id': nav.id,
        'user_id': userId,
        'answer': this.state.message_user
      };
      console.log('paramssss', params);
      var formData = new FormData();

      for (var k in params) {
        formData.append(k, params[k]);
      }
      if (photo.uri != '' && photo.type != '' && photo.name != '') {
        formData.append('attachment_file', photo);
      }

      fetch(Constants.FullURL + '/users/respond_by_md', {
        // fetch(Constants.FullURL+'/users/respond_by_expert', {
        method: 'POST',
        headers: {
          'Content-Type': 'multipart/form-data'
        },
        body: formData,
      }).then((response) => response.json())
        .then((responseJson) => {
          console.log(responseJson)
          if (responseJson.status === true) {
            const respData = responseJson.data;
            // Alert.alert('Congrats! Your response has been submitted');
          //  Toast.show(responseJson.message, Toast.SHORT);

            setTimeout(() => {
              Toast.show(responseJson.message, Toast.SHORT);
          }, 500);


            this.setState({
              isLoading: false,

            });
            this.props.navigation.navigate('MD_NewQuery');

          } else if (responseJson.status === false) {
            Alert.alert('Error', responseJson.message);
            this.setState({ isLoading: false });
          }
        })
        .catch(error => {
          this.setState({ isLoading: false });
          console.log(error);
        })
    }
  }

  Fle_Picker = async () => {
    try {
      const res = await DocumentPicker.pick({
        type: [DocumentPicker.types.images, DocumentPicker.types.pdf, DocumentPicker.types.zip, DocumentPicker.types.allFiles],
      });
      const split = res.uri.split('/');
      const name = split.pop();
      const inbox = split.pop();
      const realPath = `${RNFS.TemporaryDirectoryPath}${inbox}/${name}`;
      this.setState({
        file_name: res.name,
        real_Path_uri: res.uri,
        real_Path_name: res.name,
        real_Path_type: res.type,
      });
      // console.log('uri', res.uri)
      // console.log('type', res.type)
      // console.log('name', res.name)
      // console.log('size', res.size)
    } catch (err) {
      if (DocumentPicker.isCancel(err)) {
        // User cancelled the picker, exit any dialogs or menus and move on
      } else {
        throw err;
      }
    }
  }

  render() {
    // if (this.state.isLoading) {
    //   return (
    //     <View style={stylesIndi.container}>
    //       <ActivityIndicator
    //         visible={this.state.isLoading}
    //         size="large"
    //         color='#0ea457'
    //         style={stylesIndi.activityIndicator} />
    //     </View>
    //   );
    // }
    const nav = this.props.navigation.state.params.userData;
    console.log('nav', nav)
    return (
      <ScrollView contentContainerStyle={{ flexGrow: 1 }}>

      <View style={{ flex: 1, backgroundColor: '#FFFFFF', width: '100%' }}>
        <StatusBar barStyle="dark-content" backgroundColor="#0ea457" />
        <ProgressLoader
          visible={this.state.isLoading}
          isModal={true} isHUD={true}
          hudColor={"#00A637"}
          style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
          color={"#FFFFFF"} />

        <View style={{ flex: 1, justifyContent: 'flex-start', alignItems: 'flex-start', flexDirection: 'column' }}>

          <View style={{ flexDirection: 'row', backgroundColor: '#FFFFFF', marginBottom: 2 }}>
            {nav.user_image == null ? <Image source={require('../../imgs/no_image.jpg')}
              style={{ width: 60, height: 60, borderRadius: 150 / 2, marginTop: 16, marginLeft: 5 }} /> : <Image source={{ uri: Constants.APIURL + 'assets/uploads/users/' + nav.user_image }}
                style={{ width: 60, height: 60, borderRadius: 150 / 2, marginTop: 16, marginLeft: 5 }} />}

            <View style={mainstyles.right_container}>
              <Text style={mainstyles.query}>{nav.question}</Text>
              <Text style={mainstyles.category_ask}>Category: {nav.category_name} </Text>
              <Text style={mainstyles.category_ask}>Ask: {nav.added_on} </Text>
              <Text style={mainstyles.category_ask}>Asked By: {nav.name} </Text>
            </View>
          </View>
          {nav.status == 1 && <View style={{ backgroundColor: '#f4f4f4', padding: 6, paddingLeft: 10, width: '100%' }}>
            <Text style={{ fontSize: 16 }} >Answer</Text>
          </View>}
          {nav.status == 1 ?
            <View style={{ flexDirection: 'row' }}>

              {nav.answerData.expert_image == null ? <Image source={require('../../imgs/no_image.jpg')}
                style={{ width: 60, height: 60, borderRadius: 150 / 2, marginTop: 16, marginLeft: 5 }} /> : <Image source={{ uri: Constants.APIURL + 'assets/uploads/users/' + nav.answerData.expert_image }}
                  style={{ width: 60, height: 60, borderRadius: 150 / 2, marginTop: 16, marginLeft: 5 }} />}

              {/* <Image source={{ uri:Constants.APIURL+'assets/uploads/users/' + nav.user_image }} style={{ width: 50, height: 50, borderRadius: 150 / 2, marginTop: 10, marginLeft: 5 }} /> */}
              <View style={{ flex: 1 }}>
                <Text style={{ color: 'white', padding: 5, paddingBottom: 0, fontSize: 16, color: '#000', marginLeft: 9, marginTop: 10, fontWeight: 'bold', textTransform: 'capitalize' }}>{nav.answerData.expert_name}</Text>
                <Text style={{ color: 'white', fontSize: 12, color: '#000', marginLeft: 10 }}> {nav.answerData.answer_date} </Text>
              </View>
            </View> : null
            }
          {nav.status == 1 ?
              <RenderHtml htmlText={nav.answerData.expert_answer}/>
              :
            <View style={{width: '96%', marginLeft: '2%',}}>
                <Text style={mainstyles.respond_label}>Message *</Text>
              <TextInput
               style={[mainstyles.contatus_input,{height:300,textAlignVertical:'top'}]}
                placeholder="Message"
                underlineColorAndroid="transparent"
                placeholderTextColor='#000'
                returnKeyType="done"
                //blurOnSubmit={true}
                paddingLeft={10}
                blurOnSubmit={true}
                fontSize={15}
                multiline={true}
                onChangeText={message_user => this.setState({ message_user })}
              />

            </View>

          }
           {nav.status != '1' && <View style={{
                marginLeft: '2%',
                 width: '100%'
              }}>
                 <Text style={mainstyles.respond_attachment}>Attachment </Text>
                <TouchableHighlight underlayColor="#ffffff00" onPress={() => {
                  this.Fle_Picker();
                }} >
                  <View style={{
                    flexDirection: 'row', borderRadius: 1,
                    borderStyle: 'dashed',
                    borderWidth: 1,
                    borderColor: '#62D5A8',
                    alignItems: 'center',
                    width: '96%',
                    marginTop:8
                    
                  }}>
                    <TextInput style={{ fontSize: 15, padding: 10, width: '90%', color: 'black' }
                    }
                      underlineColorAndroid="transparent"
                      placeholder={'Choose File'}
                      editable={false}
                      placeholderTextColor='#000'
                    >{this.state.file_name}
                    </TextInput>

                    <View style={{ width: '10%', paddingLeft: 10, position: 'absolute', right: 10, alignSelf: 'flex-end', padding: Platform.OS == 'ios' ? 5 : 10 }}>

                      <Image source={require('../../imgs/upload_docc.png')} style={{ width: 30, height: 30 }} />

                    </View>
                  </View>
                </TouchableHighlight>
              </View>
              }
          {(nav.status != '0' && nav.answerData.upload_full_image != '') && <ViewDownload expertAnswerData={nav ? nav : ''} />}
          {/* {(nav.status != '0' && nav.answerData.upload_full_image != '') && <View style={{ flex: 1, flexDirection: 'row', width: '100%', padding: '2%', }}>
              <View style={{ width: '50%' }}>
               
              </View>
              <View style={{ width: '50%' }}>
                <TouchableOpacity onPress={() => Linking.openURL(nav.answerData.upload_full_image)}>
                  <Text style={{ color: '#00AD39', fontSize: 18, textAlign: 'right' }}><Icon name="eye" size={20} color="#00AD39" /> View</Text>
                </TouchableOpacity>
              </View>
            </View>} */}


          {nav.status == 0 ?
            <View style={{
              flexDirection: 'row',
              marginVertical:'5%'
            }}>


              <TouchableHighlight underlayColor="#ffffff00" onPress={() => this.submitAnswer()} style={{
                height: 50,
                flexDirection: 'row',
                justifyContent: 'center',
                alignItems: 'center',
                width: '100%',
                backgroundColor: "#00AD39"
              }}
              >
                <Text style={{ color: 'white', fontSize: 18 }}>Submit</Text>
              </TouchableHighlight>



            </View> : null}

        </View>
      </View>
      </ScrollView>
    )
  }
}

const stylesIndi = StyleSheet.create({
  container: {
    flex: 1,
    justifyContent: 'center',
    alignItems: 'center',
    marginTop: 70
  },
  activityIndicator: {
    flex: 1,
    justifyContent: 'center',
    alignItems: 'center',
    height: 80
  }
})

const styles = StyleSheet.create({
  container: {
    justifyContent: 'flex-start',
    alignItems: 'flex-start',
  },
  input: {
    margin: 2,
    height: 100,
    borderColor: '#EEEEEE',
    borderWidth: 1,
    marginBottom: 30,
    marginTop: 20,
    marginLeft: 20,
    textAlignVertical: 'top',
    width: '90%'
  },
  buttonContainer: {
    height: 50,
    flexDirection: 'row',
    justifyContent: 'center',
    alignItems: 'center',
    width: '100%',
    borderRadius: 3,
  },
  loginButton: {
    backgroundColor: "#00AD39",
    justifyContent: 'center',
  }
});