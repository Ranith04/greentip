import React from 'react';
import {
    StyleSheet,
    Text,
    View,
    TextInput,
    Button,
    TouchableHighlight,
    Image,
    ImageBackground,
    Alert,
    BackHandler,
    TouchableOpacity,
    ActivityIndicator,

} from 'react-native';
import { DrawerActions } from 'react-navigation-drawer';
import { KeyboardAwareScrollView } from 'react-native-keyboard-aware-scrollview'
import { TextInputLayout } from 'rn-textinputlayout';
import { StackActions, NavigationActions, SafeAreaView } from 'react-navigation';
import AsyncStorage from '@react-native-community/async-storage';
import { ScrollView } from 'react-native-gesture-handler';
import ProgressLoader from 'rn-progress-loader';
import Constants from '../Constants';

export default class Login extends React.Component {

    constructor(props) {
        super(props);
        //  console.log("constructor props", props);
        this.handleBackButtonClick = this.handleBackButtonClick.bind(this);
        this.state = {
            choosenIndex: 0,
            // selectedValue: '',
            UserName: '',
            UserPassword: '',
            isLoading: false,
            role_t: '',
            UserName: '',//'admin@gmail.com',
            UserPassword: ''//'admin@123',
        }
    }

    // constructor(props) {
    //     super(props);
    //     console.log("constructor props", props);
    //     this.state = {
    //         UserName: '',//'admin@gmail.com',
    //         UserPassword: ''//'admin@123',
    //     }
    // }

    // state = {
    //     choosenIndex: 0,
    //     // selectedValue: '',
    //     UserName: '',
    //     UserPassword: '',
    //     isLoading: false,
    //     role_t: ''
    // };


    static navigationOptions = {
        header: null,
    };


    componentWillMount() {
       
        BackHandler.addEventListener('hardwareBackPress', this.handleBackButtonClick);

    }
    componentWillUnmount() {
        BackHandler.removeEventListener('hardwareBackPress', this.handleBackButtonClick);
    }

    handleBackButtonClick() {
        //console.log("hello_props", this.props);
       // this.props.navigation.goBack(null);
        BackHandler.exitApp();
        return true;
    }


    _storeData = async (role_type, id, userName, image, email, contact_no,) => {
        try {
            await AsyncStorage.setItem('role_type', role_type);
            await AsyncStorage.setItem('id', id);
            await AsyncStorage.setItem('userName', userName);
            await AsyncStorage.setItem('userimage', image);
            await AsyncStorage.setItem('email', email);
            await AsyncStorage.setItem('contact_no', contact_no);

            console.log('login_id', id)
            //alert(userImg);
            // alert('_storeData')

        } catch (error) {
            // Error saving data
        }
    };

    toggleDrawer = () => {
        //Props to open/close the drawer
        this.props.navigation.dispatch(DrawerActions.toggleDrawer());
        // this.props.navigationProps.toggleDrawer();
        //this.props.navigation.toggleDrawer()
    };

  

    validate_field = () => {
        const { UserName, UserPassword } = this.state;
        const reg = /^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/;

        if (reg.test(UserName) === false) {
            alert("Enter Valid Email Address")
            return false
        } else if (UserPassword == "") {
            alert("Enter Valid Password")
            return false
        }
        return true
    }

    async doLogin() {
        if (this.validate_field()) {
            var res = await Constants.isNetworkAvailable();
      if (!res) {
        return false;
      }
            this.setState({ isLoading: true });
            const { UserName, UserPassword } = this.state;

            const formData = new FormData();
            formData.append("email", UserName);
            formData.append("password", UserPassword);
            console.log('formdata',JSON.stringify(formData));
            // http://demo.triazinesoft.com/greentip_test/api/v1/authentication/login
            // http://grcgreentip.com/api/v1/authentication/login
            const url = Constants.FullURL+'/authentication/login';
            console.log('url',url);
            fetch(url, {
                method: 'POST',
                body: formData,
            }).then((response) => response.json())
                .then((responseJson) => {
                    if (responseJson.status === true) {
                        const userData = responseJson.data;
                        //console.log(userData)
                        //Alert.alert(responseJson.message);
                        //console.log(userData)
                        this._storeData(userData.role_type, userData.id, userData.name, userData.image, userData.email, userData.contact_no)
                        this.setState({ isLoading: false });
                        // console.log('roleType ' + userData.role_type);
                        if (userData.role_type == '0') {
                            this.props.navigation.navigate('Dashboard', { image: userData.image });
                        } else if (userData.role_type == '2') {
                            this.props.navigation.navigate('EndUserDashboard');
                        }
                        else if (userData.role_type == '1') {
                            this.props.navigation.navigate('Expert_Dashboard', { image: userData.image });
                        } else if (userData.role_type == '3') {
                            this.props.navigation.navigate('MD_Dashboard', { image: userData.image });
                        }
                    } else if (responseJson.status === false) {
                        Alert.alert('Error', responseJson.message);
                        this.setState({ isLoading: false });
                    }
                    console.log(responseJson);
                }
                ).catch((error) => {
                    this.setState({ isLoading: false });
                    //console.log(error.message);
                  //Alert.alert(error.message);
                    //throw new Error('server error please try again');
                    //Alert.alert(error);
                });
        }
    }
    render() {
        return (

            <KeyboardAwareScrollView contentContainerStyle={{ flexGrow: 1 }}
                keyboardShouldPersistTaps='always'
            >

                <SafeAreaView forceInset={{ bottom: 'never' }} style={{ flex: 1, backgroundColor: '#EAFCFD' }}>
                    <View style={{ flex: 1 }}>


                        <ProgressLoader
                            visible={this.state.isLoading}
                            isModal={true} isHUD={true}
                            hudColor={"#00A637"}
                            style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
                            color={"#FFFFFF"} />
                        <ImageBackground style={{ width: '100%', height: '100%' }} resizeMode='stretch' source={require('../imgs/login-bg.png')} >
                            <TouchableOpacity onPress={this.toggleDrawer.bind(this)}>
                                <Image style={{ marginLeft: 20, marginTop: 20 }} resizeMode='contain' source={require('../imgs/menu_icon_for_login_screen.png')} />
                            </TouchableOpacity>
                            <Image style={styles.logoImg} resizeMode='contain' source={require('../imgs/logo.png')} />

                            <View style={styles.container}>
                                <View style={{}}>
                                    <TextInputLayout style={{ marginHorizontal: 36 }}>
                                        <TextInput style={{ fontSize: 16, height: 40, color: 'black' }} placeholder={'Email Address *'}  placeholderTextColor='#000'   onChangeText={(UserName) => this.setState({ UserName })} />
                                    </TextInputLayout>

                                    <TextInputLayout style={{ marginTop: 16, marginHorizontal: 36 }}>
                                        <TextInput style={{ fontSize: 16, height: 40, color: 'black' }} placeholder={'Password *'} placeholderTextColor='#000' secureTextEntry={true} onChangeText={(UserPassword) => this.setState({ UserPassword })} />
                                    </TextInputLayout>
                                </View>

                                {/* <View style={{ justifyContent: "center", alignItems: "center" }}>
                                    {this.state.isLoading && <ActivityIndicator size="large" color={"#00AD39"} />}
                                </View> */}

                                <View style={{ flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'flex-end', marginTop: 20 }}>
                                    <Text style={{ color: '#00AD39', fontSize: 15, marginTop: 2, marginRight: 35 }} onPress={() => this.props.navigation.navigate('ForgotPassword')}>Forgot Password?</Text>
                                </View>

                                <TouchableHighlight underlayColor="#ffffff00" style={[styles.buttonContainer, styles.loginButton]} onPress={() => this.doLogin()}>
                                    <Text style={styles.loginText}>LOGIN</Text>
                                </TouchableHighlight>

                                <View style={{ flexDirection: 'row', marginTop: 20, alignItems: 'center', justifyContent: 'center' }}>
                                    <Text style={{ color: '#000', fontSize: 14, marginTop: 2, alignItems: 'center' }}>Not have an account?</Text>
                                    <Text style={{ color: '#00AD39', fontSize: 14, marginTop: 2, alignItems: 'center' }} onPress={() => this.props.navigation.navigate('SignUp')}> Sign Up</Text>
                                </View>
                            </View>
                        </ImageBackground>
                    </View>
                </SafeAreaView>
            </KeyboardAwareScrollView>
        );
    }
};

const styles = StyleSheet.create({
    logoImg: {
        width: 70 + '%',
        height: 20 + '%',
        marginTop: 10 + '%',
        marginBottom: 5 + '%',
        marginLeft: 15.5 + '%'
    },
    buttonContainer: {
        height: 45,
        flexDirection: 'row',
        justifyContent: 'center',
        alignItems: 'center',
        width: '80%',
        marginLeft: 40,
        borderRadius: 3,
    },
    loginButton: {
        backgroundColor: "#00AD39",
        marginTop: 20,
        justifyContent: 'center',
    },
    loginText: {
        color: 'white',
        fontSize: 16,
        fontWeight: 'bold',
    }
});