import React from 'react';
import {
    StyleSheet,
    Text,
    View,
    TextInput,
    Button,
    TouchableHighlight,
    Image,
    ImageBackground,
    Alert,
    TouchableOpacity,
    ActivityIndicator,
    StatusBar,
    BackHandler
} from 'react-native';
import { TextInputLayout } from 'rn-textinputlayout';
import Toast from 'react-native-simple-toast';
import AsyncStorage from '@react-native-community/async-storage';
import ProgressLoader from 'rn-progress-loader';
import Constants from '../Constants';
import mainstyles from '../Component/mainstyles';
export default class ChangePassword extends React.Component {
    static navigationOptions = {
        title: 'Change Password',
        headerStyle: {
            backgroundColor: '#0ea457',
        },
        headerTintColor: '#FFFFFF',
        headerTitleAlign: 'center',

        headerTitleStyle: {
            fontSize: 20,
        },
    };

    constructor(props) {
        super(props);
        this.handleBackButtonClick = this.handleBackButtonClick.bind(this);
        console.log("constructor props", props);
        this.state = {
            oldPassword: '',
            newPassword: '',
            confirmPassword: ''
        }
    }

    componentWillMount() {
        BackHandler.addEventListener('hardwareBackPress', this.handleBackButtonClick);
    }

    componentWillUnmount() {
        BackHandler.removeEventListener('hardwareBackPress', this.handleBackButtonClick);
    }

    handleBackButtonClick() {
        console.log("hello_props", this.props);
        this.props.navigation.goBack(null);
        // BackHandler.exitApp();
        return true;
    }

    validate_field = () => {
        const { oldPassword, newPassword, confirmPassword } = this.state;
        const reg = '^[a-zA-Z0-9]+$';
        const name_ = /^[a-zA-Z]+$/;


        if (oldPassword === '') {
            alert("Old Password must be between 8 and 30.")
            return false
        }
        else if (oldPassword.length < 6 || oldPassword.length > 30) {
            alert("The Password must be between 8 and 30.")
            return false
        }
        else if (newPassword === '') {
            alert("The Password must be between 8 and 30.")
            return false
        }
        else if (newPassword.length < 6 || newPassword.length > 30) {
            alert("The Password must be between 8 and 30.")
            return false
        }
        else if (confirmPassword === '') {
            alert("The Confirm Password must be between 8 and 30.")
            return false
        }
        else if (confirmPassword.length < 6 || confirmPassword.length > 30) {
            alert("The Confirm Password must be between 8 and 30.")
            return false
        }
        else if (newPassword != confirmPassword) {
            alert("Whoops! Old Password does not match.")
            return false
        }
        return true
    }

    forgotPass = async () => {
        if (this.validate_field()) {
            var res = await Constants.isNetworkAvailable();
      if (!res) {
        return false;
      }
            this.setState({ isLoading: true });
            const userIdnewww = await AsyncStorage.getItem('id')
            const { oldPassword, newPassword } = this.state;

            var params = {
                'old_password': oldPassword,
                'new_password': newPassword,
                'user_id': userIdnewww,
            };
            console.log('params', params)
            var formData = new FormData();

            for (var k in params) {
                formData.append(k, params[k]);
            }
            //console.log(JSON.stringify(formData));
            fetch(Constants.FullURL + '/users/changePassword', {
                method: 'POST',
                body: formData,
            }).then((response) => response.json())
                .then(async (responseJson) => {
                    // If server response message same as Data Matched
                    console.log(responseJson);
                    if (responseJson.status == true) {
                        this.setState({ isLoading: false });
                        // Alert.alert('Success', 'Password has been reset successfully Please check your mail for new password');
                      //  Toast.show(responseJson.message, Toast.LONG);
                        setTimeout(() => {
                            Toast.show(responseJson.message, Toast.SHORT);
                        }, 500);
                        await AsyncStorage.removeItem('role_type');
                        this.props.navigation.navigate('Login');
                    } else {
                        this.setState({ isLoading: false });
                        Alert.alert('Error', responseJson.message);
                    }
                }
                ).catch((error) => {
                    this.setState({ isLoading: false });
                   // Alert.alert('Error', error);
                });
        }
    }

    render() {

        return (
            <View style={{ flex: 1, backgroundColor: '#fff' }}>
                <StatusBar barStyle="dark-content" backgroundColor="#0ea457" />
                <ProgressLoader
                    visible={this.state.isLoading}
                    isModal={true} isHUD={true}
                    hudColor={"#00A637"}
                    style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
                    color={"#FFFFFF"} />
                <View style={styles.container}>
                    <View style={mainstyles.addExpertContainer}>
                        <View>
                            <Text style={mainstyles.contatus_label}>Old Password *</Text>
                            <TextInput
                                style={mainstyles.contatus_input} placeholder="Old Password"
                                underlineColorAndroid="transparent"
                                placeholderTextColor='#000'
                                paddingLeft={10}
                                fontSize={15}
                                secureTextEntry={true}
                                minLength={8}
                                onChangeText={(oldPassword) => this.setState({ oldPassword })}
                            />
                        </View>

                        <View>
                            <Text style={mainstyles.contatus_label}>New Password *</Text>
                            <TextInput
                                style={mainstyles.contatus_input} placeholder="New Password"
                                underlineColorAndroid="transparent"
                                placeholderTextColor='#000'
                                paddingLeft={10}
                                fontSize={15}
                                secureTextEntry={true}
                                minLength={8}
                                onChangeText={(newPassword) => this.setState({ newPassword })}
                            />
                        </View>

                        <View>
                            <Text style={mainstyles.contatus_label}>Confirm Password *</Text>
                            <TextInput
                                style={mainstyles.contatus_input} placeholder="Confirm Password"
                                underlineColorAndroid="transparent"
                                placeholderTextColor='#000'
                                paddingLeft={10}
                                fontSize={15}
                                secureTextEntry={true}
                                minLength={8}
                                onChangeText={(confirmPassword) => this.setState({ confirmPassword })}
                            />
                        </View>
                        {/* <TextInputLayout style={{ marginHorizontal: 36 }}>
                            <TextInput style={{ fontSize: 16, height: 40}} placeholder={'Old Password'} onChangeText={(oldPassword) => this.setState({oldPassword})}/>
                        </TextInputLayout> */}
                        {/* <TextInputLayout style={{ marginHorizontal: 36 }}>
                            <TextInput style={{ fontSize: 16, height: 40}} placeholder={'New Password'} onChangeText={(newPassword) => this.setState({newPassword})}/>
                        </TextInputLayout>
                        <TextInputLayout style={{ marginHorizontal: 36 }}>
                            <TextInput style={{ fontSize: 16, height: 40}} placeholder={'Confirm New Password'} onChangeText={(confirmPassword) => this.setState({confirmPassword})}/>
                        </TextInputLayout> */}
                    </View>

                    {/* <View style={{ justifyContent: "center", alignItems: "center" }}>
                        {this.state.isLoading && <ActivityIndicator size="large" color={"#00AD39"} />}
                    </View> */}

                    <TouchableHighlight style={[styles.buttonContainer, styles.forgotButton]} underlayColor="#ffffff00" onPress={() => this.forgotPass()}>
                        <Text style={styles.forgotText}>SUBMIT</Text>
                    </TouchableHighlight>
                </View>
            </View>
        );
    }
};

const styles = StyleSheet.create({
    logoImg: {
        width: 70 + '%',
        height: 20 + '%',
        marginTop: 15 + '%',
        marginBottom: 5 + '%',
        marginLeft: 15.5 + '%'
    },
    buttonContainer: {
        height: 45,
        flexDirection: 'row',
        justifyContent: 'center',
        alignItems: 'center',
        marginBottom: 10,
        width: '90%',
        marginLeft: 20,
        borderRadius: 3,
    },
    forgotButton: {
        backgroundColor: "#0ea457",
        marginTop: 30,
        justifyContent: 'center',
    },
    forgotText: {
        color: 'white',
        fontSize: 18,
        fontWeight: 'bold',

    }
});