  Save_Edit_Expert = async () => {
    if (this.validate_field()) {
      var res = await Constants.isNetworkAvailable();
      if (!res) {
        return false;
      }
      this.setState({ isLoading: true });
      const { navigation } = this.props;
      const userIdnewww = await AsyncStorage.getItem('id')
      const role_id = navigation.getParam('id')
      const { name, mobile, email_save, password, linkdin, facebook, companyname, Qualification, Expertise, Occupation, id, description, image, real_Path_type, real_Path_name, company_location, state, district, pin } = this.state;
      // console.log('first_name', name)
      // console.log('email', email_save)
      // console.log('role_id', role_id)
      console.log('name', name)
      console.log('userIdnewww', userIdnewww)
      console.log('role_id', role_id)
      console.log('email_save', email_save)
      console.log('linkdin', linkdin)
      console.log('facebook', facebook)
      console.log('Qualification', Qualification)
      console.log('companyname', companyname)
      console.log('Expertise', Expertise)
      console.log('Occupation', Occupation)
      console.log('linkdin', linkdin)


      const photo = {
        uri: image,
        type: real_Path_type,
        name: real_Path_name
      };

      // console.log('photo',photo)

      const formData = new FormData();

      if (photo.type === '') {
        formData.append('userFile', '');
      } else {
        formData.append('userFile', photo);
      }
      formData.append("first_name", name);
      formData.append("last_name", '.');
      formData.append("email", email_save);
      formData.append('contact_no', '');
      formData.append('company_name', companyname);
      formData.append('occupation', Occupation);
      formData.append('expertise_field', Expertise);
      formData.append('education_qualification', Qualification);
      // formData.append('password', '1111111111');
      formData.append('user_id', userIdnewww);
      formData.append('roleUserID', role_id);
      formData.append('list_by', 'expert_user');
      // formData.append('description', description);
      formData.append('linkdin', linkdin);
      formData.append('facebook', facebook);
      formData.append('company_location', company_location);
      formData.append('state', state);
      formData.append('district', district);
      formData.append('pin', pin);

      fetch(Constants.FullURL + '/users/admin_update_user', {
        method: 'POST',
        headers: {
          'authorisation': this.authorisationToken
        },
        body: formData,
      }).then((response) => response.json())

        .then((responseJson) => {
          //console.log(responseJson)
          if (responseJson.status === true) {
            //Alert.alert(responseJson.message);
            // Toast.show(responseJson.message, Toast.LONG);
            setTimeout(() => {
              Toast.show(responseJson.message, Toast.SHORT);
            }, 500);
            { this.setState({ isVisible: false }) }

            this.setState({
              isLoading: false,
            });

            this.props.navigation.navigate('ExpertManagement');


          } else if (responseJson.status === false) {
            this.setState({
              isLoading: false,
            });
            Alert.alert('Error', responseJson.message);

          }
        })
        .catch(error => {
          this.setState({ isLoading: false });
          // console.log('error', error);
        })
    }
  }

