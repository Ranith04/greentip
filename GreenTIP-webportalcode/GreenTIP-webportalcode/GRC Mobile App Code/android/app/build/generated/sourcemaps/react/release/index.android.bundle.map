      >
        <View style={{ flex: 1 }}>



          <View style={{ backgroundColor: 'white', flex: 1, padding: 12, paddingBottom: '20%' }} >


            <StatusBar barStyle="dark-content" backgroundColor="#0ea457" />

            <ProgressLoader
              visible={this.state.isLoading}
              isModal={true} isHUD={true}
              hudColor={"#00A637"}
              style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
              color={"#FFFFFF"} />

            <Text style={{ fontSize: 20, color: '#00AD39' }}>Contact Us</Text>

            <View style={{ flexDirection: 'row', marginTop: 20 }}>

              <View style={{ alignSelf: 'center' }}>
                <Image source={require('../imgs/location_map.png')} style={{}} />
              </View>

              <Text style={{ marginLeft: 12, fontSize: 16, flexWrap: 'wrap', alignSelf: 'center', color: '#4caad3', textDecorationLine: 'underline' }} onPress={() => Linking.openURL(`https://www.google.com/maps/dir//F-374+%26+375,+Sector%E2%80%9363,+NOIDA%E2%80%93201+301+,India/@28.6209807,77.3210044,12z/data=!3m1!4b1!4m9!4m8!1m1!4e2!1m5!1m1!1s0x390cef11e1886f7d:0xae5ce0c36c76008d!2m2!1d77.3910447!2d28.6209987`)}>F-374 & 375, Sector–63, NOIDA–201 301 ,India</Text>

            </View>


            {/*<View style={{ flexDirection: 'row', marginTop: 20 }}>

              <View style={{ alignSelf: 'center' }}>
                <Image source={require('../imgs/mobile_icon.png')} style={{}} />
              </View>

              <View style={{ flexDirection: 'row' }}>
                <Text style={{ marginLeft: 12, fontSize: 16, color: '#4caad3', textDecorationLine: 'underline' }} onPress={() => Linking.openURL(`tel:0120-4044630`)}>0120-4044630,</Text>
                <Text style={{ marginLeft: 3, fontSize: 16, color: '#4caad3', textDecorationLine: 'underline' }} onPress={() => Linking.openURL(`tel:0120-4044660`)}>4044660,</Text>
                <Text style={{ marginLeft: 3, fontSize: 16, color: '#4caad3', textDecorationLine: 'underline' }} onPress={() => Linking.openURL(`tel:0120-4323120`)}>4323120</Text>
              </View>
  </View>*/}
            <View style={{ flexDirection: 'row', marginTop: 20 }}>

              <View style={{ alignSelf: 'center' }}>
                <Image source={require('../imgs/mail_icon.png')} style={{}} />
              </View>

              <Text style={{ marginLeft: 12, fontSize: 16, alignSelf: 'center', color: '#4caad3', textDecorationLine: 'underline' }} onPress={() => Linking.openURL('mailto:contact@greentip.com')}>contact@greentip.com</Text>

            </View>

            <Text style={{ fontSize: 20, color: '#00AD39', marginTop: 20, marginBottom: 10 }}>Send us a message</Text>

            <View>
              <Text style={mainstyles.contatus_label}>Full Name *</Text>
              <TextInput
                style={mainstyles.contatus_input}
                placeholder="Full Name"
                underlineColorAndroid="transparent"
                paddingLeft={10}
                fontSize={15}
                placeholderTextColor='#000'
                maxLength={20}
                value={this.state.first_name}
                onChangeText={first_name => this.setState({ first_name })}
              />
            </View>

            <View>
              <Text style={mainstyles.contatus_label}>Email Address *</Text>
              <TextInput
                style={mainstyles.contatus_input}
                placeholder="Email Address"
                underlineColorAndroid="transparent"
                paddingLeft={10}
                fontSize={15}
                placeholderTextColor='#000'
                keyboardType='email-address'
                value={this.state.email}
                onChangeText={email => this.setState({ email })}

              />
            </View>
            <View>
              <Text style={mainstyles.contatus_label}>Phone Number *</Text>
              <TextInput
                style={mainstyles.contatus_input}
                placeholder="Phone Number"
                underlineColorAndroid="transparent"
                paddingLeft={10}
                fontSize={15}
                returnKeyType="done"
                blurOnSubmit={true}
                maxLength={10}
                placeholderTextColor='#000'
                //returnKeyType={'done'}
                keyboardType='numeric'
                value={this.state.mobile}
                onChangeText={mobile => this.setState({ mobile })}
              />
            </View>

            <View>
              <Text style={mainstyles.contatus_label}>Message *</Text>
              <TextInput
                style={{ height: 100, borderColor: '#C8C8C8', borderWidth: 1, marginTop: 5, textAlignVertical: 'top', color: 'black' }}
                placeholder="Message"
                underlineColorAndroid="transparent"
                paddingLeft={10}
                fontSize={15}
                returnKeyType="done"
                blurOnSubmit={true}
                placeholderTextColor='#000'
                multiline={true}
                value={this.state.message_user}
                //returnKeyType={'done'}
                onChangeText={message_user => this.setState({ message_user })}
              />
            </View>
          </View>

          <View style={mainstyles.submitBtnCss}>
            <TouchableOpacity
              onPress={() => this.Contact_Us_Call()}
            >
              <Text style={mainstyles.submitBtnTextCss}>SUBMIT</Text>
            </TouchableOpacity>
          </View>
        </View>
      </KeyboardAwareScrollView>


    );
  }

}


