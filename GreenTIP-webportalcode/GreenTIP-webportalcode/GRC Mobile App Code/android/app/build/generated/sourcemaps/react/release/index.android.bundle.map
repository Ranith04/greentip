import React, { Component } from 'react';
import {
  StyleSheet,
  Text,
  View,
  TextInput,
  Button,
  TouchableOpacity,
  TouchableHighlight,
  Image,
  ImageBackground,
  Alert,
  BackHandler,
  ActivityIndicator,
  Animated
} from 'react-native';
import { KeyboardAwareScrollView } from 'react-native-keyboard-aware-scrollview'
import { StackActions, NavigationActions, SafeAreaView } from 'react-navigation';
import { createDrawerNavigator } from 'react-navigation-drawer';
import { createStackNavigator } from 'react-navigation-stack';
import { DrawerActions } from 'react-navigation-drawer';
import Toast from 'react-native-simple-toast';
import { TextInputLayout } from 'rn-textinputlayout';
import { ScrollView } from 'react-native-gesture-handler';
import ProgressLoader from 'rn-progress-loader';
const EMAIL_REGEX = /^(([^<>()\[\]\\.,;:\s@"]+(\.[^<>()\[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
import Constants from '../Constants';
export default class Signup extends Component {
  static navigationOptions = {
    header: null,
  };
  toggleDrawer = () => {
    //Props to open/close the drawer
    this.props.navigation.dispatch(DrawerActions.toggleDrawer());
    // this.props.navigationProps.toggleDrawer();
    //this.props.navigation.toggleDrawer()
  };

  constructor(props) {
    super(props);
    //  console.log("constructor props", props);
    this.handleBackButtonClick = this.handleBackButtonClick.bind(this);
    this.state = {
      first_name: '',
      last_name: '',
      email: '',
      password: '',
      isLoading: false
    }
  }

  componentWillMount() {
    BackHandler.addEventListener('hardwareBackPress', this.handleBackButtonClick);

  }
  componentWillUnmount() {
    BackHandler.removeEventListener('hardwareBackPress', this.handleBackButtonClick);
  }

  handleBackButtonClick() {
    console.log("hello_props", this.props);
    this.props.navigation.goBack(null);
    // BackHandler.exitApp();
    return true;
  }


  validate_field = () => {
    const { first_name, last_name, email, password } = this.state;
    const reg = /^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/;

    if (first_name == "") {
      alert("Please Enter First Name")
      return false
    } else if (last_name == "") {
      alert("Please Enter Last Name")
      return false
    } else if (reg.test(email) === false) {
      alert("Enter Valid Email Address")
      return false
    } else if (password.length < 8) {
      alert("Password field must be at least 8 characters in length")
      return false
    }
    return true
  }

  userSignUp = async () => {
    if (this.validate_field()) {
      this.setState({ isLoading: true });
      var res = await Constants.isNetworkAvailable();
      if (!res) {
        return false;
      }
      const { first_name, last_name, email, password } = this.state;

      const formData = new FormData();
      formData.append("first_name", first_name);
      formData.append("last_name", last_name);
      formData.append("email", email);
      formData.append("password", password);

      fetch(Constants.FullURL + '/authentication/register', {
        method: 'POST',
        body: formData,
      }).then((response) => response.json())
        .then((responseJson) => {
          if (responseJson.status === true) {
            // alert(responseJson.message);

           // Toast.show(responseJson.message, Toast.LONG);
            this.setState({ isLoading: false });
            setTimeout(() => {
              Toast.show(responseJson.message, Toast.SHORT);
          }, 500);
            this.props.navigation.navigate('Login')
          } else if (responseJson.status === false) {
            alert(responseJson.message);
            this.setState({ isLoading: false });
          }
          console.log(responseJson);
        })
        .catch((error) => {
          this.setState({ isLoading: false });
          //console.error(error);
        });
    }
  }

  render() {
    return (

      <KeyboardAwareScrollView contentContainerStyle={{ flexGrow: 1 }}
        keyboardShouldPersistTaps='always'
      >
        <SafeAreaView forceInset={{ bottom: 'never' }} style={{ flex: 1, backgroundColor: '#EAFCFD' }}>

          <View style={{ flex: 1 }}>

            <ProgressLoader
              visible={this.state.isLoading}
              isModal={true} isHUD={true}
              hudColor={"#00A637"}
              style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
              color={"#FFFFFF"} />
            <ImageBackground source={require('../imgs/login-bg.png')} style={{ width: '100%', height: '100%' }}>

              <View style={{ flexDirection: 'row' }}>
                <TouchableOpacity onPress={this.toggleDrawer.bind(this)}>
                  <Image source={require('../imgs/menu_icon_for_login_screen.png')} style={{ marginLeft: 15, marginTop: 20 }} />
                </TouchableOpacity>
              </View>

              <Text style={{ color: 'black', justifyContent: 'flex-start', alignItems: 'flex-start', marginTop: 30, marginLeft: 30, fontSize: 24 }}>Registration</Text>

              <View style={{ height: 0, width: 70, borderTopColor: 'red', borderTopWidth: 3, marginTop: 10, marginLeft: 30 }}></View>

              <View style={styles.container}>

                <View style={{}}>
                  <TextInputLayout style={{ marginTop: 16, marginHorizontal: 36 }}>
                    <TextInput style={{ fontSize: 16, height: 40, color: 'black' }} placeholder={'First Name *'} placeholderTextColor='#000' onChangeText={first_name => this.setState({ first_name })} />
                  </TextInputLayout>
                  <TextInputLayout style={{ marginTop: 16, marginHorizontal: 36 }}>
                    <TextInput style={{ fontSize: 16, height: 40, color: 'black' }} placeholderTextColor='#000' placeholder={'Last Name *'} onChangeText={last_name => this.setState({ last_name })} />
                  </TextInputLayout>
                </View>

                <View style={{}}>
                  <TextInputLayout style={{ marginTop: 16, marginHorizontal: 36 }}>
                    <TextInput style={{ fontSize: 16, height: 40, color: 'black' }} placeholderTextColor='#000' placeholder={'Email Address *'} onChangeText={email => this.setState({ email })} />
                  </TextInputLayout>
                  <TextInputLayout style={{ marginTop: 16, marginHorizontal: 36 }}>
                    <TextInput style={{ fontSize: 16, height: 40, color: 'black' }} placeholderTextColor='#000' placeholder={'Password *'} secureTextEntry={true} onChangeText={password => this.setState({ password })} />
                  </TextInputLayout>
                </View>

                {/* <View style={{ justifyContent: "center", alignItems: "center" }}>
                  {this.state.isLoading && <ActivityIndicator size='large' color={"#00AD39"} />}
                </View> */}

                <View style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'center', marginTop: 20 }}>
                  <Text style={{ color: '#000', fontSize: 15, marginTop: 2 }} onPress={() => this.props.navigation.navigate('AboutUS', { "page_name": 'Terms & condition' })}>Terms & conditions</Text>
                  <Text style={{ color: '#B8B8B8', fontSize: 15, marginTop: 2 }}> | </Text>
                  <Text style={{ color: '#000', fontSize: 15, marginTop: 2 }} onPress={() => this.props.navigation.navigate('AboutUS', { "page_name": 'Privacy policy' })}>Privacy policy</Text>
                </View>

                <TouchableHighlight style={[styles.buttonContainer, styles.signupButton]} onPress={this.userSignUp}>
                  <Text style={styles.signUpText}>SUBMIT</Text>
                </TouchableHighlight>

                <View style={{ flexDirection: 'row', marginTop: 15, alignItems: 'center', justifyContent: 'center' }}>
                  <Text style={{ color: '#000', fontSize: 14, marginTop: 2, alignItems: 'center' }}>Already registered?</Text>
                  <Text style={{ color: '#00AD39', fontSize: 14, marginTop: 2, alignItems: 'center' }} onPress={() => this.props.navigation.navigate('Login')}> Login</Text>
                </View>
              </View>
            </ImageBackground>

          </View>
        </SafeAreaView>
      </KeyboardAwareScrollView>


    );
  }
}




const styles = StyleSheet.create({
  container: {
    flex: 1,

  },
  inputContainer: {
    borderBottomColor: '#F5FCFF',
    borderRadius: 3,
    borderBottomWidth: 1,
    width: '90%',
    height: 45,
    marginBottom: 20,
    flexDirection: 'row',
    alignItems: 'center'
  },
  inputs: {
    height: 45,
    marginLeft: 16,
    borderBottomColor: '#FFFFFF',
    flex: 1,
  },
  inputIcon: {
    width: 30,
    height: 30,
    marginLeft: 15,
    justifyContent: 'center'
  },
  buttonContainer: {
    height: 45,
    flexDirection: 'row',
    justifyContent: 'center',
    alignItems: 'center',
    //marginBottom:5,
    width: '80%',
    marginLeft: 40,
    borderRadius: 3,
  },
  signupButton: {
    backgroundColor: "#00AD39",
    marginTop: 30,
    justifyContent: 'center',
  },
  signUpText: {
    color: 'white',
    fontSize: 16,
    fontWeight: 'bold',
  }
});