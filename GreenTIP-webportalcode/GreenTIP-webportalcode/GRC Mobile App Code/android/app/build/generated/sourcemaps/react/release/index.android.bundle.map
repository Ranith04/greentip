import React, { Component } from 'react';
import {
    StyleSheet,
    Text,
    View,
    TextInput,
    Button,
    TouchableOpacity,
    TouchableHighlight,
    Image,
    ImageBackground,
    Alert,
    Icon,
    StatusBar,
    ScrollView,
    tintColor,
    BackHandler,
    FlatList, ActivityIndicator, Dimensions
} from 'react-native';
import ask_styles from './ask_styles'
const iconChecked = require("../imgs/ck.png");
import Modal from 'react-native-modal';
import Toast from 'react-native-simple-toast';
import AsyncStorage from '@react-native-community/async-storage';
import ProgressLoader from 'rn-progress-loader';
import Constants from '../Constants';
import DocumentPicker from 'react-native-document-picker';
import mainstyles from '../Component/mainstyles'
const RNFS = require('react-native-fs');
export default class Askourexpert extends Component {

    static navigationOptions = ({ navigation }) => {
        return {
            title: 'Ask our experts',
            headerStyle: {
                backgroundColor: '#0ea457',
            },
            headerTintColor: '#FFFFFF',
            headerTitleAlign: 'center',

            headerTitleStyle: {
                fontSize: 20,

            },
        }
    }

    constructor(props) {
        super(props);
        this.handleBackButtonClick = this.handleBackButtonClick.bind(this);
        this.state = {
            isVisible: false, //state of modal default false
            isPopoverVisible: 0,
            showPop: false,
            popoverPlacement: 'left',
            isModalVisible: false,
            isLoading: false,
            spinner: true,
            imgPath: '',
            query_item: '',
            enduser_i: '',
            id: '',
            DiscardReason: '',
            category_name: 'Select Category *',
            category_id: '',
            query_text: '',
            cat_name: '',
            file_name: '',
            real_Path: '',
            real_Path_uri: '',
            real_Path_name: '',
            real_Path_type: ''


        }
    }
    componentDidMount() {
        return fetch(Constants.FullURL + '/common/all_categories')
            .then(response => response.json())
            .then(responseJson => {
                console.log('cat', responseJson.data);
                this.setState(
                    {
                        isLoading: false,
                        dataSource: responseJson.data,
                    },
                    function () {
                        this.arrayholder = responseJson.data;
                    }
                );
            })
            .catch(error => {
                console.error(error);
            });
    }
    search = text => {
        console.log(text);
    };
    clear = () => {
        this.search.clear();
    };
    SearchFilterFunction(text) {
        //passing the inserted text in textinput
        const newData = this.arrayholder.filter(function (item) {
            //applying filter for the inserted text in search bar
            const itemData = item.name ? item.name.toUpperCase() : ''.toUpperCase();
            const textData = text.toUpperCase();
            return itemData.indexOf(textData) > -1;
        });
        this.setState({
            //setting the filtered newData on datasource
            //After setting the data it will automatically re-render the view
            dataSource: newData,
            search: text,
        });
    }


    componentWillMount() {
        BackHandler.addEventListener('hardwareBackPress', this.handleBackButtonClick);
    }

    componentWillUnmount() {
        BackHandler.removeEventListener('hardwareBackPress', this.handleBackButtonClick);
    }

    handleBackButtonClick() {
        console.log("hello_props", this.props);
        this.props.navigation.goBack(null);
        // BackHandler.exitApp();
        return true;
    }

    Add_Category = (name, id) => {
        if (name) {
            this.setState({
                category_name: name,
                category_id: id,
            });
            this.setState({ isModalVisible: !this.state.isModalVisible });
        } else {
            alert('Please select a category');
        }
    }

    toggleModal = () => {
        this.setState({ isModalVisible: !this.state.isModalVisible });
    };


    validate_field = () => {
        const { category_name, query_text } = this.state;
        const reg = '^[a-zA-Z0-9]+$';
        const name_ = /^[a-zA-Z]+$/;


        if (category_name === '' || category_name === 'Select Category *') {
            alert("Please Select Category")
            return false
        }

        else if (query_text === '') {
            alert("Please Enter Query")
            return false
        }

        return true
    }
    Submit_Query = async () => {
        if (this.validate_field()) {
            this.setState({ isLoading: true });
            const userIdnewww = await AsyncStorage.getItem('id')
            const { cat_name, query_text, real_Path_uri, real_Path_name, real_Path_type } = this.state;

            var photo = {
                uri: real_Path_uri,
                type: real_Path_type,
                name: real_Path_name
            };
            var params = {
                'user_id': userIdnewww,
                'category_id': this.state.category_id,
                'query': query_text,
            };
            console.log('params', params)
            var formData = new FormData();

            for (var k in params) {
                formData.append(k, params[k]);
            }
            if (photo.uri != '' && photo.type != '' && photo.name != '') {
                formData.append('attachment_file', photo);
            }
            fetch(Constants.FullURL + '/users/submit_query', {
                method: 'POST',

                body: formData,
            }).then((response) => response.json())

                .then((responseJson) => {
                    console.log(responseJson)
                    if (responseJson.status === true) {
                        const type = responseJson.data;
                        // Alert.alert(responseJson.message);

                       // Toast.show(responseJson.message, Toast.LONG);

                
                        this.setState(
                            {
                                isLoading: false,

                            },
                            function () {
                            }
                        );

                        setTimeout(() => {
                            Toast.show(responseJson.message, Toast.SHORT);
                        }, 500);

                        this.props.navigation.navigate('EndUserDashboard');



                    } else if (responseJson.status === false) {
                        Alert.alert('Error', responseJson.message);
                        this.setState({ isLoading: false });
                    }
                })
                .catch(error => {
                    this.setState({ isLoading: false });
                    console.log(error);
                })
        }
    }
    Fle_Picker = async () => {
        try {
            const res = await DocumentPicker.pick({
                type: [DocumentPicker.types.images, DocumentPicker.types.pdf, DocumentPicker.types.zip, DocumentPicker.types.allFiles],
            });
            const split = res.uri.split('/');
            const name = split.pop();
            const inbox = split.pop();
            const realPath = `${RNFS.TemporaryDirectoryPath}${inbox}/${name}`;
            this.setState({
                file_name: res.name,
                real_Path_uri: res.uri,
                real_Path_name: res.name,
                real_Path_type: res.type,
            });
            // console.log('uri', res.uri)
            // console.log('type', res.type)
            // console.log('name', res.name)
            // console.log('size', res.size)
        } catch (err) {
            if (DocumentPicker.isCancel(err)) {
                // User cancelled the picker, exit any dialogs or menus and move on
            } else {
                throw err;
            }
        }
    }
    render() {

        return (
            <ScrollView contentContainerStyle={{ flexGrow: 1 }}>

                <View style={ask_styles.Main_View}>
                    <ProgressLoader
                        visible={this.state.isLoading}
                        isModal={true} isHUD={true}
                        hudColor={"#00A637"}
                        style={{ justifyContent: 'center', alignItems: 'center', flex: 1 }}
                        color={"#FFFFFF"} />
                    <View style={ask_styles.Main_Child}>


                        <View style={ask_styles.View_v1}>

                            <TouchableOpacity onPress={this.toggleModal}

                            >
                                <View style={ask_styles.View_v2}>
                                    <View style={ask_styles.View_v3}>


                                        <Text style={ask_styles.View_v4}>{this.state.category_name}</Text>

                                        {/* <TextInput
                                        
                                        underlineColorAndroid="transparent"
                                        placeholder={'Select Category *'}
                                        editable={false}
                                        placeholderTextColor='#000'
                                      //  onChangeText={cat_name => this.setState({ cat_name })}
                                    >
                                        {this.state.category_name}
                                    </TextInput> */}

                                        <Image
                                            source={require('../imgs/add_button.png')}
                                            style={ask_styles.Image_Add_v}
                                        />
                                    </View>

                                </View>

                            </TouchableOpacity>

                            <View style={{
                                padding: '2%',
                                width: '100%'
                            }}>
                                <Text style={mainstyles.askexpert_labels}>Start New Question *</Text>
                                <TextInput
                                    style={ask_styles.View_v5_new}
                                    // Adding hint in TextInput using Placeholder option.
                                    placeholder="Start new question"
                                    // Making the Under line Transparent.
                                    underlineColorAndroid="transparent"
                                    paddingLeft={10}
                                    placeholderTextColor='#000'
                                    returnKeyType="done"
                                    blurOnSubmit={true}
                                    onChangeText={query_text => this.setState({ query_text })}
                                    fontSize={15}
                                    value={this.state.query_text}
                                    multiline={true}
                                />
                            </View>



                            <View style={{
                                padding: '2%',
                                width: '100%'
                            }}>
                                <Text style={mainstyles.respond_attachment}>Attachment </Text>
                                <TouchableHighlight underlayColor="#ffffff00" onPress={() => {
                                    this.Fle_Picker();
                                }} >
                                    <View style={{
                                        flexDirection: 'row', borderRadius: 1,
                                        borderStyle: 'dashed',
                                        borderWidth: 1,
                                        borderColor: '#62D5A8',
                                        alignItems: 'center',
                                        marginTop: 10,
                                        width: '100%'
                                    }}>
                                        <TextInput style={{ fontSize: 15, padding: 10, width: '100%', color: 'black' }
                                        }
                                            underlineColorAndroid="transparent"
                                            placeholder={'Choose File'}
                                            editable={false}
                                            placeholderTextColor='#000'
                                        >{this.state.file_name}
                                        </TextInput>

                                        <View style={{ width: '10%', paddingLeft: 10, position: 'absolute', right: 10, alignSelf: 'flex-end', padding: Platform.OS == 'ios' ? 5 : 10 }}>

                                            <Image source={require('../imgs/upload_docc.png')} style={{ width: 30, height: 30 }} />

                                        </View>
                                    </View>
                                </TouchableHighlight>
                            </View>

                        </View>
                        <View style={ask_styles.View_v6}>
                            <TouchableOpacity underlayColor="#ffffff00" style={ask_styles.Reset_bt}
                                onPress={() => this.setState({ query_text: '', category_name: '', indexChecked: '' })}
                            >
                                <Text style={ask_styles.Reset_tv}>Clear</Text>
                            </TouchableOpacity>

                            <TouchableHighlight underlayColor="#ffffff00" style={ask_styles.Submit_bt}
                                onPress={this.Submit_Query}
                            >
                                <Text style={ask_styles.Submit_tv}>Submit</Text>
                            </TouchableHighlight>



                        </View>
                        <View style={ask_styles.View_v7}>
                            <View style={ask_styles.View_v8}>
                                <Modal style={ask_styles.View_Model} isVisible={this.state.isModalVisible}>
                                    <View style={ask_styles.View_v9}>
                                        <View style={ask_styles.View_v10}>
                                            <View style={ask_styles.View_v11}>
                                                <Text style={ask_styles.Add_Category_tv}>Add category</Text>
                                            </View>

                                        </View>

                                        <View style={ask_styles.View_v12}>
                                            <View style={ask_styles.View_v13}>
                                                <Image
                                                    source={require('../imgs/search.png')}
                                                    style={ask_styles.Search_v}
                                                />
                                                <TextInput
                                                    style={ask_styles.Search_cat}
                                                    onChangeText={text => this.SearchFilterFunction(text)}
                                                    value={this.state.search}
                                                    placeholderTextColor='#000'
                                                    onClear={text => this.SearchFilterFunction('')}
                                                    underlineColorAndroid="transparent"
                                                    placeholder={'Search Category'}
                                                />
                                            </View>
                                        </View>
                                        <ScrollView>
                                            <View >

                                                <FlatList
                                                    data={this.state.dataSource}
                                                    ItemSeparatorComponent={() => <View
                                                        style={ask_styles.Sperator}
                                                    />}
                                                    keyExtractor={(item) => item.id}
                                                    extraData={this.state}
                                                    //Item Separator View
                                                    renderItem={({ item }) => (
                                                        <View style={ask_styles.wrapContent}>
                                                            <TouchableHighlight
                                                                style={ask_styles.boxSelect}
                                                                underlayColor="transparent"
                                                                onPress={() => this.setState({ indexChecked: item.id, indexChecked_Name: item.name })}
                                                            >
                                                                <View style={ask_styles.contentChecked}>
                                                                    <Text style={ask_styles.alignCenter}>{item.name}</Text>
                                                                    {this.state.indexChecked === item.id && <Image source={iconChecked} style={ask_styles.iconChecked} />}
                                                                </View>
                                                            </TouchableHighlight>
                                                        </View>

                                                    )}
                                                    enableEmptySections={true}
                                                    style={{ marginTop: 10 }}
                                                />


                                            </View>
                                        </ScrollView>
                                    </View>

                                    <View style={{
                                        flexDirection: 'row',
                                    }}>
                                        <TouchableHighlight underlayColor="#ffffff00" onPress={this.toggleModal} style={ask_styles.Add_bt_1}>
                                            <Text style={ask_styles.Add_tv_1}>Cancel</Text>
                                        </TouchableHighlight>
                                        <TouchableHighlight underlayColor="#ffffff00" onPress={() => {
                                            this.Add_Category(this.state.indexChecked_Name, this.state.indexChecked);
                                        }} style={ask_styles.Add_bt}>
                                            <Text style={ask_styles.Add_tv}>Add</Text>
                                        </TouchableHighlight>








                                    </View>

                                </Modal>
                            </View>
                        </View>
                    </View>


                </View>

            </ScrollView>

        )

    }
}
