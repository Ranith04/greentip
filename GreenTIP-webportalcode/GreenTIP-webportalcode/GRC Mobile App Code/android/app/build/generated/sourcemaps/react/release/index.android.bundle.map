                                            </TextInput>

                                            <View style={{ position: 'absolute', right: 5, alignSelf: 'flex-end', padding: Platform.OS == 'ios' ? 5 : 10 }}>
                                                <Image source={require('../imgs/add_button.png')} style={{ width: 30, height: 30 }} />
                                            </View>
                                        </View>
