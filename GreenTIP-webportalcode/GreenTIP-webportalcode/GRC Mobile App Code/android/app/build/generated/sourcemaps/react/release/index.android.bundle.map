                fontSize: 20,
            },
            //  headerRight: <Icon style={{ marginLeft:15,color:'#fff' }} name={'edit'} size={25} onPress={() => params.handleSave()} />

        };
    };


    constructor(props) {
        super(props);
        this.handleBackButtonClick = this.handleBackButtonClick.bind(this);
        this.state = {
            isLoading: false,
            First_name: '',
            Last_name: '',
            Email: '',
            Password: '',
            linkdin: '',
            facebook: '',
            Company_Name: '',
            Occupation: '',
            Education: '',
            Expertise: '',
            Description: '',
            visible: false,
            isVisible: false, //state of modal default false  ,
            image: '',
            real_Path_uri: '',
            real_Path_name: '',
